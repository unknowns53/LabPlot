<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.DLS.Avalonia"
        x:Class="LabPlot.DLS.Avalonia.SolventPresetManagerDialog"
        x:DataType="vm:SolventPresetManagerDialog"
        x:CompileBindings="True"
        Title="溶媒プリセット管理"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="580" Width="500" MinHeight="440" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full">

    <!-- 溶媒プリセット管理ダイアログ (二段構成)。
         上段: プリセット一覧 (組み込み + ユーザー)。各行に「全削除」ボタン (ユーザー分のみ有効)
         下段: 上段で選択中のプリセットが持つ温度点 (T, n, η) の一覧。各行に「点削除」ボタン
               (ユーザー分のみ有効)。組み込みプリセットの温度点は閲覧のみ。
         追加 (新規温度点の保存) は AnalysisWindow 側の [+] ボタンに任せる方が体感が良いので
         本ダイアログには「追加」UI は置かない。 -->

    <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*,Auto">

            <controls:CustomTitleBar Grid.Row="0"
                                     Name="DialogTitleBar"
                                     AppName="溶媒プリセット"
                                     Subtitle="管理"
                                     AppIconData="M 2,16 C 5,16 6.5,4 10,4 C 13.5,4 15,16 18,16" />

            <Grid Grid.Row="1" Margin="16,12,16,0" RowDefinitions="Auto,2*,8,Auto,3*">

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,6"
                           Text="プリセット一覧"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />

                <Border Grid.Row="1"
                        Theme="{DynamicResource SectionStyle}"
                        Padding="4">
                    <ListBox Name="PresetListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Single"
                             SelectionChanged="PresetListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:SolventPresetRowVm">
                                <Grid ColumnDefinitions="*,Auto" Margin="6,4">
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A" />
                                            <Border Background="#E2E8F0"
                                                    CornerRadius="3"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsBuiltIn}">
                                                <TextBlock Text="組み込み"
                                                           FontSize="10"
                                                           Foreground="#475569" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="全削除"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding CanRemove}"
                                            Tag="{Binding Name}"
                                            Click="DeletePresetButton_Click"
                                            MinWidth="72" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Grid.Row="3"
                           Margin="0,0,0,6"
                           Name="PointsHeaderText"
                           Text="温度点 (プリセットを選択してください)"
                           FontWeight="SemiBold"
                           Foreground="#0F172A" />

                <Border Grid.Row="4"
                        Theme="{DynamicResource SectionStyle}"
                        Padding="4">
                    <ListBox Name="PresetPointsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:SolventPresetPointVm">
                                <Grid ColumnDefinitions="*,Auto" Margin="6,4">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Detail}"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="点削除"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            IsEnabled="{Binding CanRemove}"
                                            Tag="{Binding}"
                                            Click="DeletePointButton_Click"
                                            MinWidth="72" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="16,12,16,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="閉じる"
                            Theme="{DynamicResource PrimaryButtonStyle}"
                            Click="CloseButton_Click"
                            MinWidth="84" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
