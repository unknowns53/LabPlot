<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:shell="using:LabPlot.Shell.Avalonia"
        x:Class="LabPlot.Shell.Avalonia.PortalWindow"
        Title="LabPlot"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="540" Width="940"
        CanResize="False"
        Background="{DynamicResource MainBgSurfaceBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full">

    <!-- WPF 版の System.Windows.Shell.WindowChrome (CaptionHeight=44 / 角丸 0 / Aero 抑制)
         に対応する Avalonia 設定。ExtendClientAreaToDecorationsHint=True で OS の
         タイトルバーを内側に押し込み、ChromeHints=NoChrome でシステムボタンを完全に
         消す。CustomTitleBar が Window.BeginMoveDrag を呼ぶことで上 44 px が
         キャプション領域として機能する。

         v1.3.5 (PR C): Width を 620 → 940 に拡張し、右側に「最近開いたファイル」
         縦リストを併置する。ファイル drop は「各モジュールカード」ごとに受け付ける
         (Window 全体 drop は廃止)。.txt / .csv のように複数モジュールが対応する
         拡張子で振り分けが曖昧になるのを避け、利用者が「どのモジュールで開きたいか」
         をカード位置で明示できる UX にしている。 -->

    <Window.Resources>
        <!-- ポータル カード ボタン。WPF 版と完全同じ寸法・配色・シャドウで、
             ホバー / 押下 / フォーカス / 無効 で枠色・背景を切り替える。WPF の
             DropShadowEffect (depth=1, dir=270, blur=6, opacity=0.05, color=#0F172A)
             は Border.BoxShadow="0 1 6 0 #0D0F172A" で再現する (alpha 0x0D ≈ 5%)。 -->
        <ControlTheme x:Key="PortalCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 内容 (アイコン+タイトル+説明2行) がカード高さに対して小さく、Stretch だと
                 下半分が空白になっていた。Center にして内側 Grid を Auto,Auto 化 (下記
                 各カード) することで、上下の余白を均等に割り、体感の空白を圧縮する。
                 カード枠自体のサイズ (Margin/Padding/UniformGrid) は変えない最小手。 -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="CardBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            BoxShadow="0 1 6 0 #0D0F172A">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- IsMouseOver / IsPressed / IsKeyboardFocused / IsEnabled の WPF Trigger を
                 Avalonia の擬似クラス Selector に置換。/template/ で ControlTemplate
                 内の Border#CardBorder を狙い撃つ。枠線色変化に加えて背景の薄い
                 アクセント tint と BoxShadow の強弱で「浮き上がる/沈む」を表現する。
                 :focus ではなく :focus-visible にして、Tab キー操作時にのみホバー同等の
                 フィードバックを出す (マウスクリック後の残留フォーカスと区別する)。 -->
            <Style Selector="^:pointerover /template/ Border#CardBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Background" Value="#F5F9FF" />
                <Setter Property="BoxShadow" Value="0 3 12 0 #1F0F172A" />
            </Style>
            <Style Selector="^:pressed /template/ Border#CardBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                <Setter Property="Background" Value="#E3EEFF" />
                <Setter Property="BoxShadow" Value="0 1 2 0 #140F172A" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#CardBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Background" Value="#F5F9FF" />
                <Setter Property="BoxShadow" Value="0 3 12 0 #1F0F172A" />
            </Style>
            <Style Selector="^:disabled /template/ Border#CardBorder">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDisabledBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <!-- カード内 36x36 アイコン バッジ。 -->
        <ControlTheme x:Key="PortalCardBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#DBEAFE" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </ControlTheme>

        <!-- WPF の StrokeStartLineCap / StrokeEndLineCap / StrokeLineJoin は Avalonia では
             StrokeLineCap (start/end 兼用) / StrokeJoin に統合される。SnapsToDevicePixels は
             Window.UseLayoutRounding でカバーするので個別指定は省略。 -->
        <ControlTheme x:Key="PortalCardIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>

        <ControlTheme x:Key="PortalCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </ControlTheme>

        <ControlTheme x:Key="PortalCardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </ControlTheme>

        <!-- + 追加プレースホルダーは 破線ボーダー風グレー一色 (Avalonia は破線 Border が
             重いので Solid ボーダー + 薄背景で代替)。 -->
        <ControlTheme x:Key="PortalPlaceholderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="14" />
        </ControlTheme>

        <!-- 最近開いたファイル一行ボタン。card より情報密度が高いので枠線は常時透明の
             1px を予約しておき (レイアウトジャンプ防止)、Hover/Pressed/フォーカス時に
             BorderBrush と Background tint をカードと同じ濃淡関係 (hover 薄tint →
             pressed 濃tint) で切り替える。クリックで該当モジュールを起動 + ファイル open。 -->
        <ControlTheme x:Key="RecentFileRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#RowBorder">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#RowBorder">
                <Setter Property="Background" Value="#D9E7FF" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#RowBorder">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Border Name="ChromeRoot"
            Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*">

            <!-- ================= TITLE BAR ================= -->
            <controls:CustomTitleBar Grid.Row="0"
                                     Name="MainTitleBar"
                                     AppName="LabPlot"
                                     Subtitle="Analysis portal"
                                     AppIconData="M 3,3 L 8,3 L 8,8 L 3,8 Z M 12,3 L 17,3 L 17,8 L 12,8 Z M 3,12 L 8,12 L 8,17 L 3,17 Z M 12,12 L 17,12 L 17,17 L 12,17 Z" />

            <!-- ================= BODY: cards (左) + recent files (右) ================= -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,300"
                  Margin="20,12,20,20">

                <!-- ============ 左カラム: 2x2 カードグリッド ============ -->
                <UniformGrid Grid.Column="0"
                             Rows="2"
                             Columns="2">

                    <!-- GPC -->
                    <Button Name="GpcCard"
                            Theme="{DynamicResource PortalCardStyle}"
                            Click="OpenGpc_Click"
                            DragDrop.AllowDrop="True"
                            ToolTip.Tip="GPC クロマトグラム解析&#x0a;（ファイルをここに drop して開く）">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Theme="{DynamicResource PortalCardBadgeStyle}">
                                    <Path Theme="{DynamicResource PortalCardIconStyle}"
                                          Data="M 2,16 L 6,16 L 8,11 L 10,3 L 12,11 L 14,16 L 18,16" />
                                </Border>
                                <TextBlock Theme="{DynamicResource PortalCardTitleStyle}"
                                           Text="GPC" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Theme="{DynamicResource PortalCardSubtitleStyle}"
                                       Text="サイズ排除クロマトグラフィー&#x0a;分子量分布の解析" />
                        </Grid>
                    </Button>

                    <!-- UV-Vis -->
                    <Button Name="SpectrumCard"
                            Theme="{DynamicResource PortalCardStyle}"
                            Click="OpenSpectrum_Click"
                            DragDrop.AllowDrop="True"
                            ToolTip.Tip="UV-Vis スペクトル解析&#x0a;（ファイルをここに drop して開く）">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Theme="{DynamicResource PortalCardBadgeStyle}">
                                    <Path Theme="{DynamicResource PortalCardIconStyle}"
                                          Data="M 2,10 Q 4.25,3 6.5,10 Q 8.75,17 11,10 Q 13.25,3 15.5,10 Q 17,14 18,10" />
                                </Border>
                                <TextBlock Theme="{DynamicResource PortalCardTitleStyle}"
                                           Text="UV-Vis" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Theme="{DynamicResource PortalCardSubtitleStyle}"
                                       Text="紫外可視吸収スペクトル&#x0a;λmax / 曇点 / Beer-Lambert" />
                        </Grid>
                    </Button>

                    <!-- DLS -->
                    <Button Name="DlsCard"
                            Theme="{DynamicResource PortalCardStyle}"
                            Click="OpenDls_Click"
                            DragDrop.AllowDrop="True"
                            ToolTip.Tip="DLS 粒径分布解析&#x0a;（ファイルをここに drop して開く）">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Theme="{DynamicResource PortalCardBadgeStyle}">
                                    <Path Theme="{DynamicResource PortalCardIconStyle}"
                                          Data="M 2,16 C 5,16 6.5,4 10,4 C 13.5,4 15,16 18,16" />
                                </Border>
                                <TextBlock Theme="{DynamicResource PortalCardTitleStyle}"
                                           Text="DLS" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Theme="{DynamicResource PortalCardSubtitleStyle}"
                                       Text="動的光散乱（粒径分布）&#x0a;キュムラント / 自己相関" />
                        </Grid>
                    </Button>

                    <!-- Data Viewer (汎用ビューア) -->
                    <Button Name="ViewerCard"
                            Theme="{DynamicResource PortalCardStyle}"
                            Click="OpenViewer_Click"
                            DragDrop.AllowDrop="True"
                            ToolTip.Tip="汎用データビューア&#x0a;（ファイルをここに drop して開く）">
                        <Grid RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Theme="{DynamicResource PortalCardBadgeStyle}">
                                    <Path Theme="{DynamicResource PortalCardIconStyle}"
                                          Data="M 3,3 L 3,17 L 17,17 M 6,13 L 9,8 L 12,11 L 16,5" />
                                </Border>
                                <TextBlock Theme="{DynamicResource PortalCardTitleStyle}"
                                           Text="Viewer" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Theme="{DynamicResource PortalCardSubtitleStyle}"
                                       Text="汎用データビューア&#x0a;CSV / TSV / xlsx の重ね描き" />
                        </Grid>
                    </Button>
                </UniformGrid>

                <!-- ============ 右カラム: 最近開いたファイル ============ -->
                <Border Grid.Column="1"
                        Margin="12,6,0,6"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        BoxShadow="0 1 6 0 #0D0F172A">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0"
                                   Text="最近開いたファイル"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="2,2,0,10" />

                        <!-- ItemsControl: code-behind から ItemsSource を流し込む。
                             RecentFileEntry 1 件あたり 行 button。クリックで該当モジュール
                             起動 + ファイル open。 -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="RecentFilesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="shell:PortalRecentFileEntry">
                                        <Button Theme="{DynamicResource RecentFileRowStyle}"
                                                Click="RecentFile_Click"
                                                Tag="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*"
                                                  ToolTip.Tip="{Binding FilePath}">
                                                <Border Grid.Column="0"
                                                        Width="26" Height="26"
                                                        CornerRadius="5"
                                                        Background="#DBEAFE"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                    <Path Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          StrokeJoin="Round"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Width="14" Height="14"
                                                          Data="{Binding IconData}" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12.5"
                                                               FontWeight="Medium"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="#64748B"
                                                               Margin="0,1,0,0"
                                                               Text="{Binding SecondaryLine}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空状態 placeholder。code-behind が IsVisible を切り替える。 -->
                        <StackPanel Grid.Row="1"
                                    Name="EmptyRecentPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="False">
                            <TextBlock Text="まだ履歴がありません"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="ファイルをここに drop して開けます"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Toast overlay: drop 受付メッセージ等 ============ -->
            <controls:ToastHost Grid.Row="1"
                                Name="PortalToast"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                IsVisible="False" />
        </Grid>
    </Border>
</Window>
