<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabPlot.Spectrum.Avalonia.Controls.SpectrumAxisDisplayPanel">
    <StackPanel>
        <TextBlock Text="X 軸の向き" Theme="{DynamicResource FieldLabelStyle}" />
        <ComboBox x:Name="InvertXAxisComboBox"
                  Theme="{DynamicResource InputComboBoxStyle}"
                  SelectedIndex="0"
                  Margin="0,0,0,10"
                  ToolTip.Tip="自動: IR データなら 4000 → 400 cm⁻¹ に反転、UV-Vis は正方向。手動指定でこれを上書き"
                  SelectionChanged="InvertXAxisComboBox_SelectionChanged">
            <ComboBoxItem Content="自動（IR は反転）" Tag="Auto" />
            <ComboBoxItem Content="常に反転" Tag="Inverted" />
            <ComboBoxItem Content="常に正方向" Tag="Normal" />
        </ComboBox>

        <TextBlock Text="Y 軸の表示" Theme="{DynamicResource FieldLabelStyle}" />
        <ComboBox x:Name="YAxisDisplayComboBox"
                  Theme="{DynamicResource InputComboBoxStyle}"
                  SelectedIndex="0"
                  ToolTip.Tip="ネイティブ: ファイルの YUNITS のまま / Absorbance: A 表示 / Transmittance: T (%) 表示。A↔T の変換ができないデータ (Reflectance 等) はネイティブで表示"
                  SelectionChanged="YAxisDisplayComboBox_SelectionChanged">
            <ComboBoxItem Content="ネイティブ" Tag="Native" />
            <ComboBoxItem Content="Absorbance" Tag="Absorbance" />
            <ComboBoxItem Content="Transmittance" Tag="Transmittance" />
        </ComboBox>
    </StackPanel>
</UserControl>
