<Window x:Class="Spectrum_Visualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:core="clr-namespace:SpectrumAnalyzer.Core;assembly=SpectrumAnalyzer.Core"
        xmlns:controls="clr-namespace:LabPlot.Core.Wpf.Controls;assembly=LabPlot.Core.Wpf"
        xmlns:spectrumControls="clr-namespace:Spectrum_Visualization.Controls"
        mc:Ignorable="d"
        Title="Spectrum Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="20,22,20,10">
                    <Border Width="36" Height="36"
                            CornerRadius="8"
                            Background="#DBEAFE"
                            VerticalAlignment="Top"
                            Margin="0,2,12,0">
                        <Path Stroke="#2563EB"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 2,10 Q 4.25,3 6.5,10 Q 8.75,17 11,10 Q 13.25,3 15.5,10 Q 17,14 18,10" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Spectrum Analyzer"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="Spectrum visualizer"
                                   FontSize="11"
                                   Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,10,20,12">

                        <ContentControl Content="データ"
                                        Style="{StaticResource GroupHeaderStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource DataFileIconGeometry}" />
                                        <TextBlock Text="データファイル"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenSpectrumButton"
                                        Content="JASCO TXT を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        ToolTip="JASCO TXT データを開く (Ctrl+O)"
                                        Click="OpenSpectrumButton_Click" />
                                <CheckBox x:Name="OverlayCheckBox"
                                          Content="重ね描き (Overlay)"
                                          ToolTip="複数データセットの重ね描き表示を切替 (Ctrl+L)"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed" />
                                <TextBlock x:Name="FilePathTextBlock"
                                           Text=""
                                           Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource DatasetListIconGeometry}" />
                                        <TextBlock Text="読み込み済みデータセット"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#F8FAFC">
                                    <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 MinHeight="120"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="DatasetListBox_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="DatasetListBox_PreviewMouseMove"
                                                 DragOver="DatasetListBox_DragOver"
                                                 DragLeave="DatasetListBox_DragLeave"
                                                 Drop="DatasetListBox_Drop"
                                                 SelectionChanged="DatasetListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Cursor" Value="SizeAll" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding FullPath}"
                                                                   ToolTipService.ShowDuration="30000"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="×"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                Click="RemoveDatasetButton_Click"
                                                                ToolTip="削除" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel x:Name="DatasetListPlaceholder"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="8,18,8,18"
                                                    IsHitTestVisible="False">
                                            <Path Width="32" Height="32"
                                                  Stretch="None"
                                                  Stroke="#94A3B8"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  HorizontalAlignment="Center"
                                                  Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                            <TextBlock Text="ここにファイルをドロップ"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,2" />
                                            <TextBlock Text="または上のボタンから開く"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <Rectangle x:Name="DatasetDropOverlay"
                                                   Stroke="#2563EB"
                                                   StrokeThickness="2"
                                                   StrokeDashArray="3,2"
                                                   StrokeDashCap="Round"
                                                   Fill="#4DDBEAFE"
                                                   RadiusX="4"
                                                   RadiusY="4"
                                                   IsHitTestVisible="False"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active dataset) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SectionIconPath}"
                                          Data="{StaticResource LineStyleIconGeometry}" />
                                    <TextBlock Text="線スタイル"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ActiveDatasetLabel"
                                               Text="(選択中データセット)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="色"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <controls:ColorPickerPanel x:Name="LineColorPicker"
                                                            AllowAuto="True"
                                                            DefaultHex="#2563EB"
                                                            Margin="0,0,0,10"
                                                            ColorChanged="LineColorPicker_ColorChanged">
                                    <ComboBoxItem Tag="Auto" IsSelected="True">
                                        <TextBlock Text="Auto" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">
                                        <TextBlock Text="Custom" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#2563EB">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#DC2626">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#16A34A">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EA580C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Orange" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#7C3AED">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#0891B2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Cyan" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#BE123C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#4B5563">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Gray" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </controls:ColorPickerPanel>

                                <TextBlock Text="凡例名"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="LegendNameTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,10"
                                         ToolTip="凡例名を編集（F2 でフォーカス）"
                                         TextChanged="LegendNameTextBox_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LineWidthTextBox"
                                                 Text="1.5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="LineWidthTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="マーカー"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MarkerSizeTextBox"
                                                 Text="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="MarkerSizeTextBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <ContentControl Content="書式"
                                        Style="{StaticResource GroupHeaderStyle}" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource AxisRangeIconGeometry}" />
                                        <TextBlock Text="軸範囲"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <controls:AxisRangePanel x:Name="AxisRangePanel"
                                                         Margin="0,8,0,0"
                                                         XAxisLabel="X"
                                                         YAxisLabel="Y"
                                                         NumberFormat="G6"
                                                         AxisRangeCommitted="AxisRangePanel_Committed" />
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource GraphLabelIconGeometry}" />
                                        <TextBlock Text="グラフラベル"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="タイトル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TitleTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="TitleVisibleCheckBox"
                                              Grid.Column="0"
                                              Content="表示する"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="TitleBoldCheckBox"
                                              Grid.Column="2"
                                              Content="太字"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                </Grid>

                                <TextBlock Text="X軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="XLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="Y軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <CheckBox x:Name="AxisLabelBoldCheckBox"
                                          Content="軸ラベルを太字"
                                          Margin="0,0,0,0"
                                          Checked="GraphAppearanceCheckBox_Changed"
                                          Unchecked="GraphAppearanceCheckBox_Changed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource GraphFormatIconGeometry}" />
                                        <TextBlock Text="グラフ書式"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                <controls:GraphFormatPanel x:Name="GraphFormatPanel"
                                                           GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                           AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />

                                <Expander IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIconPath}"
                                                  Data="M 2,2 L 2,12 L 12,12 M 4,9 L 6,7 L 8,9 L 11,5" />
                                            <TextBlock Text="軸の表示"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <spectrumControls:SpectrumAxisDisplayPanel x:Name="AxisDisplayPanel"
                                                                                   AxisOrientationChanged="AxisDisplayPanel_AxisOrientationChanged"
                                                                                   YAxisDisplayChanged="AxisDisplayPanel_YAxisDisplayChanged" />
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIconPath}"
                                                  Data="M 7,1 A 6,6 0 1 0 7,13 A 6,6 0 1 0 7,1 M 7,5 L 7,5 M 7,7 L 7,10" />
                                            <TextBlock Text="メタデータ"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="ShowMetadataCheckBox"
                                                  Content="測定メタデータをグラフに表示"
                                                  ToolTip="ファイルフッタの [測定情報] / [付属品情報] から測定波長・温度勾配・付属品名などを読み取り、プロット右上に小さく表示"
                                                  Checked="MetadataOption_Changed"
                                                  Unchecked="MetadataOption_Changed" />
                                        <TextBlock x:Name="MetadataHintTextBlock"
                                                   Text="温度スキャンを開くとメタデータ表示が利用できます"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>

                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Analysis -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="M 6,2 A 4,4 0 1 0 6,10 A 4,4 0 1 0 6,2 M 9,9 L 13,13" />
                                        <TextBlock Text="解析"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <Expander IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIconPath}"
                                                  Data="M 2,12 L 6,4 L 8,12 M 6,4 L 9,2" />
                                            <TextBlock Text="IR ピーク帰属"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PeakAssignmentEnableAllButton"
                                                Grid.Column="0"
                                                Content="全 ON"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PeakAssignmentEnableAllButton_Click" />
                                        <Button x:Name="PeakAssignmentDisableAllButton"
                                                Grid.Column="2"
                                                Content="全 OFF"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PeakAssignmentDisableAllButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="PeakAssignmentHintTextBlock"
                                               Text="IR データを開くと帰属が表示できます"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,0,0,6"
                                               Visibility="Collapsed" />
                                    <ItemsControl x:Name="PeakAssignmentItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="14" Height="14"
                                                            Background="{Binding ColorBrush}"
                                                            BorderBrush="#475569"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="2"
                                                              Content="{Binding Label}"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Checked="PeakAssignmentCheckBox_Changed"
                                                              Unchecked="PeakAssignmentCheckBox_Changed" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Expander>

                                <Expander IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource SectionIconPath}"
                                                  Data="M 2,12 L 5,6 L 8,12 M 5,6 L 5,2 M 4,3 L 5,2 L 6,3" />
                                            <TextBlock Text="IR スペクトル解析（ピーク検出）"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       Foreground="#0F172A"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="IrPeakHintTextBlock"
                                                   Text="IR スペクトル（cm⁻¹）を開くとピーク検出が利用できます"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,6"
                                                   Visibility="Collapsed" />
                                        <CheckBox x:Name="ShowIrPeakCheckBox"
                                                  Content="ピークにマーカーを表示"
                                                  Margin="0,0,0,8"
                                                  ToolTip="極大点を自動検出して垂直線とラベル（例: 1730 cm⁻¹）を描画。Absorbance ベースで検出（Transmittance データは A に変換）"
                                                  Checked="IrPeakOption_Changed"
                                                  Unchecked="IrPeakOption_Changed" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="検出閾値（A）"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="IrPeakMinAbsorbanceTextBox"
                                                         Text="0.05"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="この絶対値以上の極大のみマーカーを表示"
                                                         TextChanged="IrPeakNumericTextBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="突出度（A）"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="IrPeakMinProminenceTextBox"
                                                         Text="0.02"
                                                         Style="{StaticResource InputTextBoxStyle}"
