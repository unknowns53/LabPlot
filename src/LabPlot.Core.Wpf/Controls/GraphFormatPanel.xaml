<UserControl x:Class="LabPlot.Core.Wpf.Controls.GraphFormatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LabPlot.Core.Wpf.Controls">
    <StackPanel Margin="0,8,0,0">

        <Expander Header="フォント" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="フォント名" Style="{DynamicResource FieldLabelStyle}" />
                <ComboBox x:Name="GraphFontComboBox"
                          Style="{DynamicResource InputComboBoxStyle}"
                          IsEditable="True"
                          SelectedIndex="0"
                          Margin="0,0,0,10"
                          SelectionChanged="GraphFontComboBox_SelectionChanged"
                          Loaded="GraphFontComboBox_Loaded">
                    <ComboBoxItem Content="Auto" Tag="Auto" />
                    <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                    <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                    <ComboBoxItem Content="Arial" Tag="Arial" />
                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                    <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                </ComboBox>

                <TextBlock Text="フォントサイズ" Style="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="GraphFontSizeTextBox"
                         Text="12"
                         Style="{DynamicResource InputTextBoxStyle}"
                         TextChanged="NumericTextBox_TextChanged" />
            </StackPanel>
        </Expander>

        <Expander Header="目盛" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <CheckBox x:Name="YAxisTickLabelsCheckBox"
                          Content="Y軸の数字を表示する"
                          IsChecked="True"
                          Margin="0,0,0,6"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed" />
                <CheckBox x:Name="MajorTicksCheckBox"
                          Content="主目盛を表示する"
                          IsChecked="True"
                          Margin="0,0,0,6"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed" />
                <CheckBox x:Name="MinorTicksCheckBox"
                          Content="補助目盛を表示する"
                          IsChecked="True"
                          Margin="0,0,0,10"
                          Checked="CheckBox_Changed"
                          Unchecked="CheckBox_Changed" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="目盛の密度" Style="{DynamicResource FieldLabelStyle}" />
                        <TextBox x:Name="TickDensityTextBox"
                                 Text="0.5"
                                 Style="{DynamicResource InputTextBoxStyle}"
                                 ToolTip="0.1〜2.0 の範囲で入力 / 0.5=標準, 小さいほど目盛が粗くなる"
                                 TextChanged="NumericTextBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="目盛の線幅" Style="{DynamicResource FieldLabelStyle}" />
                        <TextBox x:Name="TickWidthTextBox"
                                 Text="1"
                                 Style="{DynamicResource InputTextBoxStyle}"
                                 ToolTip="正の数で入力 (主目盛・補助目盛に共通)"
                                 TextChanged="NumericTextBox_TextChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="枠とグリッド" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="PlotGridCheckBox"
                              Grid.Column="0"
                              Content="グリッドを表示"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              ToolTip="グリッド線の表示を切替 (Ctrl+G)"
                              Checked="CheckBox_Changed"
                              Unchecked="CheckBox_Changed" />
                    <CheckBox x:Name="PlotFrameCheckBox"
                              Grid.Column="2"
                              Content="プロット枠を表示"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Checked="CheckBox_Changed"
                              Unchecked="CheckBox_Changed" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="枠線幅" Style="{DynamicResource FieldLabelStyle}" />
                        <TextBox x:Name="PlotFrameWidthTextBox"
                                 Text="1"
                                 Style="{DynamicResource InputTextBoxStyle}"
                                 TextChanged="NumericTextBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="枠色" Style="{DynamicResource FieldLabelStyle}" />
                        <controls:ColorPickerPanel x:Name="PlotFrameColorPicker"
                                                    AllowAuto="False"
                                                    DefaultHex="#475569"
                                                    ColorChanged="ColorPicker_ColorChanged">
                            <ComboBoxItem Content="Gray" Tag="#475569" IsSelected="True" />
                            <ComboBoxItem Content="Black" Tag="#0F172A" />
                            <ComboBoxItem Content="Blue" Tag="#2563EB" />
                            <ComboBoxItem Content="Red" Tag="#DC2626" />
                            <ComboBoxItem Content="Green" Tag="#16A34A" />
                            <ComboBoxItem Content="Custom" Tag="Custom" />
                        </controls:ColorPickerPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <Expander Header="背景" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="背景色" Style="{DynamicResource FieldLabelStyle}" />
                <controls:ColorPickerPanel x:Name="BackgroundColorPicker"
                                            AllowAuto="False"
                                            DefaultHex="#FFFFFF"
                                            ColorChanged="ColorPicker_ColorChanged"
                                            Margin="0,0,0,8">
                    <ComboBoxItem Content="White" Tag="#FFFFFF" IsSelected="True" />
                    <ComboBoxItem Content="Off-white" Tag="#F8FAFC" />
                    <ComboBoxItem Content="Light gray" Tag="#E2E8F0" />
                    <ComboBoxItem Content="Black" Tag="#0F172A" />
                    <ComboBoxItem Content="Custom" Tag="Custom" />
                </controls:ColorPickerPanel>

                <TextBlock Text="アスペクト比" Style="{DynamicResource FieldLabelStyle}" />
                <ComboBox x:Name="AspectRatioComboBox"
                          Style="{DynamicResource InputComboBoxStyle}"
                          SelectedIndex="0"
                          SelectionChanged="AspectRatioComboBox_SelectionChanged">
                    <ComboBoxItem Content="Auto" Tag="Auto" />
                    <ComboBoxItem Content="16:9" Tag="16:9" />
                    <ComboBoxItem Content="4:3" Tag="4:3" />
                    <ComboBoxItem Content="3:2" Tag="3:2" />
                    <ComboBoxItem Content="1:1" Tag="1:1" />
                </ComboBox>
            </StackPanel>
        </Expander>

        <Expander Header="凡例" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="表示" Style="{DynamicResource FieldLabelStyle}" />
                <ComboBox x:Name="LegendVisibilityComboBox"
                          Style="{DynamicResource InputComboBoxStyle}"
                          Margin="0,0,0,8"
                          SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Content="自動 (2件以上で表示)" Tag="Auto" IsSelected="True" />
                    <ComboBoxItem Content="常に表示" Tag="Always" />
                    <ComboBoxItem Content="非表示" Tag="Never" />
                </ComboBox>

                <TextBlock Text="位置" Style="{DynamicResource FieldLabelStyle}" />
                <ComboBox x:Name="LegendPositionComboBox"
                          Style="{DynamicResource InputComboBoxStyle}"
                          Margin="0,0,0,8"
                          SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Content="右上" Tag="UpperRight" IsSelected="True" />
                    <ComboBoxItem Content="左上" Tag="UpperLeft" />
                    <ComboBoxItem Content="右下" Tag="LowerRight" />
                    <ComboBoxItem Content="左下" Tag="LowerLeft" />
                    <ComboBoxItem Content="右中央" Tag="MiddleRight" />
                </ComboBox>

                <TextBlock Text="凡例フォントサイズ" Style="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="LegendFontSizeTextBox"
                         Style="{DynamicResource InputTextBoxStyle}"
                         ToolTip="空欄で自動"
                         TextChanged="NumericTextBox_TextChanged" />
            </StackPanel>
        </Expander>

    </StackPanel>
</UserControl>
