<Window x:Class="Spectrum_Visualization.CalibrationCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Beer-Lambert 検量線エディタ"
        Height="720" Width="1140" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Beer-Lambert 検量線エディタ"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <TextBlock Text="濃度を割り当てたデータセットから A = εcl の傾きを求めます。"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings panel -->
        <Border Grid.Row="1" Style="{StaticResource SectionStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="定量モード" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="ModeComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="ModeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="SingleWavelength" Content="単一波長 (A)" />
                            <ComboBoxItem Tag="IntegrationArea" Content="積分領域 (面積)" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="WavelengthLabel"
                                   Text="波長 [nm]"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="WavelengthTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="単一波長モードのとき、ここで指定した波長の Absorbance を読み取ります"
                                 TextChanged="WavelengthTextBox_TextChanged" />
                        <ComboBox x:Name="RegionComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  Visibility="Collapsed"
                                  ToolTip="積分領域モードのとき、参照する領域を選択します（書式パネルの『積分』で定義した領域から選びます）"
                                  SelectionChanged="RegionComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="セル長 l [cm]" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PathLengthTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="ε = slope / l。標準キュベットは 1 cm"
                                 TextChanged="PathLengthTextBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="切片の扱い" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="FitModeComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="FitModeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ForceOrigin" Content="原点強制 (y = m x)" />
                            <ComboBoxItem Tag="WithIntercept" Content="切片あり (y = m x + b)" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="濃度の単位" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="UnitComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="UnitComboBox_SelectionChanged">
                            <ComboBoxItem Tag="MolPerLiter" Content="M (mol/L)" />
                            <ComboBoxItem Tag="MillimolPerLiter" Content="mM" />
                            <ComboBoxItem Tag="MicromolPerLiter" Content="μM" />
                            <ComboBoxItem Tag="NanomolPerLiter" Content="nM" />
                            <ComboBoxItem Tag="MilligramPerMilliliter" Content="mg/mL" />
                            <ComboBoxItem Tag="GramPerLiter" Content="g/L" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" x:Name="MolarMassPanel" Visibility="Collapsed">
                        <TextBlock Text="分子量 [g/mol]" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="MolarMassTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 ToolTip="mg/mL や g/L を選んだときに mol/L へ換算するために必要"
                                 TextChanged="MolarMassTextBox_TextChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main area: sample table + plot -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Left: sample DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="サンプル一覧"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#0F172A"
                               Margin="0,0,0,8" />

                    <DataGrid x:Name="SamplesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CellEditEnding="SamplesDataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="データセット"
                                                Binding="{Binding DisplayName}"
                                                IsReadOnly="True"
                                                Width="*"
                                                MinWidth="120" />
                            <DataGridTextColumn Header="濃度"
                                                Binding="{Binding ConcentrationText, UpdateSourceTrigger=LostFocus}"
                                                Width="80" />
                            <DataGridTextColumn Header="[M]"
                                                Binding="{Binding ConcentrationMolarText}"
                                                IsReadOnly="True"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="6,0,8,0" />
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="信号"
                                                Binding="{Binding SignalText}"
                                                IsReadOnly="True"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="6,0,8,0" />
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="予測"
                                                Binding="{Binding PredictedText}"
                                                IsReadOnly="True"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="6,0,8,0" />
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="残差"
                                                Binding="{Binding ResidualText}"
                                                IsReadOnly="True"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="6,0,8,0" />
                                        <Setter Property="Foreground" Value="#64748B" />
                                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="除外"
                                                    Binding="{Binding IsExcluded, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="48" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               x:Name="UnitHelpTextBlock"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Right: plot + result text -->
            <Border Grid.Column="2" Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="検量線"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#0F172A"
                               Margin="0,0,0,8" />

                    <scott:WpfPlot Grid.Row="1"
                                   x:Name="CalibrationPlotHost"
                                   MinHeight="240" />

                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="ResultSummaryTextBlock"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   FontSize="12"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status text (errors / warnings) -->
        <TextBlock Grid.Row="3"
                   x:Name="StatusTextBlock"
                   FontSize="11"
                   Foreground="#B45309"
                   Margin="2,8,2,0"
                   TextWrapping="Wrap" />

        <!-- Action buttons -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="ExportButton"
                    Content="CSV / XLSX 出力"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ExportButton_Click" />

            <Button Grid.Column="2"
                    x:Name="CancelButton"
                    Content="キャンセル"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="CancelButton_Click" />
            <Button Grid.Column="4"
                    x:Name="OkButton"
                    Content="OK"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OkButton_Click" />
        </Grid>
    </Grid>
</Window>
