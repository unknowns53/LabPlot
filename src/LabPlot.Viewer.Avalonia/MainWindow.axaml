<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.Viewer.Avalonia"
        x:Class="LabPlot.Viewer.Avalonia.MainWindow"
        Title="Data Viewer"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="860" MinHeight="660" Width="1280" MinWidth="960"
        Background="{DynamicResource MainBgSurfaceBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full"
        DragDrop.AllowDrop="True">

    <!-- 汎用データビューア: GPC MainWindow を雛形にした構成。
         サイドバーはセクション数が増えて縦に長くなったため、
         「データ」(ファイル / テーブル / X 列 / 系列 / 表示条件) と
         「仕上げ」(軸範囲 / 軸スケール / グラフラベル / グラフ書式) の
         2 タブに分割する。既定値の sticky footer はタブの外に置き、
         どちらのタブでも常に見える。 -->

    <Window.Resources>
        <!-- サイドバー上部のタブ切替 (RadioButton 2 個によるセグメントコントロール)。
             リポジトリ共通の CommonStyles.axaml には TabControl 相当のテーマが
             ないため自前で書く。スコープは Data Viewer のみ (Window.Resources)。 -->
        <ControlTheme x:Key="SidebarTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border Name="FocusRing"
                                CornerRadius="7"
                                BorderBrush="#2563EB"
                                BorderThickness="2"
                                Margin="-1"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter>

            <!-- 選択中: 白背景 + 軽い影 + アクセント文字色。標準の点線
                 FocusVisualStyle は使わず、フォーカス時のみ枠色で示す。 -->
            <Style Selector="^:checked /template/ Border#SegmentBorder">
                <Setter Property="Background" Value="White" />
                <Setter Property="BoxShadow" Value="0 1 4 0 #260F172A" />
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Foreground" Value="#1D4ED8" />
            </Style>
            <Style Selector="^:not(:checked):pointerover">
                <Setter Property="Foreground" Value="#334155" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*">

            <!-- ================= TITLE BAR ================= -->
            <controls:CustomTitleBar Grid.Row="0"
                                     Name="MainTitleBar"
                                     AppName="Data Viewer"
                                     Subtitle="Tabular data viewer"
                                     AppIconData="M 3,3 L 3,17 L 17,17 M 6,13 L 9,8 L 12,11 L 16,5" />

            <Grid Grid.Row="1" ColumnDefinitions="360,*">

                <!-- ================= SIDEBAR ================= -->
                <Border Grid.Column="0"
                        Background="#EEF2F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- サイドバータブ切替 (セグメントコントロール) -->
                        <Border Grid.Row="0"
                                Background="#E2E8F0"
                                CornerRadius="8"
                                Padding="3"
                                Margin="20,10,20,0">
                            <Grid ColumnDefinitions="*,*">
                                <RadioButton Name="DataTabRadioButton"
                                             Grid.Column="0"
                                             GroupName="SidebarTabGroup"
                                             Content="データ"
                                             IsChecked="True"
                                             Theme="{DynamicResource SidebarTabRadioButtonStyle}"
                                             Margin="0,0,2,0"
                                             IsCheckedChanged="SidebarTabRadioButton_IsCheckedChanged" />
                                <RadioButton Name="FormatTabRadioButton"
                                             Grid.Column="1"
                                             GroupName="SidebarTabGroup"
                                             Content="仕上げ"
                                             Theme="{DynamicResource SidebarTabRadioButtonStyle}"
                                             Margin="2,0,0,0"
                                             IsCheckedChanged="SidebarTabRadioButton_IsCheckedChanged" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Name="SidebarScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                            <StackPanel Name="DataTabPanel" Margin="20,10,20,12">

                                <!-- Section: File -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DataFileIconGeometry}" />
                                                <TextBlock Text="データファイル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenFileButton"
                                                    Content="CSV / TSV / xlsx を開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,8"
                                                    ToolTip.Tip="表形式データを開く (Ctrl+O)"
                                                    Click="OpenFileButton_Click" />
                                            <TextBlock Text="CSV / TSV / セミコロン / 空白区切りのテキストと Excel ブック (.xlsx) を読み込めます。1 列目（最初の数値列）が X、残りの数値列が Y 系列になります。Excel からコピーした表は Ctrl+V で直接貼り付けできます。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="最近開いた"
                                                       Theme="{DynamicResource FieldLabelStyle}"
                                                       Margin="0,10,0,4" />
                                            <ComboBox Name="RecentFilesComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="(履歴なし)"
                                                      IsEnabled="False"
                                                      SelectionChanged="RecentFilesComboBox_SelectionChanged"
                                                      ToolTip.Tip="直近に開いたファイル (最大 5 件) を選んで再読み込みします。右クリックで履歴をクリア。">
                                                <ComboBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="履歴をクリア"
                                                                  Click="ClearRecentFilesMenuItem_Click">
                                                            <MenuItem.Icon>
                                                                <Path Width="14" Height="14"
                                                                      Stroke="#475569"
                                                                      StrokeThickness="1.4"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Fill="Transparent"
                                                                      Data="M 2.5,4 L 13.5,4 M 5,4 L 5,2.8 L 11,2.8 L 11,4 M 4,4.5 L 4.8,13.2 L 11.2,13.2 L 12,4.5 M 6.5,6.5 L 6.5,11.5 M 9.5,6.5 L 9.5,11.5" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </ComboBox.ContextMenu>
                                            </ComboBox>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Loaded tables -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DatasetListIconGeometry}" />
                                                <TextBlock Text="テーブル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="#F8FAFC">
                                                <Grid>
                                                    <ListBox Name="TableListBox"
                                                             MinHeight="120"
                                                             MaxHeight="180"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             SelectionChanged="TableListBox_SelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MainWindow+TableEntryVm">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Grid.Column="0"
                                                                            Width="14" Height="14"
                                                                            Background="{CompiledBinding ColorBrush}"
                                                                            CornerRadius="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="2,0,8,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{CompiledBinding DisplayName}"
                                                                               ToolTip.Tip="{CompiledBinding FullPath}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2"
                                                                            Content="×"
                                                                            Theme="{DynamicResource IconButtonStyle}"
                                                                            VerticalAlignment="Center"
                                                                            Tag="{CompiledBinding}"
                                                                            Click="RemoveTableButton_Click"
                                                                            ToolTip.Tip="削除" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Name="TableListPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,18,8,18"
                                                                IsHitTestVisible="False">
                                                        <Path Width="32" Height="32"
                                                              Stretch="None"
                                                              Stroke="#94A3B8"
                                                              StrokeThickness="1.5"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                                        <TextBlock Text="ここにファイルをドロップ"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,2" />
                                                        <TextBlock Text="または上のボタンから開く"
                                                                   FontSize="11"
                                                                   Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <Rectangle Name="TableDropOverlay"
                                                               Stroke="#2563EB"
                                                               StrokeThickness="2"
                                                               StrokeDashArray="3,2"
                                                               Fill="#4DDBEAFE"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               IsHitTestVisible="False"
                                                               IsVisible="False" />
                                                    <!-- 内部 reorder 用の insertion line (GPC と同方式: AdornerLayer の
                                                         代替として sibling を絶対位置決めし Margin / IsVisible で動かす) -->
                                                    <Grid Name="InsertionLine"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Top"
                                                          Height="12"
                                                          Margin="0"
                                                          IsVisible="False"
                                                          IsHitTestVisible="False">
                                                        <Grid.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Color="#2563EB"
                                                                              Opacity="0.55"
                                                                              OffsetX="0"
                                                                              OffsetY="0" />
                                                        </Grid.Effect>
                                                        <Rectangle Height="2"
                                                                   VerticalAlignment="Center"
                                                                   Fill="#2563EB"
                                                                   Opacity="0.85" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: X column mapping (選択中テーブル) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="M 1,3 L 13,3 M 1,7 L 13,7 M 1,11 L 13,11 M 5,1 L 5,13 M 9,1 L 9,13" />
                                                <TextBlock Text="X 列（選択中テーブル）"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Name="MappingTableLabel"
                                                           Text="(テーブル未選択)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,0,2" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="X 列"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="XColumnComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,8"
                                                      PlaceholderText="(数値列なし)"
                                                      ToolTip.Tip="横軸に使う列を選択"
                                                      SelectionChanged="XColumnComboBox_SelectionChanged" />
                                            <TextBlock Text="ここで選んだ列がグラフの横軸になります。系列の表示 / 非表示・色・右軸などは下の「系列」一覧で編集します。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Series (全ファイル横断のフラット系列一覧が主役) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource LineStyleIconGeometry}" />
                                                <TextBlock Text="系列"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Name="SeriesSelectionSummaryLabel"
                                                           Text="(系列未選択)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,0,2" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">

                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="#F8FAFC">
                                                <Grid>
                                                    <ListBox Name="SeriesListBox"
                                                             SelectionMode="Multiple"
                                                             MinHeight="160"
                                                             MaxHeight="420"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             SelectionChanged="SeriesListBox_SelectionChanged">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MainWindow+SeriesListRowVm">
                                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,2,0,2">
                                                                    <!-- ドラッグハンドル: Path 単体だと線の隙間が hit-test を
                                                                         取りこぼすため、透明な Border で包んで判定域を確保する。
                                                                         Name はコードビハインドの祖先検索で「ハンドル上の
                                                                         Press か」を判定するマーカーとして使う。 -->
                                                                    <Border Grid.Column="0"
                                                                            Name="SeriesDragHandle"
                                                                            Background="Transparent"
                                                                            Padding="4,4"
                                                                            Margin="0,0,2,0"
                                                                            Cursor="SizeAll"
                                                                            ToolTip.Tip="ドラッグして並べ替え"
                                                                            VerticalAlignment="Center">
                                                                        <Path Width="7" Height="11"
                                                                              Stretch="None"
                                                                              Fill="#94A3B8"
                                                                              Data="M1.5,0.5 A1,1 0 1 0 1.5,2.5 A1,1 0 1 0 1.5,0.5 M5.5,0.5 A1,1 0 1 0 5.5,2.5 A1,1 0 1 0 5.5,0.5 M1.5,4.5 A1,1 0 1 0 1.5,6.5 A1,1 0 1 0 1.5,4.5 M5.5,4.5 A1,1 0 1 0 5.5,6.5 A1,1 0 1 0 5.5,4.5 M1.5,8.5 A1,1 0 1 0 1.5,10.5 A1,1 0 1 0 1.5,8.5 M5.5,8.5 A1,1 0 1 0 5.5,10.5 A1,1 0 1 0 5.5,8.5" />
                                                                    </Border>
                                                                    <CheckBox Grid.Column="1"
                                                                              IsChecked="{CompiledBinding IsVisible, Mode=TwoWay}"
                                                                              Tag="{CompiledBinding}"
                                                                              Click="SeriesVisibleCheckBox_Click"
                                                                              VerticalAlignment="Center" />
                                                                    <Border Grid.Column="2"
                                                                            Width="14" Height="14"
                                                                            Background="{CompiledBinding ColorBrush}"
                                                                            CornerRadius="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="6,0,8,0" />
                                                                    <Panel Grid.Column="3"
                                                                           Background="Transparent"
                                                                           Tag="{CompiledBinding}"
                                                                           DoubleTapped="SeriesNameTextBlock_DoubleTapped">
                                                                        <TextBlock Text="{CompiledBinding DisplayName}"
                                                                                   ToolTip.Tip="{CompiledBinding SourceHint}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   IsVisible="{CompiledBinding IsNotEditing}"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBox Theme="{DynamicResource InputTextBoxStyle}"
                                                                                 Tag="{CompiledBinding}"
                                                                                 IsVisible="{CompiledBinding IsEditing}"
                                                                                 Height="24"
                                                                                 MaxWidth="{CompiledBinding $parent[Panel].Bounds.Width}"
                                                                                 Padding="4,2"
                                                                                 FontSize="12"
                                                                                 VerticalAlignment="Center"
                                                                                 ToolTip.Tip="Enter で確定 / Escape で取り消し"
                                                                                 TextChanged="SeriesNameEditBox_TextChanged"
                                                                                 LostFocus="SeriesNameEditBox_LostFocus"
                                                                                 KeyDown="SeriesNameEditBox_KeyDown" />
                                                                    </Panel>
                                                                    <!-- 右軸の割り当ては行のチェックボックスではなくスタイル
                                                                         パネル側 (RightAxisCheckBox) で行う。ここには割当中
                                                                         だけ見える小さいインジケータだけを残す。 -->
                                                                    <Border Grid.Column="4"
                                                                            CornerRadius="3"
                                                                            Padding="3,0"
                                                                            Background="#DBEAFE"
                                                                            IsVisible="{CompiledBinding UseRightAxis}"
                                                                            ToolTip.Tip="右 Y 軸 (第 2 軸) に割り当て中"
                                                                            VerticalAlignment="Center"
                                                                            Margin="6,0,0,0">
                                                                        <TextBlock Text="右軸"
                                                                                   FontSize="10"
                                                                                   Foreground="#2563EB" />
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Name="SeriesListPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,18,8,18"
                                                                IsHitTestVisible="False">
                                                        <Path Width="32" Height="32"
                                                              Stretch="None"
                                                              Stroke="#94A3B8"
                                                              StrokeThickness="1.5"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              Data="{StaticResource DatasetListIconGeometry}" />
                                                        <TextBlock Text="ファイルを読み込むと、ここに全ファイルの系列が並びます"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   MaxWidth="240"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,2" />
                                                    </StackPanel>
                                                    <!-- 内部 reorder 用の insertion line (テーブル一覧の InsertionLine と同構造) -->
                                                    <Grid Name="SeriesInsertionLine"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Top"
                                                          Height="12"
                                                          Margin="0"
                                                          IsVisible="False"
                                                          IsHitTestVisible="False">
                                                        <Grid.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Color="#2563EB"
                                                                              Opacity="0.55"
                                                                              OffsetX="0"
                                                                              OffsetY="0" />
                                                        </Grid.Effect>
                                                        <Rectangle Height="2"
                                                                   VerticalAlignment="Center"
                                                                   Fill="#2563EB"
                                                                   Opacity="0.85" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Height="1" Background="#E2E8F0" Margin="0,12,0,10" />

                                            <TextBlock Name="SeriesStyleBulkHintLabel"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       IsVisible="False" />

                                            <TextBlock Text="グラフ種別"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="ChartTypeComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,10"
                                                      SelectedIndex="0"
                                                      ToolTip.Tip="選択中の系列の描き方（折れ線 / マーカー / 棒）"
                                                      SelectionChanged="ChartTypeComboBox_SelectionChanged">
                                                <ComboBoxItem>折れ線</ComboBoxItem>
                                                <ComboBoxItem>マーカーのみ</ComboBoxItem>
                                                <ComboBoxItem>折れ線＋マーカー</ComboBoxItem>
                                                <ComboBoxItem>棒グラフ</ComboBoxItem>
                                            </ComboBox>

                                            <CheckBox Name="RightAxisCheckBox"
                                                      Content="右 Y 軸 (第 2 軸) に割り当て"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,10"
                                                      ToolTip.Tip="選択中の系列を右 Y 軸 (第 2 軸) に割り当て"
                                                      Click="RightAxisCheckBox_Click" />

                                            <TextBlock Text="色"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <controls:ColorPickerPanel Name="LineColorPicker"
                                                                        AllowAuto="True"
                                                                        DefaultHex="#2563EB"
                                                                        Margin="0,0,0,10"
                                                                        ColorChanged="LineColorPicker_ColorChanged">
                                                <controls:ColorPickerPanel.Presets>
                                                    <ComboBoxItem Tag="Auto" IsSelected="True">
                                                        <TextBlock Text="Auto" />
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="Custom">
                                                        <TextBlock Text="Custom" />
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#2563EB">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Blue" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#DC2626">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Red" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#16A34A">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Green" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#EA580C">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Orange" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#7C3AED">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Purple" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#0891B2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Cyan" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#BE123C">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Rose" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#4B5563">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Gray" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                </controls:ColorPickerPanel.Presets>
                                            </controls:ColorPickerPanel>

                                            <TextBlock Text="凡例名は一覧の系列名をダブルクリック（または F2）で編集できます"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10" />

                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="線幅"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="LineWidthTextBox"
                                                             Text="1.5"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="StyleNumberTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="マーカー"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="MarkerSizeTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="StyleNumberTextBox_TextChanged"
                                                             LostFocus="MarkerSizeTextBox_LostFocus" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="#E2E8F0" Margin="0,12,0,10" />

                                            <TextBlock Text="変換（非破壊・選択中の系列のみ）"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       Margin="0,0,0,6" />
                                            <CheckBox Name="NormalizeCheckBox"
                                                      Content="正規化 (max = 1)"
                                                      Margin="0,0,0,8"
                                                      ToolTip.Tip="系列の絶対値最大が 1 になるようスケール"
                                                      IsCheckedChanged="NormalizeCheckBox_Changed" />
                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Y オフセット"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="YOffsetTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             ToolTip.Tip="系列全体を Y 方向にずらす (正規化の後に加算)"
                                                             TextChanged="TransformTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="平滑化窓"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="SmoothingWindowTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             ToolTip.Tip="中央移動平均の窓幅 (0 / 1 で無効、偶数は奇数に丸め)"
                                                             TextChanged="TransformTextBox_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: View session -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AnalysisConditionsIconGeometry}" />
                                                <TextBlock Text="表示条件"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="SaveSessionButton"
                                                    Content="表示条件を保存"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    Margin="0,0,0,8"
                                                    ToolTip.Tip="表示条件を .gvjson に保存 (Ctrl+Shift+S)"
                                                    Click="SaveSessionButton_Click" />
                                            <Button Name="LoadSessionButton"
                                                    Content="表示条件を読み込み"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="表示条件 (.gvjson) を読み込み (Ctrl+Shift+O)"
                                                    Click="LoadSessionButton_Click" />
                                            <TextBlock Text="今の表示状態（テーブル・列マッピング・系列スタイル・変換・軸設定・グラフ書式）を任意の場所に .gvjson として保存します。ファイル由来のテーブルはパス参照、クリップボード由来のテーブルはデータごと埋め込んで復元します。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                            </StackPanel>
                            <StackPanel Name="FormatTabPanel" Margin="20,10,20,12" IsVisible="False">

                                <!-- Section: Axis range -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AxisRangeIconGeometry}" />
                                                <TextBlock Text="軸範囲"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:AxisRangePanel Name="AxisRangePanel"
                                                                 Margin="0,8,0,0"
                                                                 XAxisLabel="X"
                                                                 YAxisLabel="Y"
                                                                 NumberFormat="G6"
                                                                 AxisRangeCommitted="AxisRangePanel_Committed"
                                                                 CaptureCurrentRangeRequested="AxisRangePanel_CaptureCurrentRangeRequested" />
                                    </Expander>
                                </Border>

                                <!-- Section: Axis scale (log / 右軸) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="M 1,1 L 1,13 L 13,13 M 3,11 Q 4,4 6,3 M 7,11 Q 9.5,9 12,8.5" />
                                                <TextBlock Text="軸スケール"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="*,8,*">
                                                <CheckBox Name="XLogCheckBox"
                                                          Grid.Column="0"
                                                          Content="X 軸 log"
                                                          ToolTip.Tip="X 軸を対数スケールで表示 (0 以下の点は描画されません)"
                                                          IsCheckedChanged="AxisScaleCheckBox_Changed" />
                                                <CheckBox Name="YLogCheckBox"
                                                          Grid.Column="2"
                                                          Content="Y 軸 log"
                                                          ToolTip.Tip="左 Y 軸を対数スケールで表示 (0 以下の点は描画されません)"
                                                          IsCheckedChanged="AxisScaleCheckBox_Changed" />
                                            </Grid>

                                            <Border Height="1" Background="#E2E8F0" Margin="0,10,0,10" />

                                            <TextBlock Text="右 Y 軸（第 2 軸）"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       Margin="0,0,0,6" />
                                            <CheckBox Name="Y2LogCheckBox"
                                                      Content="右 Y 軸 log"
                                                      Margin="0,0,0,8"
                                                      ToolTip.Tip="右 Y 軸を対数スケールで表示"
                                                      IsCheckedChanged="AxisScaleCheckBox_Changed" />
                                            <TextBlock Text="右 Y 軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="Y2LabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,8"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="右 Y Min"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="Y2MinTextBox"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             Watermark="auto"
                                                             TextChanged="Y2RangeTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="右 Y Max"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="Y2MaxTextBox"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             Watermark="auto"
                                                             TextChanged="Y2RangeTextBox_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="系列を右軸に割り当てるには、系列スタイルの「右 Y 軸 (第 2 軸) に割り当て」チェックを使ってください。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Graph labels -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphLabelIconGeometry}" />
                                                <TextBlock Text="グラフラベル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="タイトル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="TitleTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,8,*">
                                                <CheckBox Name="TitleVisibleCheckBox"
                                                          Grid.Column="0"
                                                          Content="表示する"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                                <CheckBox Name="TitleBoldCheckBox"
                                                          Grid.Column="2"
                                                          Content="太字"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                            </Grid>

                                            <TextBlock Text="X軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="XLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,8"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />

                                            <TextBlock Text="Y軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="YLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <CheckBox Name="AxisLabelBoldCheckBox"
                                                      Content="軸ラベルを太字"
                                                      Margin="0,0,0,0"
                                                      IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Graph appearance -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphFormatIconGeometry}" />
                                                <TextBlock Text="グラフ書式"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:GraphFormatPanel Name="GraphFormatPanel"
                                                                   GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                                   AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />
                                    </Expander>
                                </Border>

                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Sticky footer: defaults -->
                        <Border Grid.Row="2"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="0,1,0,0"
                                Padding="20,12,20,14"
                                BoxShadow="0 3 10 0 #1A0F172A">
                            <StackPanel>
                                <TextBlock Text="既定値（次回起動時の初期状態）"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8" />
                                <Grid ColumnDefinitions="*,10,*">
                                    <Button Name="ResetGraphSettingsButton"
                                            Grid.Column="0"
                                            Content="既定値に戻す"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="グラフ書式・系列スタイルを、保存されている既定値に戻します"
                                            Click="ResetGraphSettingsButton_Click" />
                                    <Button Name="SaveDefaultFormattingButton"
                                            Grid.Column="2"
                                            Content="既定値として保存"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="現在のグラフ書式を、次回起動時の既定値として保存します"
                                            Click="SaveDefaultFormattingButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN AREA ================= -->
                <Grid Grid.Column="1" Margin="24,22,24,18"
                      RowDefinitions="Auto,*,Auto">

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                        <Button Name="SaveGraphButton"
                                DockPanel.Dock="Right"
                                Content="PNG / SVG 保存"
                                Theme="{DynamicResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                ToolTip.Tip="グラフを PNG / SVG で保存 (Ctrl+S)"
                                Click="SaveGraphButton_Click" />
                        <Button Name="ExportDataButton"
                                DockPanel.Dock="Right"
                                Content="データ出力"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                ToolTip.Tip="表示中の系列を CSV / xlsx で出力 (Ctrl+E)"
                                Click="ExportDataButton_Click" />
                        <TextBlock Text="Data Viewer"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B" />
                    </DockPanel>

                    <Border Name="PlotContainerBorder"
                            Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            SizeChanged="PlotContainerBorder_SizeChanged">
                        <Grid>
                            <Grid Name="PlotPlaceholderSkeleton"
                                  Width="320" Height="200"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Grid Width="320" Height="180"
                                      VerticalAlignment="Top"
                                      ClipToBounds="True">
                                    <Canvas Width="320" Height="180">
                                        <Rectangle Canvas.Left="22" Canvas.Top="20"
                                                   Width="2" Height="140"
                                                   Fill="#E2E8F0" />
                                        <Rectangle Canvas.Left="20" Canvas.Top="158"
                                                   Width="280" Height="2"
                                                   Fill="#E2E8F0" />
                                        <Path Stroke="#CBD5E1"
                                              StrokeThickness="2.5"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="M 30,140 L 80,110 L 130,125 L 180,60 L 230,85 L 290,40" />
                                    </Canvas>
                                    <Border Classes="shimmer"
                                            Width="120" Height="180"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-120" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid Name="PlotHost" />
                            <TextBlock Name="PlotPlaceholderTextBlock"
                                       Text="グラフを初期化しています..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,116,0,0"
                                       IsHitTestVisible="False" />
                            <Border Name="PlotControlsHintBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Help">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="プロット操作"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                        <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                        <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                        <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                        <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <Path Width="3" Height="9"
                                      Fill="#475569"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Data="M 1.5,0 A 1.25,1.25 0 1 0 1.5,2.5 A 1.25,1.25 0 1 0 1.5,0 Z M 0.25,3.75 H 2.75 V 9 H 0.25 Z" />
                            </Border>
                            <controls:ErrorBanner Name="ErrorBanner" />
                            <controls:BusyOverlay Name="BusyOverlay" />
                            <controls:ToastHost Name="Toast" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <controls:StatusBar Name="StatusBar" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
