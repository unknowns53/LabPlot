<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabPlot.Shell.Avalonia.App"
             RequestedThemeVariant="Light">

    <!--
      macOS のアプリメニューバー (LabPlot ▸ About / Preferences / Quit) を組む。
      NativeMenu は macOS で NSMenu に橋渡しされ、Windows / Linux では無視される。
      Quit (Cmd+Q) / Hide / Hide Others / Show All は AppKit が自動でアプリメニューに
      足してくれるので明示しない。About / Preferences だけここでぶら下げ、Click 時に
      App.OnAbout_Click / OnPreferences_Click を発火させる。
    -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About LabPlot" Click="OnAbout_Click" />
            <NativeMenuItem Header="Preferences..." Gesture="Cmd+OemComma" Click="OnPreferences_Click" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <!-- Core.Avalonia の共通リソース (Brush / StreamGeometry / ControlTheme) を
             Application 全体に展開する。WPF 版 App.xaml の MergedDictionaries に
             相当するが、Avalonia は ResourceInclude を使う。 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- v1.3.5: 色 / 寸法 / フォントのデザイントークンを styles より先に Include。
                     CommonStyles.axaml の ControlTheme は {StaticResource AccentBrush} 等で
                     名前引きするので、解決順序として Tokens が先である必要がある。 -->
                <ResourceInclude Source="avares://LabPlot.Core.Avalonia/Themes/CommonTokens.axaml" />
                <ResourceInclude Source="avares://LabPlot.Core.Avalonia/Themes/CommonStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- 暗黙 Style 群 (ScrollBar / ComboBoxItem 等) を取り込む。CommonStyles.axaml
             側の Setter は ControlTheme として登録されるが、こちらは Selector 直書きの
             Style なので Application.Styles 経由で適用する必要がある。 -->
        <StyleInclude Source="avares://LabPlot.Core.Avalonia/Themes/ImplicitStyles.axaml" />
    </Application.Styles>
</Application>
