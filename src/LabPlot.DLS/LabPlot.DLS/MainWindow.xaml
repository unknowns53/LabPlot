<Window x:Class="LabPlot.DLS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LabPlot.DLS"
        xmlns:controls="clr-namespace:LabPlot.Core.Wpf.Controls;assembly=LabPlot.Core.Wpf"
        Title="LabPlot DLS"
        Width="1280"
        Height="800"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="16,12">
                <StackPanel>
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ファイル" />
                            <Button x:Name="OpenButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="DLS xlsx を開く..."
                                    Click="OpenButton_Click"
                                    Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="読み込み済みデータセット" />
                            <ListBox x:Name="DatasetListBox"
                                     SelectionMode="Extended"
                                     SelectionChanged="DatasetListBox_SelectionChanged"
                                     MinHeight="120"
                                     MaxHeight="280"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Background="#FFFFFF"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SheetName}" Padding="6,4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Ctrl/Shift クリックで複数選択して重ね描きできるよ" />
                            <TextBlock x:Name="DatasetCountText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Text="ファイル未読み込み" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="表示" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="分布の種類" />
                            <ComboBox x:Name="DistributionTypeComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="DistributionTypeComboBox_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Run" />
                            <ComboBox x:Name="RunComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="RunComboBox_SelectionChanged"
                                      IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource GroupLabelStyle}" Text="書式" />

                    <!-- Section: Axis range -->
                    <Border Style="{StaticResource SectionStyle}">
                        <Expander Header="軸範囲" IsExpanded="True">
                            <controls:AxisRangePanel x:Name="AxisRangePanel"
                                                     XAxisLabel="粒径軸 (nm)"
                                                     YAxisLabel="Y 軸 (%)"
                                                     AxisRangeCommitted="AxisRangePanel_Committed"
                                                     Margin="0,8,0,0" />
                        </Expander>
                    </Border>

                    <!-- Section: Graph appearance -->
                    <Border Style="{StaticResource SectionStyle}">
                        <Expander Header="グラフ書式" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <Expander Header="フォント" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="フォント名" />
                                        <ComboBox x:Name="GraphFontComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  IsEditable="True"
                                                  SelectedIndex="0"
                                                  Margin="0,0,0,10"
                                                  SelectionChanged="FormatComboBox_SelectionChanged"
                                                  Loaded="GraphFontComboBox_Loaded">
                                            <ComboBoxItem Content="Auto" Tag="Auto" />
                                            <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                                            <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                                            <ComboBoxItem Content="Arial" Tag="Arial" />
                                            <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                            <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                                        </ComboBox>

                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="フォントサイズ" />
                                        <TextBox x:Name="GraphFontSizeTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 Text="12"
                                                 TextChanged="FormatTextBox_TextChanged" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="ラベル" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="TitleVisibleCheckBox"
                                                  Content="タイトルを表示する"
                                                  IsChecked="True"
                                                  Margin="0,0,0,6"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                        <CheckBox x:Name="TitleBoldCheckBox"
                                                  Content="タイトルを太字にする"
                                                  IsChecked="True"
                                                  Margin="0,0,0,6"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                        <CheckBox x:Name="AxisLabelBoldCheckBox"
                                                  Content="軸ラベルを太字にする"
                                                  Margin="0,0,0,0"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="目盛" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="YAxisTickLabelsCheckBox"
                                                  Content="Y 軸の数字を表示する"
                                                  IsChecked="True"
                                                  Margin="0,0,0,6"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                        <CheckBox x:Name="MajorTicksCheckBox"
                                                  Content="主目盛を表示する"
                                                  IsChecked="True"
                                                  Margin="0,0,0,6"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                        <CheckBox x:Name="MinorTicksCheckBox"
                                                  Content="補助目盛を表示する"
                                                  IsChecked="True"
                                                  Margin="0,0,0,0"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="枠とグリッド" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PlotGridCheckBox"
                                                      Grid.Column="0"
                                                      Content="グリッドを表示"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Checked="FormatCheckBox_Changed"
                                                      Unchecked="FormatCheckBox_Changed" />
                                            <CheckBox x:Name="PlotFrameCheckBox"
                                                      Grid.Column="2"
                                                      Content="プロット枠を表示"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Checked="FormatCheckBox_Changed"
                                                      Unchecked="FormatCheckBox_Changed" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="枠線幅" />
                                                <TextBox x:Name="PlotFrameWidthTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         Text="1"
                                                         TextChanged="FormatTextBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="枠色" />
                                                <ComboBox x:Name="PlotFrameColorComboBox"
                                                          Style="{StaticResource InputComboBoxStyle}"
                                                          SelectedIndex="0"
                                                          Margin="0,0,0,6"
                                                          SelectionChanged="PlotFrameColorComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="Gray" Tag="#475569" />
                                                    <ComboBoxItem Content="Black" Tag="#0F172A" />
                                                    <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                                    <ComboBoxItem Content="Red" Tag="#DC2626" />
                                                    <ComboBoxItem Content="Green" Tag="#16A34A" />
                                                    <ComboBoxItem Content="Custom" Tag="Custom" />
                                                </ComboBox>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PlotFrameColorHexTextBox"
                                                             Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}"
                                                             Text="#475569"
                                                             ToolTip="カラーコード (#RRGGBB)"
                                                             TextChanged="PlotFrameColorHexTextBox_TextChanged" />
                                                    <Border x:Name="PlotFrameColorPreviewBorder"
                                                            Grid.Column="2"
                                                            Height="28"
                                                            Background="#475569"
                                                            BorderBrush="#CBD5E1"
                                                            BorderThickness="1"
                                                            CornerRadius="4" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="背景" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="背景色" />
                                        <ComboBox x:Name="BackgroundColorComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="BackgroundColorComboBox_SelectionChanged">
                                            <ComboBoxItem Content="White" Tag="#FFFFFF" />
                                            <ComboBoxItem Content="Off-white" Tag="#F8FAFC" />
                                            <ComboBoxItem Content="Light gray" Tag="#E2E8F0" />
                                            <ComboBoxItem Content="Black" Tag="#0F172A" />
                                            <ComboBoxItem Content="Custom" Tag="Custom" />
                                        </ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BackgroundColorHexTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="#FFFFFF"
                                                     ToolTip="カラーコード (#RRGGBB)"
                                                     TextChanged="BackgroundColorHexTextBox_TextChanged" />
                                            <Border x:Name="BackgroundColorPreviewBorder"
                                                    Grid.Column="2"
                                                    Height="28"
                                                    Background="#FFFFFF"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="線スタイル" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の線色" />
                                        <ComboBox x:Name="LineColorComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="LineColorComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Auto (パレット)" Tag="Auto" />
                                            <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                            <ComboBoxItem Content="Red" Tag="#DC2626" />
                                            <ComboBoxItem Content="Green" Tag="#16A34A" />
                                            <ComboBoxItem Content="Black" Tag="#0F172A" />
                                            <ComboBoxItem Content="Custom" Tag="Custom" />
                                        </ComboBox>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="LineColorHexTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="Auto"
                                                     ToolTip="Auto またはカラーコード (#RRGGBB)"
                                                     TextChanged="LineColorHexTextBox_TextChanged" />
                                            <Border x:Name="LineColorPreviewBorder"
                                                    Grid.Column="2"
                                                    Height="28"
                                                    Background="#2563EB"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="線幅" />
                                                <TextBox x:Name="LineWidthTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         Text="1.5"
                                                         TextChanged="FormatTextBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="マーカー" />
                                                <TextBox x:Name="MarkerSizeTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         Text="0"
                                                         TextChanged="FormatTextBox_TextChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="アスペクト比" />
                                <ComboBox x:Name="AspectRatioComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="FormatComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="3:2" Tag="3:2" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Section: Legend -->
                    <Border Style="{StaticResource SectionStyle}">
                        <Expander Header="凡例" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="表示" />
                                <ComboBox x:Name="LegendVisibilityComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectionChanged="FormatComboBox_SelectionChanged"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Content="自動 (2件以上で表示)" Tag="Auto" IsSelected="True" />
                                    <ComboBoxItem Content="常に表示" Tag="Always" />
                                    <ComboBoxItem Content="非表示" Tag="Never" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="位置" />
                                <ComboBox x:Name="LegendPositionComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectionChanged="FormatComboBox_SelectionChanged">
                                    <ComboBoxItem Content="右上" Tag="UpperRight" IsSelected="True" />
                                    <ComboBoxItem Content="左上" Tag="UpperLeft" />
                                    <ComboBoxItem Content="右下" Tag="LowerRight" />
                                    <ComboBoxItem Content="左下" Tag="LowerLeft" />
                                    <ComboBoxItem Content="右中央" Tag="MiddleRight" />
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Section: Startup defaults -->
                    <Border Style="{StaticResource SectionStyle}">
                        <Expander Header="起動時の既定値" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の分布" />
                                <ComboBox x:Name="DefaultDistributionComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectionChanged="FormatComboBox_SelectionChanged"
                                          Margin="0,0,0,8">
                                    <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                    <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                    <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の Run (0 始まり)" />
                                <TextBox x:Name="DefaultRunIndexTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Text="0"
                                         TextChanged="FormatTextBox_TextChanged" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Plot area -->
        <Border Grid.Column="1"
                Margin="12"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid x:Name="PlotHost">
                    <TextBlock x:Name="PlotPlaceholderTextBlock"
                               Text="グラフを初期化しています..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B" />
                </Grid>
                <Border Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        x:Name="ErrorBanner"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorBannerText" Foreground="#7F1D1D" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
