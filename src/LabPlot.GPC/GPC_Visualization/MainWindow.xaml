<Window x:Class="GPC_Visualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LabPlot.Core.Wpf.Controls;assembly=LabPlot.Core.Wpf"
        mc:Ignorable="d"
        Title="GPC Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,22,20,10">
                    <TextBlock Text="GPC Analyzer"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Chromatogram visualizer"
                               FontSize="11"
                               Foreground="#64748B" />
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,10,20,12">

                        <TextBlock Text="データ"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="データファイル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCsvButton"
                                        Content="CSV / TXT を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        ToolTip="CSV / TXT データを開く (Ctrl+O)"
                                        Click="OpenCsvButton_Click" />
                                <CheckBox x:Name="OverlayCheckBox"
                                          Content="重ね描き (Overlay)"
                                          ToolTip="複数データセットの重ね描き表示を切替 (Ctrl+L)"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed" />
                                <TextBlock x:Name="FilePathTextBlock"
                                           Text=""
                                           Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="読み込み済みデータセット" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#F8FAFC">
                                    <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="DatasetListBox_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="DatasetListBox_PreviewMouseMove"
                                                 DragOver="DatasetListBox_DragOver"
                                                 DragLeave="DatasetListBox_DragLeave"
                                                 Drop="DatasetListBox_Drop"
                                                 SelectionChanged="DatasetListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Cursor" Value="SizeAll" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding FullPath}"
                                                                   ToolTipService.ShowDuration="30000"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="×"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                Click="RemoveDatasetButton_Click"
                                                                ToolTip="削除" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DatasetListPlaceholder"
                                                   Text="データ未読み込み"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active dataset) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="線スタイル"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A" />
                                    <TextBlock x:Name="ActiveDatasetLabel"
                                               Text="(選択中データセット)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="色"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <controls:ColorPickerPanel x:Name="LineColorPicker"
                                                            AllowAuto="True"
                                                            DefaultHex="#2563EB"
                                                            Margin="0,0,0,10"
                                                            ColorChanged="LineColorPicker_ColorChanged">
                                    <ComboBoxItem Tag="Auto" IsSelected="True">
                                        <TextBlock Text="Auto" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">
                                        <TextBlock Text="Custom" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#2563EB">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#DC2626">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#16A34A">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EA580C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Orange" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#7C3AED">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#0891B2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Cyan" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#BE123C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#4B5563">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Gray" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </controls:ColorPickerPanel>

                                <TextBlock Text="凡例名"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="LegendNameTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,10"
                                         ToolTip="凡例名を編集（F2 でフォーカス）"
                                         TextChanged="LegendNameTextBox_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LineWidthTextBox"
                                                 Text="1.5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="LineWidthTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="マーカー"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MarkerSizeTextBox"
                                                 Text="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="MarkerSizeTextBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="分子量"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: Calibration & MW -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="較正曲線と分子量" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCalibrationButton"
                                        Content="較正曲線 JSON を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        Click="OpenCalibrationButton_Click" />
                                <TextBlock x:Name="CalibrationPathTextBlock"
                                           Text="較正曲線: 未選択"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#475569"
                                           ToolTipService.ShowDuration="30000"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="溶媒"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SolventComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,8"
                                          ToolTip="溶媒を次の項目へ切替 (Ctrl+1)"
                                          SelectionChanged="SolventComboBox_SelectionChanged" />

                                <TextBlock Text="検出器"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="DetectorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,12"
                                          ToolTip="検出器を次の項目へ切替 (Ctrl+2)"
                                          SelectionChanged="DetectorComboBox_SelectionChanged" />

                                <CheckBox x:Name="MolecularWeightCheckBox"
                                          Content="分子量表示"
                                          IsEnabled="False"
                                          Margin="0,0,0,10"
                                          ToolTip="横軸の分子量 / 保持時間表示を切替 (Ctrl+3)"
                                          Checked="MolecularWeightCheckBox_Changed"
                                          Unchecked="MolecularWeightCheckBox_Changed" />

                                <TextBlock Text="Y軸モード"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="MolecularWeightYModeComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          SelectedIndex="0"
                                          ToolTip="Y軸モードを次の項目へ切替 (Ctrl+4)"
                                          SelectionChanged="MolecularWeightYModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Signal" Tag="Signal" />
                                    <ComboBoxItem Content="dw/dlogM" Tag="DwdLogM" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="書式"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="軸範囲" IsExpanded="True">
                                <controls:AxisRangePanel x:Name="AxisRangePanel"
                                                         Margin="0,8,0,0"
                                                         XAxisLabel="X"
                                                         YAxisLabel="Y"
                                                         NumberFormat="G6"
                                                         AxisRangeCommitted="AxisRangePanel_Committed" />
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフラベル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="タイトル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TitleTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="TitleVisibleCheckBox"
                                              Grid.Column="0"
                                              Content="表示する"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="TitleBoldCheckBox"
                                              Grid.Column="2"
                                              Content="太字"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                </Grid>

                                <TextBlock Text="X軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="XLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="Y軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <CheckBox x:Name="AxisLabelBoldCheckBox"
                                          Content="軸ラベルを太字"
                                          Margin="0,0,0,0"
                                          Checked="GraphAppearanceCheckBox_Changed"
                                          Unchecked="GraphAppearanceCheckBox_Changed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフ書式" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <Expander Header="フォント" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="フォント名"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="GraphFontComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              IsEditable="True"
                                              SelectedIndex="0"
                                              Margin="0,0,0,10"
                                              SelectionChanged="GraphAppearanceComboBox_SelectionChanged"
                                              Loaded="GraphFontComboBox_Loaded">
                                        <ComboBoxItem Content="Auto" Tag="Auto" />
                                        <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                                        <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                                        <ComboBoxItem Content="Arial" Tag="Arial" />
                                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                        <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                                    </ComboBox>

                                    <TextBlock Text="フォントサイズ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="GraphFontSizeTextBox"
                                             Text="12"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="目盛" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="YAxisTickLabelsCheckBox"
                                              Content="Y軸の数字を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,6"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="MajorTicksCheckBox"
                                              Content="主目盛を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,6"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="MinorTicksCheckBox"
                                              Content="補助目盛を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,0"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="枠とグリッド" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="PlotGridCheckBox"
                                                  Grid.Column="0"
                                                  Content="グリッドを表示"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  ToolTip="グリッド線の表示を切替 (Ctrl+G)"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                        <CheckBox x:Name="PlotFrameCheckBox"
                                                  Grid.Column="2"
                                                  Content="プロット枠を表示"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="枠線幅"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="PlotFrameWidthTextBox"
                                                     Text="1"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="枠色"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <controls:ColorPickerPanel x:Name="PlotFrameColorPicker"
                                                                        AllowAuto="False"
                                                                        DefaultHex="#475569"
                                                                        ColorChanged="GraphFormatColor_ColorChanged">
                                                <ComboBoxItem Content="Gray" Tag="#475569" IsSelected="True" />
                                                <ComboBoxItem Content="Black" Tag="#0F172A" />
                                                <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                                <ComboBoxItem Content="Red" Tag="#DC2626" />
                                                <ComboBoxItem Content="Green" Tag="#16A34A" />
                                                <ComboBoxItem Content="Custom" Tag="Custom" />
                                            </controls:ColorPickerPanel>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="背景" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="背景色"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <controls:ColorPickerPanel x:Name="BackgroundColorPicker"
                                                                AllowAuto="False"
                                                                DefaultHex="#FFFFFF"
                                                                ColorChanged="GraphFormatColor_ColorChanged">
                                        <ComboBoxItem Content="White" Tag="#FFFFFF" IsSelected="True" />
                                        <ComboBoxItem Content="Off-white" Tag="#F8FAFC" />
                                        <ComboBoxItem Content="Light gray" Tag="#E2E8F0" />
                                        <ComboBoxItem Content="Black" Tag="#0F172A" />
                                        <ComboBoxItem Content="Custom" Tag="Custom" />
                                    </controls:ColorPickerPanel>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="アスペクト比"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="AspectRatioComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="AspectRatioComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="3:2" Tag="3:2" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Analysis session -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="解析条件" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="SaveSessionButton"
                                            Content="解析条件を保存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Margin="0,0,0,8"
                                            ToolTip="解析条件を .gpcjson に保存 (Ctrl+Shift+S)"
                                            Click="SaveSessionButton_Click" />
                                    <Button x:Name="LoadSessionButton"
                                            Content="解析条件を読込"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="解析条件 (.gpcjson) を読み込み (Ctrl+Shift+O)"
                                            Click="LoadSessionButton_Click" />
                                    <TextBlock Text="今開いている解析の状態（データ・較正曲線・線スタイル・軸範囲・グラフ書式）を任意の場所に .gpcjson として保存します。後でこのファイルを読み込めば、同じ解析をそのまま復元できます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: App preferences -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="環境設定" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="既定の較正曲線"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultCalibrationPathTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 ToolTip="次回起動時に自動で読み込む較正曲線 JSON のパス" />
                                        <Button Grid.Column="2"
                                                Content="参照"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseDefaultCalibrationButton_Click" />
                                    </Grid>

                                    <TextBlock Text="既定の出力フォルダ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultOutputDirectoryTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 ToolTip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                        <Button Grid.Column="2"
                                                Content="参照"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseDefaultOutputDirectoryButton_Click" />
                                    </Grid>

                                    <TextBlock Text="ここで設定した既定パスは、画面下部の「既定値として保存」を押すとグラフ書式と一緒にユーザー設定として保存され、次回起動時に較正曲線が自動で読み込まれます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,14">
                    <StackPanel>
                        <TextBlock Text="既定値（次回起動時の初期状態）"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResetGraphSettingsButton"
                                    Grid.Column="0"
                                    Content="既定値に戻す"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                    Click="ResetGraphSettingsButton_Click" />
                            <Button x:Name="SaveDefaultFormattingButton"
                                    Grid.Column="2"
                                    Content="既定値として保存"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                    Click="SaveDefaultFormattingButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        ToolTip="グラフを PNG / SVG で保存 (Ctrl+S)"
                        Click="SaveGraphButton_Click" />
                <Button x:Name="ExportDataButton"
                        DockPanel.Dock="Right"
                        Content="データ出力"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip="データを CSV / xlsx で出力 (Ctrl+E)"
                        Click="ExportDataButton_Click" />
                <TextBlock Text="Chromatogram"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid>
                    <!-- ScottPlot コントロールはここに動的に挿入される。InitializePlotControl で
                         Children.Clear() するため、操作ヒントバッジは PlotHost の外側に置く。 -->
                    <Grid x:Name="PlotHost">
                        <TextBlock x:Name="PlotPlaceholderTextBlock"
                                   Text="グラフを初期化しています..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B" />
                    </Grid>
                    <Border x:Name="PlotControlsHintBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Width="22" Height="22"
                            CornerRadius="11"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000"
                            ToolTipService.Placement="Bottom">
                        <Border.ToolTip>
                            <ToolTip Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="プロット操作"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                    <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                    <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                    <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                    <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="i"
                                   FontFamily="Segoe UI, Yu Gothic UI, sans-serif"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontStyle="Italic"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="StatisticsTextBlock"
                               Text="Mn: -   Mw: -   &#x00D0;: -"
                               Foreground="#0F172A"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                x:Name="RepresentativePeakPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="代表ピーク："
                                   VerticalAlignment="Center"
                                   Foreground="#475569"
                                   Margin="0,0,8,0" />
                        <ComboBox x:Name="RepresentativePeakComboBox"
                                  MinWidth="160"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectionChanged="RepresentativePeakComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <StatusBar Grid.Row="3" Margin="0,10,0,0" Background="Transparent">
                <TextBlock x:Name="StatusTextBlock"
                           Text="CSVまたはLabSolutions TXTを開いてください。"
                           Foreground="#475569" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
