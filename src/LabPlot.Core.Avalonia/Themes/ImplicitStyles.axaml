<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="using:Avalonia.Input">

    <!-- ============================================================
         Phase 7 Batch 1b: 暗黙 (key 無し) Style 群。
         Window.Styles の <StyleInclude /> で取り込んで使う。CommonStyles.axaml
         のリソース (Brush) に依存するので、合わせて Window.Resources にも
         CommonStyles.axaml を merge する必要あり。

         WPF 版 (LabPlot.Core.Wpf/Themes/CommonStyles.xaml) で <Style x:Key 無し>
         として定義していた ComboBoxItem / CheckBox / Expander / ScrollBar /
         ToolTip の Style に対応する。Batch 1b ではアニメ抜きの状態切替
         のみ。Batch 1c でアニメ追加 + ControlTemplate のフルカスタムへ
         必要に応じて格上げ。
         ============================================================ -->

    <!-- ============================================================
         Phase 7 Batch 6 step 3: フォント線幅を WPF 同等に強化
         step 2 で SubpixelAntialias を当てたが、鷹栖くん実機確認では
         「線幅自体が細い / アンチエイリアスが効いていない」体感。
         Yu Gothic UI / Segoe UI の Regular ウェイトはそもそも細めで、
         Avalonia の SkiaSharp 描画では特に薄く見える。WPF 版が体感的に
         濃く見えるのは Frame 上の TextElement.FontWeight が
         FluentTheme より少し太めの値（実質 Medium 相当）に揃って描かれて
         いるため。Window セレクタで FontWeight=Medium をセットして
         全 Window 配下の文字を Normal(400) → Medium(500) に底上げする。
         FontWeight は継承プロパティなので子 Visual に伝播するが、
         明示的に SemiBold/Bold が指定されているヘッダ系には影響しない。
         ============================================================ -->
    <Style Selector="Window">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ============================================================
         Phase 7 Batch 6 step 2: D&D 受け取りを ListBoxItem まで通す
         DragDrop.AllowDrop は Avalonia では非継承の attached property のため、
         Window や ListBox に True を立てても ListBoxItem 子要素では False のまま。
         OS ドロップは hit-test の最深要素で受けるので、AllowDrop=False の要素が
         drop イベントを吸収して bubble させない（Phase 7 Batch 6 残課題 (a)）。
         ListBoxItem 全件に AllowDrop=True を立てておくと、その上にいる Border /
         TextBlock / Path 等の子要素も実体としては ListBoxItem 範囲なので、
         ListBoxItem 自身がドロップ対象として受け取り、bubble で ListBox / Window
         のハンドラに伝播する。

         RenderOptions.TextRenderingMode は Avalonia 11.3 で struct 化されており
         個別 attached property としては XAML から Style Setter で書けない。
         WPF 版の TextRenderingMode=ClearType 相当はコードビハインドで
         RenderOptions.SetTextRenderingMode(window, SubpixelAntialias) を呼ぶ
         (PortalWindow / 各 MainWindow ctor) 形に統一する。
         ============================================================ -->
    <Style Selector="ListBoxItem">
        <Setter Property="(input:DragDrop.AllowDrop)" Value="True" />
    </Style>

    <!-- ComboBoxItem — 角丸 4 / hover で薄い grey、選択で薄い blue。 -->
    <Style Selector="ComboBoxItem">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#DBEAFE" />
    </Style>
    <Style Selector="ComboBoxItem:disabled">
        <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- CheckBox / Expander の Style と Animation は Batch 1f で
         CommonStyles.axaml の暗黙 ControlTheme (`x:Key="{x:Type CheckBox}"` /
         `x:Key="{x:Type Expander}"`) に Template ごと統合した。Batch 1e で
         ImplicitStyles に置いた Expander の fade-in Animation も ControlTheme
         内の Animation Style にまとめて移管済み。 -->

    <!-- ScrollBar — 細身グレー、hover で濃く。 -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource BorderDefaultBrush}" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{StaticResource BorderHoverBrush}" />
    </Style>

    <!-- ToolTip — Batch 1e で CommonStyles.axaml の ControlTheme
         (`x:Key="{x:Type ToolTip}"`) に Template ごと移管した。BoxShadow と
         CornerRadius は ControlTemplate 内の Border に直接乗せたので、
         ここでは追加の Setter は不要。 -->


</Styles>
