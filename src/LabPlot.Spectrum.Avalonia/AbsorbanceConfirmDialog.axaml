<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LabPlot.Spectrum.Avalonia.AbsorbanceConfirmDialog"
        Title="Y 軸を Absorbance に切り替えますか？"
        SizeToContent="Height"
        Width="440"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True">
    <!-- Phase 7 ブラッシュアップ B6: ローカル DialogPrimaryButton /
         DialogSecondaryButton ControlTheme は CommonStyles.axaml の
         PrimaryButtonStyle / SecondaryButtonStyle と意味的に同じだったので
         撤廃。Application.Resources 経由でグローバルに参照できる Theme に
         置き換え、テーマ調整がローカル定義の更新漏れで同期しなくなる
         リスクを排除した。MinWidth=84 は元の Dialog 固有の dimension なので
         呼び出し側 (Button) で個別に保持する。 -->
    <Border Margin="16"
            Background="White"
            CornerRadius="10"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            BoxShadow="0 2 20 0 #2E0F172A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with icon -->
            <Grid Grid.Row="0" Margin="24,22,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="18"
                        Background="#DBEAFE"
                        VerticalAlignment="Top">
                    <TextBlock Text="?"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="Y 軸を Absorbance に切り替えますか？"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#0F172A"
                               TextWrapping="Wrap" />
                    <TextBlock Text="積分は Absorbance 表示で行うのが一般的です。Absorbance に切り替えると Beer-Lambert 則に基づいた解釈ができます。"
                               Margin="0,8,0,0"
                               FontSize="12.5"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </StackPanel>
            </Grid>

            <!-- Spacer -->
            <Border Grid.Row="1" Height="20" />

            <!-- Action bar -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="キャンセル"
                            Theme="{DynamicResource SecondaryButtonStyle}"
                            MinWidth="84"
                            Height="36"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                    <Button x:Name="NoButton"
                            Grid.Column="2"
                            Content="そのまま追加"
                            Theme="{DynamicResource SecondaryButtonStyle}"
                            MinWidth="84"
                            Height="36"
                            Click="NoButton_Click" />
                    <Button x:Name="YesButton"
                            Grid.Column="4"
                            Content="切り替えて追加"
                            Theme="{DynamicResource PrimaryButtonStyle}"
                            MinWidth="84"
                            IsDefault="True"
                            Click="YesButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
