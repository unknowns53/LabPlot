<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 7 Batch 5: WPF 版 LabPlot.Spectrum/Spectrum_Visualization に対応する Avalonia 版モジュール。
       Library DLL として LabPlot.Shell.Avalonia から MainWindow を起動する。
       共通基盤は LabPlot.Core.Avalonia が、解析ロジックは SpectrumAnalyzer.Core が
       それぞれ担う（Phase 6 と同じ層分離）。ScottPlot.Avalonia 5.1.58 で WPF 版
       (ScottPlot.WPF) と同じ API surface を保つ。CalibrationCurveWindow が
       DataGrid を使うため、Avalonia.Controls.DataGrid を追加で参照する。 -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LabPlot.Spectrum.Avalonia</RootNamespace>
    <AssemblyName>LabPlot.Spectrum.Avalonia</AssemblyName>
    <Version>1.4.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabPlot.Core\LabPlot.Core.csproj" />
    <ProjectReference Include="..\LabPlot.Core.Avalonia\LabPlot.Core.Avalonia.csproj" />
    <ProjectReference Include="..\LabPlot.Spectrum\SpectrumAnalyzer.Core\SpectrumAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <!-- Avalonia.Controls.DataGrid は 11.3.13 が最新公開バージョン (11.3.14 は未公開)。
         Avalonia 11.3.14 と互換 (11.3.13 が要求するのは Avalonia >= 11.3.13)。 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.58" />
  </ItemGroup>

</Project>
