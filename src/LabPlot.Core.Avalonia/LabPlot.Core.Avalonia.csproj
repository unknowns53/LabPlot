<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF 版 (LabPlot.Core.Wpf) と並行する Avalonia 版の共通基盤。
         WPF が net10.0-windows10.0.19041 だったのに対し、こちらは net10.0 で OS 中立。
         Phase 7 全体で WPF 版を v1.0.x の完成形として feature freeze し、新機能は
         こちらに集約していく。 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LabPlot.Core.Avalonia</RootNamespace>
    <AssemblyName>LabPlot.Core.Avalonia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabPlot.Core\LabPlot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.58" />
  </ItemGroup>

  <!-- v1.2.1: アプリアイコン (PNG) を共通アセットとして埋め込む。Shell / DLS / GPC /
       Spectrum すべての Window から avares://LabPlot.Core.Avalonia/Assets/app-icon.png
       で参照する。Shell から各モジュールへの ProjectReference は循環するため、
       共通基盤の Core.Avalonia 側に置くのが配置として正解。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
