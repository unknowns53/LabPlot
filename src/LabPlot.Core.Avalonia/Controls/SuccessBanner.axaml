<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabPlot.Core.Avalonia.Controls.SuccessBanner"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,12,0,0"
             IsVisible="False">
    <Border Background="#ECFDF5"
            BorderBrush="#A7F3D0"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
        <StackPanel Orientation="Horizontal">
            <Path Width="14" Height="14"
                  Stroke="#065F46"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="None"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Data="M 2,7 L 6,11 L 12,3" />
            <TextBlock Name="MessageTextBlock"
                       Foreground="#065F46"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
