<Window x:Class="GPC_Visualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GPC Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="4,10,0,8" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="SelectionBrush" Value="#BFDBFE" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          Background="Transparent"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Style="{x:Null}"
                                             Visibility="Collapsed"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Left"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Focusable="True" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          HorizontalAlignment="Right"
                                          Width="32"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="6">
                                            <Path x:Name="Arrow"
                                                  Width="10" Height="6"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stretch="None"
                                                  Stroke="#64748B"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Data="M 0,0 L 5,5 L 10,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,8"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2"
                                                          BlurRadius="14"
                                                          Opacity="0.18"
                                                          Color="#0F172A" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="CheckMark"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Data="M 3,8 L 7,12 L 13,4" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1D4ED8" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#CBD5E1" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ShadowLayer"
                                    CornerRadius="6"
                                    Background="#1E3A8A"
                                    Opacity="0.18"
                                    Margin="0,2,0,-2" />
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="8"
                                    BorderBrush="#60A5FA"
                                    BorderThickness="2"
                                    Margin="-2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.28" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E3A8A" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.10" />
                                <Setter TargetName="ShadowLayer" Property="Margin" Value="0,1,0,-1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="8"
                                    BorderBrush="#60A5FA"
                                    BorderThickness="2"
                                    Margin="-2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FEE2E2" />
                                <Setter Property="Foreground" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FECACA" />
                                <Setter Property="Foreground" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,22,20,10">
                    <TextBlock Text="GPC Analyzer"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Chromatogram visualizer"
                               FontSize="11"
                               Foreground="#64748B" />
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,10,20,12">

                        <TextBlock Text="データ"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="データファイル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCsvButton"
                                        Content="CSV / TXT を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        Click="OpenCsvButton_Click" />
                                <CheckBox x:Name="OverlayCheckBox"
                                          Content="重ね描き (Overlay)"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed" />
                                <TextBlock x:Name="FilePathTextBlock"
                                           Text=""
                                           Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="読み込み済みデータセット" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#F8FAFC">
                                    <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="DatasetListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding FullPath}"
                                                                   ToolTipService.ShowDuration="30000"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="×"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                Click="RemoveDatasetButton_Click"
                                                                ToolTip="削除" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DatasetListPlaceholder"
                                                   Text="データ未読み込み"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="書式"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="軸範囲" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="X Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Y Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="AutoAxisRangeButton"
                                        Content="自動範囲に戻す"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Click="AutoAxisRangeButton_Click"
                                        ToolTip="X/Y の最小・最大値を空欄に戻して自動範囲で表示します" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフラベル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="タイトル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TitleTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="X軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="XLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="Y軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフ書式" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="フォント"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="GraphFontComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="True"
                                          SelectedIndex="0"
                                          Margin="0,0,0,10"
                                          SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                                    <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                                    <ComboBoxItem Content="Arial" Tag="Arial" />
                                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                    <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="フォントサイズ"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="GraphFontSizeTextBox"
                                                 Text="12"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="グリッド"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="PlotGridCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Margin="0,6,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="縦軸の数字"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="YAxisTickLabelsCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  Margin="0,3,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="プロット枠"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="PlotFrameCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  Margin="0,3,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="枠線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="PlotFrameWidthTextBox"
                                                 Text="1"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="枠色"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="PlotFrameColorComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Gray" Tag="#475569" />
                                            <ComboBoxItem Content="Black" Tag="#0F172A" />
                                            <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                            <ComboBoxItem Content="Red" Tag="#DC2626" />
                                            <ComboBoxItem Content="Green" Tag="#16A34A" />
                                            <ComboBoxItem Content="Custom" Tag="Custom" />
                                        </ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PlotFrameColorHexTextBox"
                                                     Grid.Column="0"
                                                     Text="#475569"
                                                     ToolTip="カラーコード (#RRGGBB)"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="PlotFrameColorHexTextBox_TextChanged" />
                                            <Border x:Name="PlotFrameColorPreviewBorder"
                                                    Grid.Column="2"
                                                    Height="28"
                                                    Background="#475569"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="アスペクト比"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="AspectRatioComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="AspectRatioComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="3:2" Tag="3:2" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active dataset) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="線スタイル"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A" />
                                    <TextBlock x:Name="ActiveDatasetLabel"
                                               Text="(選択中データセット)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="色"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="LineColorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          Margin="0,0,0,6"
                                          SelectionChanged="LineColorComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Auto">
                                        <TextBlock Text="Auto" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">
                                        <TextBlock Text="Custom" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#2563EB">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#DC2626">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#16A34A">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EA580C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Orange" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#7C3AED">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#0891B2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Cyan" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#BE123C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#4B5563">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Gray" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LineColorHexTextBox"
                                             Grid.Column="0"
                                             Text="Auto"
                                             ToolTip="Auto またはカラーコード (#RRGGBB)"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="LineColorHexTextBox_TextChanged" />
                                    <Border x:Name="LineColorPreviewBorder"
                                            Grid.Column="2"
                                            Height="28"
                                            Background="#2563EB"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                </Grid>

                                <TextBlock Text="凡例名"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="LegendNameTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,10"
                                         TextChanged="LegendNameTextBox_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LineWidthTextBox"
                                                 Text="1.5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="LineWidthTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="マーカー"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MarkerSizeTextBox"
                                                 Text="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="MarkerSizeTextBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="分子量"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: Calibration & MW -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="較正曲線と分子量" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCalibrationButton"
                                        Content="較正曲線 JSON を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        Click="OpenCalibrationButton_Click" />
                                <TextBlock x:Name="CalibrationPathTextBlock"
                                           Text="較正曲線: 未選択"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#475569"
                                           ToolTipService.ShowDuration="30000"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="溶媒"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SolventComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,8"
                                          SelectionChanged="SolventComboBox_SelectionChanged" />

                                <TextBlock Text="検出器"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="DetectorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,12"
                                          SelectionChanged="DetectorComboBox_SelectionChanged" />

                                <CheckBox x:Name="MolecularWeightCheckBox"
                                          Content="分子量表示"
                                          IsEnabled="False"
                                          Margin="0,0,0,10"
                                          Checked="MolecularWeightCheckBox_Changed"
                                          Unchecked="MolecularWeightCheckBox_Changed" />

                                <TextBlock Text="Y軸モード"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="MolecularWeightYModeComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          SelectedIndex="0"
                                          SelectionChanged="MolecularWeightYModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Signal" Tag="Signal" />
                                    <ComboBoxItem Content="dw/dlogM" Tag="DwdLogM" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ResetGraphSettingsButton"
                                Grid.Column="0"
                                Content="既定に戻す"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ResetGraphSettingsButton_Click" />
                        <Button x:Name="SaveDefaultFormattingButton"
                                Grid.Column="2"
                                Content="既定保存"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveDefaultFormattingButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="SaveGraphButton_Click" />
                <TextBlock Text="Chromatogram"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid x:Name="PlotHost">
                    <TextBlock x:Name="PlotPlaceholderTextBlock"
                               Text="グラフを初期化しています..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,16,0,0">
                <TextBlock x:Name="StatisticsTextBlock"
                           Text="Mn: -   Mw: -   PDI: -"
                           Foreground="#0F172A"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <StatusBar Grid.Row="3" Margin="0,10,0,0" Background="Transparent">
                <TextBlock x:Name="StatusTextBlock"
                           Text="CSVまたはLabSolutions TXTを開いてください。"
                           Foreground="#475569" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
