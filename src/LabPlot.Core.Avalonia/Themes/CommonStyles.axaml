<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Phase 7 Core.Avalonia の共通 ControlTheme・リソース。
         WPF 版 (LabPlot.Core.Wpf/Themes/CommonStyles.xaml) と同じ
         デザイン言語を Avalonia で表現する。

         Batch 1a (commit 289b83a): 共通カラー / Geometry / 単純 ControlTheme
           (SectionStyle, SectionHeaderStyle, GroupLabelStyle, FieldLabelStyle)
         Batch 1b (commit aee3659): SectionIconPath / GroupHeaderStyle / Input
           系 ControlTheme (TextBox / ComboBox) / Button 3 種。Fluent テーマを
           BasedOn して Setter override で書き、ScrollBar / CheckBox / Expander
           は ImplicitStyles.axaml に分離。Storyboard 起源のアニメ
           (Chevron 回転 / CheckMark slide-in / Expander slide+fade) は
           Batch 1c 以降に持ち越し。
         Batch 1c (this commit): CustomTitleBar / AxisRangePanel の 2 UserControl
           移植 + Chrome 系リソース (ChromeMinimize/Maximize/Restore/CloseIcon
           StreamGeometry + ChromeButtonStyle / ChromeCloseButtonStyle ControlTheme +
           WindowChromeRootBorderStyle)。WPF の System.Windows.Shell.WindowChrome は
           Avalonia の ExtendClientAreaToDecorationsHint=True で代替するため
           IsHitTestVisibleInChrome は不要。Maximized 時の 7 px 補正も Avalonia
           では Window 側 OffScreenMargin で吸収されるが、見た目を WPF と揃えるため
           DataTrigger 風の Style Selector で Margin を切り替える。
         Batch 1d 以降: ColorPickerPanel / GraphFormatPanel + アニメ系。
         ============================================================ -->

    <!-- 共通アイコン Geometry。3 アプリ横断で同じ意味の Expander には同じグリフを当てる。
         WPF 版は <Geometry> リテラルだったが Avalonia は <StreamGeometry> を要求する。 -->
    <StreamGeometry x:Key="DataFileIconGeometry">M 3,1 L 9,1 L 12,4 L 12,13 L 3,13 Z M 9,1 L 9,4 L 12,4</StreamGeometry>
    <StreamGeometry x:Key="DatasetListIconGeometry">M 2,3 L 12,3 M 2,7 L 12,7 M 2,11 L 12,11</StreamGeometry>
    <StreamGeometry x:Key="LineStyleIconGeometry">M 2,12 L 10,4 L 12,6 L 4,14 Z</StreamGeometry>
    <StreamGeometry x:Key="AxisRangeIconGeometry">M 1,1 L 13,1 L 13,13 L 1,13 Z M 7,1 L 7,13 M 1,7 L 13,7</StreamGeometry>
    <StreamGeometry x:Key="GraphLabelIconGeometry">M 2,7 L 7,2 L 13,2 L 13,8 L 8,13 L 2,7 Z</StreamGeometry>
    <StreamGeometry x:Key="GraphFormatIconGeometry">M 9,1 L 13,5 L 6,12 L 2,8 Z M 6,12 L 4,14 L 1,11 L 3,9</StreamGeometry>
    <StreamGeometry x:Key="AnalysisConditionsIconGeometry">M 2,2 L 12,2 L 12,12 L 2,12 Z M 4,2 L 4,6 L 10,6 L 10,2 M 5,9 L 9,9</StreamGeometry>
    <StreamGeometry x:Key="PreferencesIconGeometry">M 7,1 L 7,3 M 7,11 L 7,13 M 1,7 L 3,7 M 11,7 L 13,7 M 3,3 L 4,4 M 10,10 L 11,11 M 11,3 L 10,4 M 3,11 L 4,10 M 5,5 L 9,5 L 9,9 L 5,9 Z</StreamGeometry>

    <!-- 状態フィードバック用パレット。Banner 系および将来のステータスチップで使う。 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#065F46" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#92400E" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FCD34D" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FCA5A5" />

    <!-- アクセント色。WPF 版では各 ControlTemplate に hard-coded だったが、Avalonia 移植に
         合わせて共通 Brush として括り出し、Batch 1b の InputComboBoxStyle / Button 系から
         参照できるようにする。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#BFDBFE" />

    <!-- 中間階調 / 罫線 / 文字色。slate-50 〜 slate-900 系で揃えている WPF 版と同じ値。 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ForegroundPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#475569" />
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#94A3B8" />

    <!-- セクション枠 (白カード + 角丸 8px + 薄影)。WPF 版は DropShadowEffect を Effect で
         指定していたが、Avalonia では Border の BoxShadow プロパティで等価な結果が得られる。
         BoxShadow 構文: "<offsetX> <offsetY> <blur> <spread> <color>"。WPF の
         DropShadowEffect (depth=1, dir=270, blur=6, opacity=0.05, color=#0F172A) を
         offsetX=0, offsetY=1, blur=6, alpha=0x0D (≈5%) で再現する。 -->
    <ControlTheme x:Key="SectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BoxShadow" Value="0 1 6 0 #0D0F172A" />
    </ControlTheme>

    <ControlTheme x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </ControlTheme>

    <ControlTheme x:Key="GroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="Margin" Value="4,10,0,8" />
    </ControlTheme>

    <ControlTheme x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </ControlTheme>

    <!-- ============================================================
         Section 見出しアイコン (Path)
         WPF 版は <DataTrigger Binding="{Binding IsMouseOver, AncestorType=Expander}">
         で親 Expander の hover を検出していたが、Avalonia の ControlTheme は
         単一コントロールの状態に閉じるので、外側コントロール (Expander) の
         hover を ControlTheme 内で拾えない。Batch 1b 段階ではデフォルトの
         slate-600 stroke のみ実装し、accent 色への切替は Batch 1c で
         ImplicitStyles.axaml 側に "Expander:pointerover Path.section-icon"
         セレクタを足して実現する (利用側で Path に Classes="section-icon"
         を付与する運用)。 ============================================================ -->
    <ControlTheme x:Key="SectionIconPath" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </ControlTheme>

    <!-- ============================================================
         GroupHeaderStyle — ContentControl ベースの大見出し + 下線。
         Content にテキストを置くと、SemiBold の小見出しと薄い下線
         divider が一塊で描画される。 ============================================================ -->
    <ControlTheme x:Key="GroupHeaderStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,12,0,8" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      Margin="2,0,0,6" />
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============================================================
         Input TextBox — 高さ 32 / 角丸 6 / フォーカス時にアクセント枠
         + 外周 FocusRing。Avalonia の TextBox は内部に PART_TextPresenter +
         PART_ScrollViewer を持つので、最小限の Template を自前で組む。 ============================================================ -->
    <ControlTheme x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentLightBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <DockPanel>
                            <ScrollViewer Name="PART_ScrollViewer"
                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="Center" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource AccentLightBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:focus /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Input ComboBox — 高さ 32 / 右端 32px に Path で描いた v 字矢印 /
         フォーカス時に accent 枠 + FocusRing。Avalonia の ComboBox は
         WPF と内部構造が違い (PART_Popup ベースで item 描画を Popup 内 ListBox
         が担う) ので、ControlTemplate を自前で書く。
         IsEditable=True 用の特別ハンドリング (ToggleButton と TextBox の重ね) は
         WPF 版の rendering 課題 (右端矢印が押せなくなる) を解決するための
         workaround だったが、Avalonia の ComboBox は IsEditable をネイティブ
         サポートしないので、編集可なドロップダウンが必要なら AutoCompleteBox
         に置き換える運用 (Batch 1c 以降で利用側を確認)。 ============================================================ -->
    <ControlTheme x:Key="InputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource ForegroundDisabledBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="*,32">
                            <ContentControl Name="ContentPresenter"
                                            Grid.Column="0"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}" />
                            <Path Grid.Column="1"
                                  Width="10" Height="6"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="None"
                                  Stroke="#64748B"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M 0,0 L 5,5 L 10,0" />
                        </Grid>
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource AccentLightBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding $parent[ComboBox].Bounds.Width}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="{TemplateBinding}"
                           Placement="BottomEdgeAlignedLeft">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,0,8"
                                BoxShadow="0 2 14 0 #2E0F172A">
                            <ScrollViewer Margin="4"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:dropdownopen /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Primary / Secondary / Icon Button。アクセント青、グレー、丸っこい
         アイコン (×) の 3 系統。WPF 版の Storyboard アニメは入れず、
         状態切替のみ実装。Phase 7 後半でブラッシュアップ。 ============================================================ -->
    <ControlTheme x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ShadowLayer"
                            CornerRadius="6"
                            Background="#1E3A8A"
                            Opacity="0.18"
                            Margin="0,2,0,-2" />
                    <Border Name="ButtonBorder"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="#60A5FA"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.10" />
            <Setter Property="Margin" Value="0,1,0,-1" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ButtonBorder"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="#60A5FA"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ButtonBorder"
                        CornerRadius="12"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#FECACA" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="#B91C1C" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource AccentDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- =========================================================
         Chrome (タイトルバー) 用リソース。Avalonia は WPF の
         System.Windows.Shell.WindowChrome の代わりに Window 側で
         ExtendClientAreaToDecorationsHint=True を立て、CustomTitleBar
         がアプリ上部に貼られて OS 標準の chrome を置き換える形になる。
         そのため IsHitTestVisibleInChrome 添付プロパティは不要。
         Geometry は WPF の <Geometry> 文字列リテラルが使えないので
         <StreamGeometry> に置換。ChromeMaximizeIcon と ChromeRestoreIcon は
         CustomTitleBar.axaml.cs の SyncMaxRestoreGlyph() が WindowState の
         変化に応じて入れ替える。
         ========================================================= -->

    <StreamGeometry x:Key="ChromeMinimizeIcon">M 0,5 L 10,5</StreamGeometry>
    <StreamGeometry x:Key="ChromeMaximizeIcon">M 0,0 L 10,0 L 10,10 L 0,10 Z</StreamGeometry>
    <StreamGeometry x:Key="ChromeRestoreIcon">M 2,0 L 10,0 L 10,8 L 8,8 M 0,2 L 8,2 L 8,10 L 0,10 Z</StreamGeometry>
    <StreamGeometry x:Key="ChromeCloseIcon">M 0,0 L 10,10 M 10,0 L 0,10</StreamGeometry>

    <!-- 最小化 / 最大化 / 復元用の Chrome ボタン。WPF は ControlTemplate.Triggers で
         IsMouseOver / IsPressed を切り替えていたが、Avalonia は Style Selector の
         ^:pointerover / ^:pressed を使う。
         Path.Data は TemplateBinding Tag で受けるので、CustomTitleBar 側で
         Button.Tag に StreamGeometry を割り当てる仕組みは WPF と同じ。 -->
    <ControlTheme x:Key="ChromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                    <Path Name="ButtonGlyph"
                          Data="{TemplateBinding Tag}"
                          Stroke="#475569"
                          StrokeThickness="1"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="None"
                          Width="10"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="#0F172A" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#CBD5E1" />
        </Style>
        <Style Selector="^:pressed /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="#0F172A" />
        </Style>
    </ControlTheme>

    <!-- 閉じるボタンだけは pointerover で赤系に染まるので別 ControlTheme。
         WPF と同じ #DC2626 / #B91C1C でグリフを白に反転する。 -->
    <ControlTheme x:Key="ChromeCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                    <Path Name="ButtonGlyph"
                          Data="{TemplateBinding Tag}"
                          Stroke="#475569"
                          StrokeThickness="1"
                          StrokeLineCap="Round"
                          Stretch="None"
                          Width="10"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#B91C1C" />
        </Style>
        <Style Selector="^:pressed /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </ControlTheme>

    <!-- WPF 版の WindowChromeRootBorderStyle と同じく、Maximized 時に
         7 px の Margin を入れて画面外への張り出しを補正する Border 用 ControlTheme。
         Avalonia は Window.OffScreenMargin で同じ補正が利く環境もあるが、
         WPF と完全に同じ見た目に揃えるため UI 側でも保険を掛ける。 -->
    <ControlTheme x:Key="WindowChromeRootBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F7F8FA" />
        <Setter Property="Margin" Value="0" />
        <Style Selector="^[Tag=Maximized]">
            <Setter Property="Margin" Value="7" />
        </Style>
    </ControlTheme>

    <!-- =========================================================
         ToolTip 用 ControlTheme（Batch 1b で持ち越したもの）。
         WPF 版は OverridesDefaultStyle=True + ControlTemplate で
         Border + DropShadowEffect を被せる手作り実装だったが、
         Avalonia は Border.BoxShadow が CSS と同じ syntax で 1 行
         書けるので、ContentControl 派生の ToolTip テンプレートに
         直接埋め込む。x:Key="{x:Type ToolTip}" で暗黙 ControlTheme
         として登録され、ImplicitStyles 側の Setter だけでは表現
         できなかった BoxShadow / CornerRadius を含めた見た目が
         Fluent デフォルトの上から差し替わる。
         WPF の DropShadowEffect ShadowDepth=2 / Direction=270 /
         BlurRadius=12 / Opacity=0.15 / Color=#0F172A は
         BoxShadow="0 2 12 0 #260F172A" に対応する (alpha 0x26 ≈ 15%)。
         ========================================================= -->
    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        BoxShadow="0 2 12 0 #260F172A"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
