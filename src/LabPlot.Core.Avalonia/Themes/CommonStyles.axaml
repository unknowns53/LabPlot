<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Phase 7 Core.Avalonia の共通 ControlTheme・リソース。
         WPF 版 (LabPlot.Core.Wpf/Themes/CommonStyles.xaml) と同じ
         デザイン言語を Avalonia で表現する。

         Batch 1a (commit 289b83a): 共通カラー / Geometry / 単純 ControlTheme
           (SectionStyle, SectionHeaderStyle, GroupLabelStyle, FieldLabelStyle)
         Batch 1b (commit aee3659): SectionIconPath / GroupHeaderStyle / Input
           系 ControlTheme (TextBox / ComboBox) / Button 3 種。Fluent テーマを
           BasedOn して Setter override で書き、ScrollBar / CheckBox / Expander
           は ImplicitStyles.axaml に分離。Storyboard 起源のアニメ
           (Chevron 回転 / CheckMark slide-in / Expander slide+fade) は
           Batch 1c 以降に持ち越し。
         Batch 1c (this commit): CustomTitleBar / AxisRangePanel の 2 UserControl
           移植 + Chrome 系リソース (ChromeMinimize/Maximize/Restore/CloseIcon
           StreamGeometry + ChromeButtonStyle / ChromeCloseButtonStyle ControlTheme +
           WindowChromeRootBorderStyle)。WPF の System.Windows.Shell.WindowChrome は
           Avalonia の ExtendClientAreaToDecorationsHint=True で代替するため
           IsHitTestVisibleInChrome は不要。Maximized 時の 7 px 補正も Avalonia
           では Window 側 OffScreenMargin で吸収されるが、見た目を WPF と揃えるため
           DataTrigger 風の Style Selector で Margin を切り替える。
         Batch 1d 以降: ColorPickerPanel / GraphFormatPanel + アニメ系。
         ============================================================ -->

    <!-- 共通アイコン Geometry。3 アプリ横断で同じ意味の Expander には同じグリフを当てる。
         WPF 版は <Geometry> リテラルだったが Avalonia は <StreamGeometry> を要求する。 -->
    <StreamGeometry x:Key="DataFileIconGeometry">M 3,1 L 9,1 L 12,4 L 12,13 L 3,13 Z M 9,1 L 9,4 L 12,4</StreamGeometry>
    <StreamGeometry x:Key="DatasetListIconGeometry">M 2,3 L 12,3 M 2,7 L 12,7 M 2,11 L 12,11</StreamGeometry>
    <StreamGeometry x:Key="LineStyleIconGeometry">M 2,12 L 10,4 L 12,6 L 4,14 Z</StreamGeometry>
    <StreamGeometry x:Key="AxisRangeIconGeometry">M 1,1 L 13,1 L 13,13 L 1,13 Z M 7,1 L 7,13 M 1,7 L 13,7</StreamGeometry>
    <StreamGeometry x:Key="GraphLabelIconGeometry">M 2,7 L 7,2 L 13,2 L 13,8 L 8,13 L 2,7 Z</StreamGeometry>
    <StreamGeometry x:Key="GraphFormatIconGeometry">M 9,1 L 13,5 L 6,12 L 2,8 Z M 6,12 L 4,14 L 1,11 L 3,9</StreamGeometry>
    <StreamGeometry x:Key="AnalysisConditionsIconGeometry">M 2,2 L 12,2 L 12,12 L 2,12 Z M 4,2 L 4,6 L 10,6 L 10,2 M 5,9 L 9,9</StreamGeometry>
    <StreamGeometry x:Key="PreferencesIconGeometry">M 7,1 L 7,3 M 7,11 L 7,13 M 1,7 L 3,7 M 11,7 L 13,7 M 3,3 L 4,4 M 10,10 L 11,11 M 11,3 L 10,4 M 3,11 L 4,10 M 5,5 L 9,5 L 9,9 L 5,9 Z</StreamGeometry>

    <!-- v1.3.5: 状態フィードバック / アクセント / 中間階調 / 罫線 / 文字色のトークンは
         CommonTokens.axaml に分離。App.axaml の MergedDictionaries で CommonTokens を
         最初に Include しているため、ここでの再定義は不要。`{StaticResource AccentBrush}`
         等の参照はそのまま CommonTokens 内の同名キーに解決される。 -->

    <!-- セクション枠 (白カード + 角丸 8px + 薄影)。WPF 版は DropShadowEffect を Effect で
         指定していたが、Avalonia では Border の BoxShadow プロパティで等価な結果が得られる。
         BoxShadow 構文: "<offsetX> <offsetY> <blur> <spread> <color>"。WPF の
         DropShadowEffect (depth=1, dir=270, blur=6, opacity=0.05, color=#0F172A) を
         offsetX=0, offsetY=1, blur=6, alpha=0x0D (≈5%) で再現する。 -->
    <ControlTheme x:Key="SectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BoxShadow" Value="0 1 6 0 #0D0F172A" />
    </ControlTheme>

    <ControlTheme x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </ControlTheme>

    <ControlTheme x:Key="GroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="Margin" Value="4,10,0,8" />
    </ControlTheme>

    <ControlTheme x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </ControlTheme>

    <!-- ============================================================
         Section 見出しアイコン (Path)
         WPF 版は <DataTrigger Binding="{Binding IsMouseOver, AncestorType=Expander}">
         で親 Expander の hover を検出していたが、Avalonia の ControlTheme は
         単一コントロールの状態に閉じるので、外側コントロール (Expander) の
         hover を ControlTheme 内で拾えない。Batch 1b 段階ではデフォルトの
         slate-600 stroke のみ実装し、accent 色への切替は Batch 1c で
         ImplicitStyles.axaml 側に "Expander:pointerover Path.section-icon"
         セレクタを足して実現する (利用側で Path に Classes="section-icon"
         を付与する運用)。 ============================================================ -->
    <ControlTheme x:Key="SectionIconPath" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </ControlTheme>

    <!-- ============================================================
         GroupHeaderStyle — ContentControl ベースの大見出し + 下線。
         Content にテキストを置くと、SemiBold の小見出しと薄い下線
         divider が一塊で描画される。 ============================================================ -->
    <ControlTheme x:Key="GroupHeaderStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,12,0,8" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      Margin="2,0,0,6" />
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ============================================================
         SidebarTabRadioButtonStyle — サイドバー上部のタブ切替
         (RadioButton 2 個によるセグメントコントロール)。Data Viewer
         (LabPlot.Viewer.Avalonia) 発の「データ / 仕上げ」タブ分割を
         GPC / Spectrum / DLS へ横展開するため Core.Avalonia へ抽出した
         共有 ControlTheme。App.axaml の MergedDictionaries でこの
         ResourceDictionary を取り込む各モジュールから
         `{DynamicResource SidebarTabRadioButtonStyle}` で参照できる。
         ============================================================ -->
    <ControlTheme x:Key="SidebarTabRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="SegmentBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="7"
                            BorderBrush="#2563EB"
                            BorderThickness="2"
                            Margin="-1"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- 選択中: 白背景 + 軽い影 + アクセント文字色。標準の点線
             FocusVisualStyle は使わず、フォーカス時のみ枠色で示す。 -->
        <Style Selector="^:checked /template/ Border#SegmentBorder">
            <Setter Property="Background" Value="White" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #260F172A" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>
        <Style Selector="^:not(:checked):pointerover">
            <Setter Property="Foreground" Value="#334155" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Input TextBox — 高さ 32 / 角丸 6 / フォーカス時にアクセント枠
         + 外周 FocusRing。Avalonia の TextBox は内部に PART_TextPresenter +
         PART_ScrollViewer を持つので、最小限の Template を自前で組む。 ============================================================ -->
    <ControlTheme x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentLightBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <DockPanel>
                            <ScrollViewer Name="PART_ScrollViewer"
                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               PasswordChar="{TemplateBinding PasswordChar}"
                                               RevealPassword="{TemplateBinding RevealPassword}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="Center" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource AccentLightBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:focus /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Input ComboBox — 高さ 32 / 右端 32px に Path で描いた v 字矢印 /
         フォーカス時に accent 枠 + FocusRing。Avalonia の ComboBox は
         WPF と内部構造が違い (PART_Popup ベースで item 描画を Popup 内 ListBox
         が担う) ので、ControlTemplate を自前で書く。
         IsEditable=True 用の特別ハンドリング (ToggleButton と TextBox の重ね) は
         WPF 版の rendering 課題 (右端矢印が押せなくなる) を解決するための
         workaround だったが、Avalonia の ComboBox は IsEditable をネイティブ
         サポートしないので、編集可なドロップダウンが必要なら AutoCompleteBox
         に置き換える運用 (Batch 1c 以降で利用側を確認)。 ============================================================ -->
    <ControlTheme x:Key="InputComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource ForegroundDisabledBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="*,32">
                            <ContentControl Name="ContentPresenter"
                                            Grid.Column="0"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}" />
                            <Path Grid.Column="1"
                                  Width="10" Height="6"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="None"
                                  Stroke="#64748B"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Data="M 0,0 L 5,5 L 10,0" />
                        </Grid>
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource AccentLightBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding $parent[ComboBox].Bounds.Width}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="{TemplateBinding}"
                           Placement="BottomEdgeAlignedLeft">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,0,8"
                                BoxShadow="0 2 14 0 #2E0F172A">
                            <ScrollViewer Margin="4"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:dropdownopen /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Input AutoCompleteBox — Avalonia の ComboBox は IsEditable を
         サポートしないため、フォント名 等の自由入力 + 候補ドロップダウンが
         必要な場面では AutoCompleteBox に置き換えている (GraphFormatPanel
         の GraphFontComboBox)。Phase 7 では中身の TextBox 部分が
         Avalonia Fluent デフォルトのままで InputComboBoxStyle と揃わず、
         ドロップダウンの popup も装飾のない naked ListBox になっていた。

         この ControlTheme で:
           1. 外側 Border#Bd は InputComboBoxStyle と同じ 32px / 6px-corner /
              accent-on-focus シェル (FocusRing も同形)
           2. PART_TextBox は内部 TextBox を Background=Transparent /
              BorderThickness=0 にして外側 Border#Bd に枠を集約
           3. Popup#PART_Popup は InputComboBoxStyle の popup card と
              同じく surface 白 + 6px 角丸 + BoxShadow
           4. PART_SelectingItemsControl (ListBox) は Background=Transparent /
              BorderThickness=0 で popup card 内に貼る

         Avalonia 11 の制約: AutoCompleteBox の TemplatePart 名 (PART_TextBox /
         PART_Popup / PART_SelectingItemsControl) が違うとビルドは通って
         動作だけ壊れる silent bug になるので、Avalonia.Controls の
         AutoCompleteBox.cs にある [TemplatePart] と完全一致させる。
         ============================================================ -->
    <ControlTheme x:Key="InputAutoCompleteBoxStyle" TargetType="AutoCompleteBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <ControlTemplate TargetType="AutoCompleteBox">
                <Grid>
                    <Border Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            MinHeight="{TemplateBinding MinHeight}">
                        <TextBox Name="PART_TextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="{TemplateBinding Padding}"
                                 Foreground="{TemplateBinding Foreground}"
                                 Watermark="{TemplateBinding Watermark}"
                                 VerticalContentAlignment="Center"
                                 MinHeight="{TemplateBinding MinHeight}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 SelectionBrush="{StaticResource AccentLightBrush}"
                                 SelectionForegroundBrush="{StaticResource ForegroundPrimaryBrush}" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource FocusRingBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Popup Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                           MinWidth="{Binding $parent[AutoCompleteBox].Bounds.Width}"
                           MaxHeight="{TemplateBinding MaxDropDownHeight}"
                           PlacementTarget="{TemplateBinding}"
                           Placement="BottomEdgeAlignedLeft">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,0,8"
                                BoxShadow="0 2 14 0 #2E0F172A">
                            <ListBox Name="PART_SelectingItemsControl"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="4"
                                     Foreground="{StaticResource ForegroundPrimaryBrush}" />
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#Bd">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         Primary / Secondary / Icon Button。アクセント青、グレー、丸っこい
         アイコン (×) の 3 系統。WPF 版の Storyboard アニメは入れず、
         状態切替のみ実装。Phase 7 後半でブラッシュアップ。 ============================================================ -->
    <ControlTheme x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ShadowLayer"
                            CornerRadius="6"
                            Background="#1E3A8A"
                            Opacity="0.18"
                            Margin="0,2,0,-2" />
                    <Border Name="ButtonBorder"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource FocusRingBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Hover 時はボタン本体を 1px 持ち上げて影 Opacity を上げ、押し込み時は
             0px に戻して影も薄める (Phase 7 ブラッシュアップ B2)。WPF 版の
             Storyboard DoubleAnimation Y -1↔0 / 0:0:0.12 と同形を Avalonia の
             Style.Animations で再現。:not(:pointerover) の戻りアニメも書いて
             マウスが外れたときに「ストン」とではなく滑らかに着地させる。 -->
        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:pointerover) /template/ Border#ButtonBorder">
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:pointerover /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.08" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:pressed /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.10" />
            <Setter Property="Margin" Value="0,1,0,-1" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- ============================================================
         DestructiveButtonStyle — v1.3.5 で ConfirmDialog から参照する破壊操作用ボタン。
         PrimaryButtonStyle と同じテンプレ・同じ Hover lift / Pressed push-down を踏襲し、
         アクセント色だけを Error 系 Brush (ErrorBrush / ErrorHoverBrush / ErrorPressedBrush)
         に差し替える。影は ErrorForegroundBrush (#7F1D1D) を opacity 0.18 で重ねて
         primary の dark blue と同じ親和性を出す。Tokens は CommonTokens.axaml に集約。
         ============================================================ -->
    <ControlTheme x:Key="DestructiveButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ShadowLayer"
                            CornerRadius="6"
                            Background="{StaticResource ErrorForegroundBrush}"
                            Opacity="0.18"
                            Margin="0,2,0,-2" />
                    <Border Name="ButtonBorder"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource FocusRingBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource ErrorHoverBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:pointerover) /template/ Border#ButtonBorder">
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:pointerover /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.28" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource ErrorPressedBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.08" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:pressed /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0.10" />
            <Setter Property="Margin" Value="0,1,0,-1" />
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ShadowLayer">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="ButtonBorder"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <Border Name="FocusRing"
                            CornerRadius="8"
                            BorderBrush="{StaticResource FocusRingBrush}"
                            BorderThickness="2"
                            Margin="-2"
                            Opacity="0"
                            IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- PrimaryButton と同じく hover で 1px lift / pressed で 0px に push-down。
             Secondary は影レイヤーが無い分、リフトの動きが視認性を担う
             (Phase 7 ブラッシュアップ B2)。 -->
        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:pointerover) /template/ Border#ButtonBorder">
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Style.Animations>
                <Animation Duration="0:0:0.08" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(TranslateTransform.Y)" Value="-1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:focus /template/ Border#FocusRing">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="ButtonBorder"
                        CornerRadius="12"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#FECACA" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="#B91C1C" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource AccentDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- =========================================================
         Chrome (タイトルバー) 用リソース。Avalonia は WPF の
         System.Windows.Shell.WindowChrome の代わりに Window 側で
         ExtendClientAreaToDecorationsHint=True を立て、CustomTitleBar
         がアプリ上部に貼られて OS 標準の chrome を置き換える形になる。
         そのため IsHitTestVisibleInChrome 添付プロパティは不要。
         Geometry は WPF の <Geometry> 文字列リテラルが使えないので
         <StreamGeometry> に置換。ChromeMaximizeIcon と ChromeRestoreIcon は
         CustomTitleBar.axaml.cs の SyncMaxRestoreGlyph() が WindowState の
         変化に応じて入れ替える。
         ========================================================= -->

    <StreamGeometry x:Key="ChromeMinimizeIcon">M 0,5 L 10,5</StreamGeometry>
    <StreamGeometry x:Key="ChromeMaximizeIcon">M 0,0 L 10,0 L 10,10 L 0,10 Z</StreamGeometry>
    <StreamGeometry x:Key="ChromeRestoreIcon">M 2,0 L 10,0 L 10,8 L 8,8 M 0,2 L 8,2 L 8,10 L 0,10 Z</StreamGeometry>
    <StreamGeometry x:Key="ChromeCloseIcon">M 0,0 L 10,10 M 10,0 L 0,10</StreamGeometry>

    <!-- 最小化 / 最大化 / 復元用の Chrome ボタン。WPF は ControlTemplate.Triggers で
         IsMouseOver / IsPressed を切り替えていたが、Avalonia は Style Selector の
         ^:pointerover / ^:pressed を使う。
         Path.Data は TemplateBinding Tag で受けるので、CustomTitleBar 側で
         Button.Tag に StreamGeometry を割り当てる仕組みは WPF と同じ。 -->
    <ControlTheme x:Key="ChromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                    <Path Name="ButtonGlyph"
                          Data="{TemplateBinding Tag}"
                          Stroke="{StaticResource ForegroundMutedBrush}"
                          StrokeThickness="1"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="None"
                          Width="10"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#E2E8F0" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="#0F172A" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#CBD5E1" />
        </Style>
        <Style Selector="^:pressed /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="#0F172A" />
        </Style>
    </ControlTheme>

    <!-- 閉じるボタンだけは pointerover で赤系に染まるので別 ControlTheme。
         WPF と同じ #DC2626 / #B91C1C でグリフを白に反転する。 -->
    <ControlTheme x:Key="ChromeCloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                    <Path Name="ButtonGlyph"
                          Data="{TemplateBinding Tag}"
                          Stroke="{StaticResource ForegroundMutedBrush}"
                          StrokeThickness="1"
                          StrokeLineCap="Round"
                          Stretch="None"
                          Width="10"
                          Height="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="^:pressed /template/ Border#ButtonBorder">
            <Setter Property="Background" Value="#B91C1C" />
        </Style>
        <Style Selector="^:pressed /template/ Path#ButtonGlyph">
            <Setter Property="Stroke" Value="White" />
        </Style>
    </ControlTheme>

    <!-- WPF 版の WindowChromeRootBorderStyle と同じく、Maximized 時に
         7 px の Margin を入れて画面外への張り出しを補正する Border 用 ControlTheme。
         Avalonia は Window.OffScreenMargin で同じ補正が利く環境もあるが、
         WPF と完全に同じ見た目に揃えるため UI 側でも保険を掛ける。 -->
    <ControlTheme x:Key="WindowChromeRootBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F7F8FA" />
        <Setter Property="Margin" Value="0" />
        <Style Selector="^[Tag=Maximized]">
            <Setter Property="Margin" Value="7" />
        </Style>
    </ControlTheme>

    <!-- =========================================================
         ToolTip 用 ControlTheme（Batch 1b で持ち越したもの）。
         WPF 版は OverridesDefaultStyle=True + ControlTemplate で
         Border + DropShadowEffect を被せる手作り実装だったが、
         Avalonia は Border.BoxShadow が CSS と同じ syntax で 1 行
         書けるので、ContentControl 派生の ToolTip テンプレートに
         直接埋め込む。x:Key="{x:Type ToolTip}" で暗黙 ControlTheme
         として登録され、ImplicitStyles 側の Setter だけでは表現
         できなかった BoxShadow / CornerRadius を含めた見た目が
         Fluent デフォルトの上から差し替わる。
         WPF の DropShadowEffect ShadowDepth=2 / Direction=270 /
         BlurRadius=12 / Opacity=0.15 / Color=#0F172A は
         BoxShadow="0 2 12 0 #260F172A" に対応する (alpha 0x26 ≈ 15%)。
         ========================================================= -->
    <!-- =========================================================
         CheckBox 暗黙 ControlTheme（Batch 1f）。
         Fluent デフォルトの代わりに WPF 版と同じ「白い 18×18 角丸ボックス
         + 内部にチェックマーク Path」のレイアウトを 1 から組み、
         StrokeDashArray=10 / StrokeDashOffset の Animation で書き出し演出を
         再現する。WPF 版は Storyboard EnterActions/ExitActions で
         StrokeDashOffset を 10↔0 に動かしていたが、Avalonia は :checked と
         :not(:checked) 各々の Style.Animations で対応する。
         ========================================================= -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#334155" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Border Name="Box"
                            Width="18" Height="18"
                            CornerRadius="4"
                            Background="White"
                            BorderBrush="#94A3B8"
                            BorderThickness="1.5"
                            VerticalAlignment="Center">
                        <Path Name="CheckMark"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              StrokeDashArray="10"
                              StrokeDashOffset="10"
                              Data="M 3,8 L 7,12 L 13,4" />
                    </Border>
                    <ContentPresenter Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <!-- 状態別フック。Avalonia の Selector 構文は CSS 風で、template 内の
             名前付き要素は "/template/ Name#X" で参照する。 -->
        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        </Style>
        <Style Selector="^:focus /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{StaticResource ForegroundDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:disabled /template/ Border#Box">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDisabledBrush}" />
        </Style>
        <Style Selector="^:disabled:checked /template/ Border#Box">
            <Setter Property="Background" Value="{StaticResource AccentDisabledBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDisabledBrush}" />
        </Style>

        <!-- CheckMark slide-in（Batch 1b で持ち越したやつ）。WPF 版は
             DoubleAnimation StrokeDashOffset 10→0 / Duration 0:0:0.18 で
             書き出し、Trigger.ExitActions で 0→10 / Duration 0:0:0.12 に
             戻す。Avalonia は :checked と :not(:checked) 二方向の Style
             Animations で同等の挙動を再現する。 -->
        <Style Selector="^:checked /template/ Path#CheckMark">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:checked) /template/ Path#CheckMark">
            <Style.Animations>
                <Animation Duration="0:0:0.12" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="10" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         Expander 暗黙 ControlTheme（Batch 1f）。
         WPF 版は ToggleButton ヘッダー + 右端 Chevron + ContentPresenter
         (slide+fade) という構造を ControlTemplate.Triggers で組んでいた。
         Avalonia 版は同じ DockPanel 構造で実装し、:expanded / :not(:expanded)
         pseudo-class に対応する Animation で Chevron の Angle と Content
         の Opacity / TranslateY を動かす。
         Batch 1e で ImplicitStyles に置いた fade-in Animation はこの
         ControlTheme に集約済みなので、ImplicitStyles 側からは削除。
         ========================================================= -->
    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Expander">
                <DockPanel>
                    <ToggleButton Name="HeaderToggle"
                                  DockPanel.Dock="Top"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Cursor="Hand"
                                  HorizontalContentAlignment="Stretch"
                                  Foreground="{TemplateBinding Foreground}"
                                  FontSize="{TemplateBinding FontSize}"
                                  FontWeight="{TemplateBinding FontWeight}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Name="HeaderBg"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="4,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ContentPresenter Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        <Path Name="Chevron"
                                              Grid.Column="1"
                                              Width="10" Height="6"
                                              Stretch="None"
                                              Stroke="#64748B"
                                              StrokeThickness="1.6"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              VerticalAlignment="Center"
                                              Margin="8,0,2,0"
                                              Data="M 0,0 L 5,5 L 10,0"
                                              RenderTransformOrigin="50%,50%">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          VerticalAlignment="Center" />
                    </ToggleButton>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      DockPanel.Dock="Bottom"
                                      IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <ContentPresenter.RenderTransform>
                            <TranslateTransform Y="0" />
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>
                </DockPanel>
            </ControlTemplate>
        </Setter>

        <!-- ヘッダーホバーで背景に accent tint を被せる。Avalonia 11 では
             1 つの Style 内で /template/ を 2 段ネストできない（ControlTemplate
             styles cannot contain multiple template selectors）ため、
             Background は ToggleButton#HeaderToggle に直接、Chevron Stroke は
             Expander 自身の :pointerover で Path#Chevron を狙う sibling
             Style に分割し、二段ネストせずに同じ視覚効果を再現する
             (Phase 7 ブラッシュアップ B2)。 -->
        <Style Selector="^ /template/ ToggleButton#HeaderToggle:pointerover">
            <Setter Property="Background" Value="#F1F5F9" />
        </Style>
        <Style Selector="^:pointerover /template/ Path#Chevron">
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Chevron 0→180 度回転（Batch 1b で持ち越し）。:expanded で開く向き、
             :not(:expanded) で戻す向きの Animation を双方向に定義。
             RenderTransform に最初から RotateTransform が刺してあるので
             "(RotateTransform.Angle)" 指定でアニメ可能。 -->
        <Style Selector="^:expanded /template/ Path#Chevron">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(RotateTransform.Angle)" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(RotateTransform.Angle)" Value="180" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="^:not(:expanded) /template/ Path#Chevron">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="(RotateTransform.Angle)" Value="180" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="(RotateTransform.Angle)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Content の slide+fade（Batch 1e の fade-only Animation を
             slide まで含めた完全版に格上げ）。Y=-6 から 0 に滑り込みつつ
             Opacity 0→1。WPF 版の DoubleAnimation Y -6→0 と Opacity 0→1 /
             Duration 0:0:0.18 と完全に同形。 -->
        <Style Selector="^:expanded /template/ ContentPresenter#PART_ContentPresenter">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="(TranslateTransform.Y)" Value="-6" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="(TranslateTransform.Y)" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- =========================================================
         ScrollBar 暗黙 ControlTheme（Phase 7 ブラッシュアップ B1）。
         Avalonia Fluent デフォルトは AllowAutoHide=True で「pointer
         が乗ったときだけ ScrollBar が overlay 表示される」モード。
         Phase 7 移植直後は ImplicitStyles.axaml に Width/MinWidth と
         Thumb 色だけ Setter で当てており、ControlTemplate 自体は Fluent
         のままだったため、サイドバーや GPC overlay stats panel で
         「最初は引っ込んでいて、ドラッグした瞬間に本来の幅が現れる」
         という古臭い挙動になっていた。

         この ControlTheme で:
           1. Track + Thumb のみのミニマル構成 (上下/左右の矢印ボタンは廃止)
           2. Thumb は 6px 角丸 + Margin 2px で常時可視の細身 6px 描画
           3. Page Up/Down 用 RepeatButton は透明 Template で残し、Track 上の
              クリックでページスクロールする機能だけ維持
           4. Width/Height = 10px (WPF 版と同等の細身)
         を実現する。AllowAutoHide=False は ScrollViewer 側で全アプリに
         一括適用する (ImplicitStyles.axaml 参照)。

         Avalonia 11 の制約: ControlTheme 内で /template/ を 2 段ネスト
         できないので、Thumb の Background 切替は ScrollBar の :pointerover
         状態で Thumb.Background を直接 Setter する形を採る。
         ========================================================= -->
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track Name="PART_Track"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb Name="ThumbVisual"
                                   Background="{StaticResource BorderDefaultBrush}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{TemplateBinding Background}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb Name="ThumbVisual"
                                   Background="{StaticResource BorderDefaultBrush}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Margin="0,2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Hover 状態で Thumb の色を一段濃く。pressed では更に強調。
             Avalonia 11 の二段 /template/ ネスト禁止を避けるため、
             Thumb の Background プロパティを直接 Setter している。Thumb の
             ControlTemplate 内 Border は TemplateBinding Background で受ける。 -->
        <Style Selector="^:pointerover /template/ Thumb#ThumbVisual">
            <Setter Property="Background" Value="{StaticResource BorderHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Thumb#ThumbVisual">
            <Setter Property="Background" Value="{StaticResource ForegroundMutedBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToolTip">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        BoxShadow="0 2 12 0 #260F172A"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
