<UserControl x:Class="LabPlot.Core.Wpf.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="44"
             Background="#F7F8FA"
             d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ブランディング(左): 30 x 30 の #DBEAFE バッジに 16 x 16 のアイコン Path、
             右隣にアプリ名(SemiBold 13.5)+サブタイトル(10.5) を縦積み。 -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="14,0,12,0"
                    VerticalAlignment="Center">
            <Border Width="30" Height="30"
                    CornerRadius="6"
                    Background="#DBEAFE"
                    Margin="0,0,10,0">
                <Path x:Name="AppIconPath"
                      Stroke="#2563EB"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent"
                      Stretch="Uniform"
                      Width="16" Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppNameTextBlock"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Margin="0,0,0,1" />
                <TextBlock x:Name="SubtitleTextBlock"
                           FontSize="10.5"
                           Foreground="#64748B" />
            </StackPanel>
        </StackPanel>

        <!-- 中央のドラッグ領域。Background=Transparent でヒットテストは通すので
             WindowChrome.CaptionHeight 内のクリックがドラッグ移動として処理される。 -->
        <Grid Grid.Column="1" Background="Transparent" />

        <!-- 右端の最小化 / 最大化-復元 / 閉じるボタン。Tag に Geometry リソースを
             流し込んで Path.Data を TemplateBinding で受ける。 -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
            <Button x:Name="MinimizeButton"
                    Style="{DynamicResource ChromeButtonStyle}"
                    Tag="{DynamicResource ChromeMinimizeIcon}"
                    Click="MinimizeButton_Click"
                    ToolTip="最小化" />
            <Button x:Name="MaxRestoreButton"
                    Style="{DynamicResource ChromeButtonStyle}"
                    Tag="{DynamicResource ChromeMaximizeIcon}"
                    Click="MaxRestoreButton_Click"
                    ToolTip="最大化" />
            <Button x:Name="CloseButton"
                    Style="{DynamicResource ChromeCloseButtonStyle}"
                    Tag="{DynamicResource ChromeCloseIcon}"
                    Click="CloseButton_Click"
                    ToolTip="閉じる" />
        </StackPanel>
    </Grid>
</UserControl>
