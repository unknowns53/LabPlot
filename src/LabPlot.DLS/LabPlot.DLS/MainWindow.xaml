<Window x:Class="LabPlot.DLS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LabPlot.DLS"
        Title="LabPlot DLS"
        Width="1280"
        Height="800"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="#F8FAFC">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="16,12">
                <StackPanel>
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ファイル" />
                            <Button x:Name="OpenButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="DLS xlsx を開く..."
                                    Click="OpenButton_Click"
                                    Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="読み込み済みデータセット" />
                            <ListBox x:Name="DatasetListBox"
                                     SelectionMode="Extended"
                                     SelectionChanged="DatasetListBox_SelectionChanged"
                                     MinHeight="120"
                                     MaxHeight="280"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Background="#FFFFFF"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SheetName}" Padding="6,4" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Ctrl/Shift クリックで複数選択して重ね描きできるよ" />
                            <TextBlock x:Name="DatasetCountText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Text="ファイル未読み込み" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="表示" />

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="分布の種類" />
                            <ComboBox x:Name="DistributionTypeComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="DistributionTypeComboBox_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                            </ComboBox>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Run" />
                            <ComboBox x:Name="RunComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="RunComboBox_SelectionChanged"
                                      IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="書式" />

                            <Expander Header="軸範囲" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="粒径軸 (nm)" />
                                    <ComboBox x:Name="XAxisModeComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged"
                                              Margin="0,0,0,6">
                                        <ComboBoxItem Content="自動" Tag="Auto" IsSelected="True" />
                                        <ComboBoxItem Content="手動" Tag="Manual" />
                                    </ComboBox>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最小" />
                                            <TextBox x:Name="XAxisMinTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="0.1"
                                                     TextChanged="FormatTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大" />
                                            <TextBox x:Name="XAxisMaxTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="10000"
                                                     TextChanged="FormatTextBox_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Y 軸 (%)" />
                                    <ComboBox x:Name="YAxisModeComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged"
                                              Margin="0,0,0,6">
                                        <ComboBoxItem Content="自動" Tag="Auto" IsSelected="True" />
                                        <ComboBoxItem Content="手動" Tag="Manual" />
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最小" />
                                            <TextBox x:Name="YAxisMinTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="0"
                                                     TextChanged="FormatTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大" />
                                            <TextBox x:Name="YAxisMaxTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="30"
                                                     TextChanged="FormatTextBox_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="凡例" IsExpanded="False" Margin="0,4,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="表示" />
                                    <ComboBox x:Name="LegendVisibilityComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="自動 (2件以上で表示)" Tag="Auto" IsSelected="True" />
                                        <ComboBoxItem Content="常に表示" Tag="Always" />
                                        <ComboBoxItem Content="非表示" Tag="Never" />
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="位置" />
                                    <ComboBox x:Name="LegendPositionComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged">
                                        <ComboBoxItem Content="右上" Tag="UpperRight" IsSelected="True" />
                                        <ComboBoxItem Content="左上" Tag="UpperLeft" />
                                        <ComboBoxItem Content="右下" Tag="LowerRight" />
                                        <ComboBoxItem Content="左下" Tag="LowerLeft" />
                                        <ComboBoxItem Content="右中央" Tag="MiddleRight" />
                                    </ComboBox>
                                </StackPanel>
                            </Expander>

                            <Expander Header="起動時の既定値" IsExpanded="False" Margin="0,4,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の分布" />
                                    <ComboBox x:Name="DefaultDistributionComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                        <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                        <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の Run (0 始まり)" />
                                    <TextBox x:Name="DefaultRunIndexTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="0"
                                             TextChanged="FormatTextBox_TextChanged" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Plot area -->
        <Border Grid.Column="1"
                Margin="12"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">
            <Grid>
                <Grid x:Name="PlotHost">
                    <TextBlock x:Name="PlotPlaceholderTextBlock"
                               Text="グラフを初期化しています..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B" />
                </Grid>
                <Border Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0"
                        x:Name="ErrorBanner"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorBannerText" Foreground="#7F1D1D" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
