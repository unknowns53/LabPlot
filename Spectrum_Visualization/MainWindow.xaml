<Window x:Class="Spectrum_Visualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:core="clr-namespace:SpectrumAnalyzer.Core;assembly=SpectrumAnalyzer.Core"
        mc:Ignorable="d"
        Title="Spectrum Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1"
                                      Direction="270"
                                      BlurRadius="6"
                                      Opacity="0.05"
                                      Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="4,10,0,8" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="SelectionBrush" Value="#BFDBFE" />
            <Setter Property="SelectionOpacity" Value="0.6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"
                                          Background="Transparent"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Style="{x:Null}"
                                             Visibility="Collapsed"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Left"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Focusable="True" />
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          IsHitTestVisible="False"
                                          Width="10" Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stretch="None"
                                          Stroke="#64748B"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 0,0 L 5,5 L 10,0" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                CornerRadius="6"
                                                Cursor="Hand" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- IsEditable=True のときは ToggleButton 全体を IsHitTestVisible=False にして
                                 PART_EditableTextBox に入力をスルーさせる必要があるが、それだと右端の矢印
                                 ボタンも反応しなくなる。編集可モード専用の小さな矢印用 ToggleButton を
                                 右端 32px に重ねて、ドロップダウン展開だけはここで拾う。 -->
                            <ToggleButton x:Name="ArrowToggleButton"
                                          Width="32"
                                          HorizontalAlignment="Right"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Visibility="Collapsed"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"
                                                Cursor="Hand" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,8"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2"
                                                          BlurRadius="14"
                                                          Opacity="0.18"
                                                          Color="#0F172A" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="ToggleButton" Property="IsHitTestVisible" Value="False" />
                                <Setter TargetName="ArrowToggleButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="CheckMark"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Data="M 3,8 L 7,12 L 13,4" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1D4ED8" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsEnabled" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#CBD5E1" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          DockPanel.Dock="Top"
                                          IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          Cursor="Hand"
                                          HorizontalContentAlignment="Stretch"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBg"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Content"
                                                                  RecognizesAccessKey="True" />
                                                <Path x:Name="Chevron"
                                                      Grid.Column="1"
                                                      Width="10" Height="6"
                                                      Stretch="None"
                                                      Stroke="#64748B"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,2,0"
                                                      Data="M 0,0 L 5,5 L 10,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                            Storyboard.TargetProperty="Angle"
                                                                            To="180"
                                                                            Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                                            Storyboard.TargetProperty="Angle"
                                                                            To="0"
                                                                            Duration="0:0:0.18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Stroke" Value="#2563EB" />
                                                <Setter TargetName="HeaderBg" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ShadowLayer"
                                    CornerRadius="6"
                                    Background="#1E3A8A"
                                    Opacity="0.18"
                                    Margin="0,2,0,-2" />
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="8"
                                    BorderBrush="#60A5FA"
                                    BorderThickness="2"
                                    Margin="-2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.28" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E3A8A" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0.10" />
                                <Setter TargetName="ShadowLayer" Property="Margin" Value="0,1,0,-1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="8"
                                    BorderBrush="#60A5FA"
                                    BorderThickness="2"
                                    Margin="-2"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FEE2E2" />
                                <Setter Property="Foreground" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FECACA" />
                                <Setter Property="Foreground" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="20,22,20,10">
                    <TextBlock Text="Spectrum Analyzer"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Spectrum visualizer"
                               FontSize="11"
                               Foreground="#64748B" />
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,10,20,12">

                        <TextBlock Text="データ"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="データファイル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenSpectrumButton"
                                        Content="JASCO TXT を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        ToolTip="JASCO TXT データを開く (Ctrl+O)"
                                        Click="OpenSpectrumButton_Click" />
                                <CheckBox x:Name="OverlayCheckBox"
                                          Content="重ね描き (Overlay)"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed" />
                                <TextBlock x:Name="FilePathTextBlock"
                                           Text=""
                                           Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="読み込み済みデータセット" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#F8FAFC">
                                    <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="DatasetListBox_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="DatasetListBox_PreviewMouseMove"
                                                 DragOver="DatasetListBox_DragOver"
                                                 DragLeave="DatasetListBox_DragLeave"
                                                 Drop="DatasetListBox_Drop"
                                                 SelectionChanged="DatasetListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Cursor" Value="SizeAll" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding FullPath}"
                                                                   ToolTipService.ShowDuration="30000"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="×"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                Click="RemoveDatasetButton_Click"
                                                                ToolTip="削除" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DatasetListPlaceholder"
                                                   Text="データ未読み込み"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active dataset) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="線スタイル"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A" />
                                    <TextBlock x:Name="ActiveDatasetLabel"
                                               Text="(選択中データセット)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="色"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="LineColorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          Margin="0,0,0,6"
                                          SelectionChanged="LineColorComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Auto">
                                        <TextBlock Text="Auto" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">
                                        <TextBlock Text="Custom" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#2563EB">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#DC2626">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#16A34A">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EA580C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Orange" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#7C3AED">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#0891B2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Cyan" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#BE123C">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#4B5563">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Gray" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LineColorHexTextBox"
                                             Grid.Column="0"
                                             Text="Auto"
                                             ToolTip="Auto またはカラーコード (#RRGGBB)"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="LineColorHexTextBox_TextChanged" />
                                    <Border x:Name="LineColorPreviewBorder"
                                            Grid.Column="2"
                                            Height="28"
                                            Background="#2563EB"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                </Grid>

                                <TextBlock Text="凡例名"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="LegendNameTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,10"
                                         TextChanged="LegendNameTextBox_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LineWidthTextBox"
                                                 Text="1.5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="LineWidthTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="マーカー"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MarkerSizeTextBox"
                                                 Text="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="MarkerSizeTextBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="書式"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="軸範囲" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="X Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Y Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="AutoAxisRangeButton"
                                        Content="自動範囲に戻す"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Click="AutoAxisRangeButton_Click"
                                        ToolTip="X/Y の最小・最大値を空欄に戻して自動範囲で表示します (Ctrl+R)" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフラベル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="タイトル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TitleTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="TitleVisibleCheckBox"
                                              Grid.Column="0"
                                              Content="表示する"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="TitleBoldCheckBox"
                                              Grid.Column="2"
                                              Content="太字"
                                              IsChecked="True"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                </Grid>

                                <TextBlock Text="X軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="XLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="Y軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,6"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                <CheckBox x:Name="AxisLabelBoldCheckBox"
                                          Content="軸ラベルを太字"
                                          Margin="0,0,0,0"
                                          Checked="GraphAppearanceCheckBox_Changed"
                                          Unchecked="GraphAppearanceCheckBox_Changed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフ書式" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <Expander Header="フォント" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="フォント名"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="GraphFontComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              IsEditable="True"
                                              SelectedIndex="0"
                                              Margin="0,0,0,10"
                                              SelectionChanged="GraphAppearanceComboBox_SelectionChanged"
                                              Loaded="GraphFontComboBox_Loaded">
                                        <ComboBoxItem Content="Auto" Tag="Auto" />
                                        <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                                        <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                                        <ComboBoxItem Content="Arial" Tag="Arial" />
                                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                        <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                                    </ComboBox>

                                    <TextBlock Text="フォントサイズ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="GraphFontSizeTextBox"
                                             Text="12"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="目盛" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="YAxisTickLabelsCheckBox"
                                              Content="Y軸の数字を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,6"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="MajorTicksCheckBox"
                                              Content="主目盛を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,6"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <CheckBox x:Name="MinorTicksCheckBox"
                                              Content="補助目盛を表示する"
                                              IsChecked="True"
                                              Margin="0,0,0,10"
                                              Checked="GraphAppearanceCheckBox_Changed"
                                              Unchecked="GraphAppearanceCheckBox_Changed" />
                                    <TextBlock Text="X 軸の向き"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="InvertXAxisComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectedIndex="0"
                                              Margin="0,0,0,10"
                                              ToolTip="自動: IR データなら 4000 → 400 cm⁻¹ に反転、UV-Vis は正方向。手動指定でこれを上書き"
                                              SelectionChanged="InvertXAxisComboBox_SelectionChanged">
                                        <ComboBoxItem Content="自動（IR は反転）" Tag="Auto" />
                                        <ComboBoxItem Content="常に反転" Tag="Inverted" />
                                        <ComboBoxItem Content="常に正方向" Tag="Normal" />
                                    </ComboBox>
                                    <TextBlock Text="Y 軸の表示"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="YAxisDisplayComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectedIndex="0"
                                              ToolTip="ネイティブ: ファイルの YUNITS のまま / Absorbance: A 表示 / Transmittance: T (%) 表示。A↔T の変換ができないデータ (Reflectance 等) はネイティブで表示"
                                              SelectionChanged="YAxisDisplayComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ネイティブ" Tag="Native" />
                                        <ComboBoxItem Content="Absorbance" Tag="Absorbance" />
                                        <ComboBoxItem Content="Transmittance" Tag="Transmittance" />
                                    </ComboBox>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="枠とグリッド" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="PlotGridCheckBox"
                                                  Grid.Column="0"
                                                  Content="グリッドを表示"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                        <CheckBox x:Name="PlotFrameCheckBox"
                                                  Grid.Column="2"
                                                  Content="プロット枠を表示"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="枠線幅"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="PlotFrameWidthTextBox"
                                                     Text="1"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="枠色"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="PlotFrameColorComboBox"
                                                      Style="{StaticResource InputComboBoxStyle}"
                                                      SelectedIndex="0"
                                                      Margin="0,0,0,6"
                                                      SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Gray" Tag="#475569" />
                                                <ComboBoxItem Content="Black" Tag="#0F172A" />
                                                <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                                <ComboBoxItem Content="Red" Tag="#DC2626" />
                                                <ComboBoxItem Content="Green" Tag="#16A34A" />
                                                <ComboBoxItem Content="Custom" Tag="Custom" />
                                            </ComboBox>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PlotFrameColorHexTextBox"
                                                         Grid.Column="0"
                                                         Text="#475569"
                                                         ToolTip="カラーコード (#RRGGBB)"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         TextChanged="PlotFrameColorHexTextBox_TextChanged" />
                                                <Border x:Name="PlotFrameColorPreviewBorder"
                                                        Grid.Column="2"
                                                        Height="28"
                                                        Background="#475569"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="4" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="背景" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="背景色"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="BackgroundColorComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectedIndex="0"
                                              Margin="0,0,0,6"
                                              SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                        <ComboBoxItem Content="White" Tag="#FFFFFF" />
                                        <ComboBoxItem Content="Off-white" Tag="#F8FAFC" />
                                        <ComboBoxItem Content="Light gray" Tag="#E2E8F0" />
                                        <ComboBoxItem Content="Black" Tag="#0F172A" />
                                        <ComboBoxItem Content="Custom" Tag="Custom" />
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BackgroundColorHexTextBox"
                                                 Grid.Column="0"
                                                 Text="#FFFFFF"
                                                 ToolTip="カラーコード (#RRGGBB)"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="BackgroundColorHexTextBox_TextChanged" />
                                        <Border x:Name="BackgroundColorPreviewBorder"
                                                Grid.Column="2"
                                                Height="28"
                                                Background="#FFFFFF"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                    </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="メタデータ" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox x:Name="ShowMetadataCheckBox"
                                                  Content="測定メタデータをグラフに表示"
                                                  ToolTip="ファイルフッタの [測定情報] / [付属品情報] から測定波長・温度勾配・付属品名などを読み取り、プロット右上に小さく表示"
                                                  Checked="MetadataOption_Changed"
                                                  Unchecked="MetadataOption_Changed" />
                                        <TextBlock x:Name="MetadataHintTextBlock"
                                                   Text="温度スキャンを開くとメタデータ表示が利用できます"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="アスペクト比"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="AspectRatioComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="AspectRatioComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="3:2" Tag="3:2" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Analysis -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="解析" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">

                                <Expander Header="IR ピーク帰属" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PeakAssignmentEnableAllButton"
                                                Grid.Column="0"
                                                Content="全 ON"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PeakAssignmentEnableAllButton_Click" />
                                        <Button x:Name="PeakAssignmentDisableAllButton"
                                                Grid.Column="2"
                                                Content="全 OFF"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PeakAssignmentDisableAllButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="PeakAssignmentHintTextBlock"
                                               Text="IR データを開くと帰属が表示できます"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,0,0,6"
                                               Visibility="Collapsed" />
                                    <ItemsControl x:Name="PeakAssignmentItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="14" Height="14"
                                                            Background="{Binding ColorBrush}"
                                                            BorderBrush="#475569"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center" />
                                                    <CheckBox Grid.Column="2"
                                                              Content="{Binding Label}"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Checked="PeakAssignmentCheckBox_Changed"
                                                              Unchecked="PeakAssignmentCheckBox_Changed" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="波長スキャン解析（λmax）" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="LambdaMaxHintTextBlock"
                                                   Text="波長スキャンを開くと λmax 検出が利用できます"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,6"
                                                   Visibility="Collapsed" />
                                        <CheckBox x:Name="ShowLambdaMaxCheckBox"
                                                  Content="λmax にマーカーを表示"
                                                  Margin="0,0,0,8"
                                                  ToolTip="極大点を自動検出して垂直線とラベル（例: λmax = 280 nm）を描画。Absorbance ベースで検出（Transmittance データは A に変換）"
                                                  Checked="LambdaMaxOption_Changed"
                                                  Unchecked="LambdaMaxOption_Changed" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="検出閾値（A）"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="LambdaMaxMinAbsorbanceTextBox"
                                                         Text="0.05"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="この絶対値以上の極大のみマーカーを表示"
                                                         TextChanged="LambdaMaxNumericTextBox_TextChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="最大マーカー数"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="LambdaMaxCountTextBox"
                                                         Text="3"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="絶対値の高い順に上位 N 個まで描画（0 で無制限）"
                                                         TextChanged="LambdaMaxNumericTextBox_TextChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="温度スキャン解析（Tc / ヒステリシス）" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="CloudPointHintTextBlock"
                                                   Text="温度スキャン（Transmittance）を開くと Tc 検出が利用できます"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,0,0,6"
                                                   Visibility="Collapsed" />
                                        <CheckBox x:Name="ShowCloudPointCheckBox"
                                                  Content="曇点（Tc）を抽出して表示"
                                                  Margin="0,0,0,8"
                                                  ToolTip="温度スキャンから Tc を自動推定し、グラフ上に垂直線で表示。昇温・降温の両方が読み込まれていれば ΔT も計算"
                                                  Checked="CloudPointOption_Changed"
                                                  Unchecked="CloudPointOption_Changed" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="検出方法"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="CloudPointMethodComboBox"
                                                          Style="{StaticResource InputComboBoxStyle}"
                                                          SelectedIndex="0"
                                                          ToolTip="中点法: T 閾値の通過温度を線形補間 / 1次微分極大法: 平滑化後の dT/dTemp が最大の温度（変曲点）/ 2次微分極大法: 転移オンセット側の curvature ピーク / シグモイドfit: Boltzmann 関数 fit でロバストな Tc 推定"
                                                          SelectionChanged="CloudPointOption_Changed">
                                                    <ComboBoxItem Content="中点法（T 閾値）" Tag="Midpoint" />
                                                    <ComboBoxItem Content="1次微分極大法" Tag="FirstDerivativePeak" />
                                                    <ComboBoxItem Content="2次微分極大法（オンセット）" Tag="SecondDerivativeExtremum" />
                                                    <ComboBoxItem Content="シグモイドfit（Boltzmann）" Tag="SigmoidFit" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" x:Name="CloudPointThresholdPanel">
                                                <TextBlock Text="閾値（T %）"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox x:Name="CloudPointThresholdTextBox"
                                                         Text="50"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="中点法で使う透過率の閾値。50 % が標準（古典的 T₅₀ 定義）"
                                                         TextChanged="CloudPointNumericTextBox_TextChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="SigmoidFitOptionsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                            <CheckBox x:Name="ShowSigmoidFitCurveCheckBox"
                                                      Content="フィット曲線をグラフに重ね描き"
                                                      Margin="0,0,0,4"
                                                      ToolTip="フィットした Boltzmann 曲線を破線でグラフに重ねて表示。フィット品質を目視確認できます"
                                                      Checked="CloudPointOption_Changed"
                                                      Unchecked="CloudPointOption_Changed" />
                                            <CheckBox x:Name="ShowSigmoidFitParametersCheckBox"
                                                      Content="k と R² も表示"
                                                      Margin="0,0,0,0"
                                                      ToolTip="遷移幅 k（°C）とフィット品質 R² を結果テキストに含めます"
                                                      Checked="CloudPointOption_Changed"
                                                      Unchecked="CloudPointOption_Changed" />
                                        </StackPanel>
                                        <TextBlock x:Name="CloudPointResultTextBlock"
                                                   Text=""
                                                   FontSize="11"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   Foreground="#0F172A"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="積分" IsExpanded="False" FontSize="12" Margin="0,0,0,8">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AddIntegrationRegionButton"
                                                Grid.Column="0"
                                                Content="+ 領域追加"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="AddIntegrationRegionButton_Click"
                                                ToolTip="ボタンを押した後にグラフをドラッグすると X 範囲が埋まります。ドラッグせず数値入力でも編集可能です。" />
                                        <Button x:Name="ClearIntegrationRegionsButton"
                                                Grid.Column="2"
                                                Content="× 全削除"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ClearIntegrationRegionsButton_Click" />
                                    </Grid>

                                    <ItemsControl x:Name="IntegrationRegionItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,2,0,4"
                                                        Padding="6,4,6,6"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="24" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="ラベル"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource InputTextBoxStyle}"
                                                                     ToolTip="領域の名前" />
                                                            <Button Grid.Column="4"
                                                                    Content="×"
                                                                    Padding="0"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Click="RemoveIntegrationRegionButton_Click"
                                                                    ToolTip="この領域を削除" />
                                                        </Grid>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="X Min"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding XMinText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource InputTextBoxStyle}"
                                                                     ToolTip="X 範囲の最小値" />
                                                            <TextBlock Grid.Column="4"
                                                                       Text="X Max"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="6"
                                                                     Text="{Binding XMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource InputTextBoxStyle}"
                                                                     ToolTip="X 範囲の最大値" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Baseline"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="2"
                                                                      SelectedItem="{Binding Baseline}"
                                                                      Style="{StaticResource InputComboBoxStyle}"
                                                                      ToolTip="ベースライン補正の方法">
                                                                <core:BaselineMethod>None</core:BaselineMethod>
                                                                <core:BaselineMethod>Linear</core:BaselineMethod>
                                                                <core:BaselineMethod>ConvexHull</core:BaselineMethod>
                                                                <core:BaselineMethod>RubberBand</core:BaselineMethod>
                                                                <core:BaselineMethod>RubberBandHull</core:BaselineMethod>
                                                                <core:BaselineMethod>Polynomial</core:BaselineMethod>
                                                            </ComboBox>
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsRubberBand, Converter={StaticResource BoolToVisibility}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Segments"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding RubberBandSegmentsText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource InputTextBoxStyle}"
                                                                     ToolTip="ラバーバンドの分割数 (2 以上、既定 16)" />
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsPolynomial, Converter={StaticResource BoolToVisibility}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="Order"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding PolynomialOrderText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource InputTextBoxStyle}"
                                                                     ToolTip="多項式の次数 (1 - 5、既定 2)" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="結果（Absorbance ベースで積分）"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,10,0,4" />
                                    <TextBlock x:Name="IntegrationResultEmptyHintTextBlock"
                                               Text="領域を追加すると結果が表示されます"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,0,0,4"
                                               Visibility="Visible" />
                                    <ItemsControl x:Name="IntegrationResultItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DatasetName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DatasetName}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding RegionLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Tooltip}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding AreaText}"
                                                               TextAlignment="Right"
                                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                                               ToolTip="{Binding Tooltip}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button x:Name="ExportIntegrationResultsButton"
                                            Content="結果を CSV / XLSX 出力"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ExportIntegrationResultsButton_Click" />
                                </StackPanel>
                                </Expander>

                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Analysis session -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="解析条件" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="SaveSessionButton"
                                            Content="解析条件を保存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Margin="0,0,0,8"
                                            ToolTip="解析条件を .specjson に保存 (Ctrl+Shift+S)"
                                            Click="SaveSessionButton_Click" />
                                    <Button x:Name="LoadSessionButton"
                                            Content="解析条件を読込"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="解析条件 (.specjson) を読み込み (Ctrl+Shift+O)"
                                            Click="LoadSessionButton_Click" />
                                    <TextBlock Text="今開いている解析の状態（データ・線スタイル・軸範囲・グラフ書式）を任意の場所に .specjson として保存します。後でこのファイルを読み込めば、同じ解析をそのまま復元できます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: App preferences -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="環境設定" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="既定の出力フォルダ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultOutputDirectoryTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 ToolTip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                        <Button Grid.Column="2"
                                                Content="参照"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseDefaultOutputDirectoryButton_Click" />
                                    </Grid>

                                    <TextBlock Text="ここで設定した既定パスは、画面下部の「既定値として保存」を押すとグラフ書式と一緒にユーザー設定として保存され、次回起動時に保存ダイアログの初期フォルダになります。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,14">
                    <StackPanel>
                        <TextBlock Text="既定値（次回起動時の初期状態）"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResetGraphSettingsButton"
                                    Grid.Column="0"
                                    Content="既定値に戻す"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                    Click="ResetGraphSettingsButton_Click" />
                            <Button x:Name="SaveDefaultFormattingButton"
                                    Grid.Column="2"
                                    Content="既定値として保存"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                    Click="SaveDefaultFormattingButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        ToolTip="グラフを PNG / SVG で保存 (Ctrl+S)"
                        Click="SaveGraphButton_Click" />
                <Button x:Name="ExportDataButton"
                        DockPanel.Dock="Right"
                        Content="データ出力"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip="データを CSV / xlsx で出力 (Ctrl+E)"
                        Click="ExportDataButton_Click" />
                <TextBlock Text="Spectrum"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid>
                    <!-- ScottPlot コントロールはここに動的に挿入される。InitializePlotControl で
                         Children.Clear() するため、操作ヒントバッジは PlotHost の外側に置く。 -->
                    <Grid x:Name="PlotHost">
                        <TextBlock x:Name="PlotPlaceholderTextBlock"
                                   Text="グラフを初期化しています..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B" />
                    </Grid>
                    <Border x:Name="PlotControlsHintBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Width="22" Height="22"
                            CornerRadius="11"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000"
                            ToolTipService.Placement="Bottom">
                        <Border.ToolTip>
                            <ToolTip Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="プロット操作"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                    <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                    <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                    <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                    <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="i"
                                   FontFamily="Segoe UI, Yu Gothic UI, sans-serif"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontStyle="Italic"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

