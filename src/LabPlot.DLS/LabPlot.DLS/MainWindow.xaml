<Window x:Class="LabPlot.DLS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LabPlot.DLS"
        xmlns:controls="clr-namespace:LabPlot.Core.Wpf.Controls;assembly=LabPlot.Core.Wpf"
        Title="DLS Analyzer" Height="860" MinHeight="660" Width="1280" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="20,22,20,10">
                    <Border Width="36" Height="36"
                            CornerRadius="8"
                            Background="#DBEAFE"
                            VerticalAlignment="Top"
                            Margin="0,2,12,0">
                        <Path Stroke="#2563EB"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 2,16 C 5,16 6.5,4 10,4 C 13.5,4 15,16 18,16" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DLS Analyzer"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="Particle size visualizer"
                                   FontSize="11"
                                   Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,10,20,12">

                        <ContentControl Content="データ"
                                        Style="{StaticResource GroupHeaderStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource DataFileIconGeometry}" />
                                        <TextBlock Text="データファイル"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="OpenButton"
                                            Content="DLS xlsx を開く"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Zetasizer の xlsx データを開く (Ctrl+O)"
                                            Click="OpenButton_Click" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource DatasetListIconGeometry}" />
                                        <TextBlock Text="読み込み済みデータセット"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <Border BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="#F8FAFC">
                                        <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 SelectionMode="Extended"
                                                 SelectionChanged="DatasetListBox_SelectionChanged"
                                                 MinHeight="120"
                                                 MaxHeight="280"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 AllowDrop="True"
                                                 DragOver="DatasetListBox_DragOver"
                                                 Drop="DatasetListBox_Drop">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SheetName}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel x:Name="DatasetListPlaceholder"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="8,18,8,18"
                                                    IsHitTestVisible="False">
                                            <Path Width="32" Height="32"
                                                  Stretch="None"
                                                  Stroke="#94A3B8"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  HorizontalAlignment="Center"
                                                  Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                            <TextBlock Text="ここに xlsx をドロップ"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,2" />
                                            <TextBlock Text="または上のボタンから開く"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               TextWrapping="Wrap"
                                               Text="Ctrl/Shift クリックで複数選択して重ね描きできます (Ctrl+L : 全選択／全解除)" />
                                    <TextBlock x:Name="DatasetCountText"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="#64748B"
                                               Text="ファイル未読み込み" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active sheet) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource LineStyleIconGeometry}" />
                                        <TextBlock Text="線スタイル"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ActiveDatasetLabel"
                                                   Text="(選択中シート)"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="色" Style="{StaticResource FieldLabelStyle}" />
                                    <controls:ColorPickerPanel x:Name="LineColorPicker"
                                                                AllowAuto="True"
                                                                DefaultHex="#2563EB"
                                                                Margin="0,0,0,10"
                                                                ColorChanged="LineColorPicker_ColorChanged">
                                        <ComboBoxItem Tag="Auto" IsSelected="True">
                                            <TextBlock Text="Auto" />
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Custom">
                                            <TextBlock Text="Custom" />
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#2563EB">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Blue" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#DC2626">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Red" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#16A34A">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Green" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#EA580C">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Orange" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#7C3AED">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Purple" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#0891B2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Cyan" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#BE123C">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Rose" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="#4B5563">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                                <TextBlock Text="Gray" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </controls:ColorPickerPanel>

                                    <TextBlock Text="凡例名" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="LegendNameTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,0,10"
                                             ToolTip="凡例名を編集（F2 でフォーカス）"
                                             TextChanged="LegendNameTextBox_TextChanged" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="線幅" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="LineWidthTextBox"
                                                     Text="1.5"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="LineWidthTextBox_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="マーカー" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MarkerSizeTextBox"
                                                     Text="0"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="MarkerSizeTextBox_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Measurement metadata (active sheet) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="M 4,2 L 10,2 M 5,2 L 5,7 L 2,12 L 12,12 L 9,7 L 9,2 M 4,9 L 10,9" />
                                        <TextBlock Text="測定条件"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ActiveMetadataLabel"
                                                   Text="(選択中シート)"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="温度 (°C)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataTemperatureTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataTemperatureTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="濃度 (mg/mL)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataConcentrationTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataConcentrationTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="溶媒" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="MetadataSolventTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,0,10"
                                             LostFocus="MetadataSolventTextBox_LostFocus"
                                             KeyDown="MetadataTextBox_KeyDown" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="屈折率" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataRefractiveIndexTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataRefractiveIndexTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="粘度 (mPa·s)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataViscosityTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataViscosityTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="装置設定"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="波長 (nm)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataWavelengthTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataWavelengthTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="散乱角 (°)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox x:Name="MetadataScatteringAngleTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     LostFocus="MetadataScatteringAngleTextBox_LostFocus"
                                                     KeyDown="MetadataTextBox_KeyDown" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Cumulant analysis (active sheet) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="M 1,12 Q 4,12 5,9 Q 7,2 9,9 Q 10,12 13,12" />
                                        <TextBlock Text="キュムラント解析"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ActiveCumulantLabel"
                                                   Text="(選択中シート)"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="フィット範囲 (μs)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CumulantFitMinTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 LostFocus="CumulantFitRangeTextBox_LostFocus"
                                                 KeyDown="MetadataTextBox_KeyDown" />
                                        <TextBox x:Name="CumulantFitMaxTextBox"
                                                 Grid.Column="2"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 LostFocus="CumulantFitRangeTextBox_LostFocus"
                                                 KeyDown="MetadataTextBox_KeyDown" />
                                    </Grid>
                                    <TextBlock Text="空欄で自動検出 (g₂-1 ≧ 0.1 を保持)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               Margin="0,-6,0,10" />

                                    <Border BorderBrush="#E2E8F0"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="Z-average 径"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="CumulantZAverageText"
                                                       Grid.Row="0" Grid.Column="2"
                                                       Text="—"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="PdI"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="CumulantPdiText"
                                                       Grid.Row="1" Grid.Column="2"
                                                       Text="—"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="Γ"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="CumulantGammaText"
                                                       Grid.Row="2" Grid.Column="2"
                                                       Text="—"
                                                       FontSize="12"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                       Text="適用範囲"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="CumulantRangeText"
                                                       Grid.Row="3" Grid.Column="2"
                                                       Text="—"
                                                       FontSize="12"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,0,4" />

                                            <TextBlock Grid.Row="4" Grid.Column="0"
                                                       Text="R²"
                                                       Foreground="#475569"
                                                       FontSize="12"
                                                       Margin="0,0,0,4" />
                                            <TextBlock x:Name="CumulantRSquaredText"
                                                       Grid.Row="4" Grid.Column="2"
                                                       Text="—"
                                                       FontSize="12"
                                                       Foreground="#0F172A"
                                                       Margin="0,0,0,4" />

                                            <TextBlock x:Name="CumulantStatusText"
                                                       Grid.Row="5" Grid.ColumnSpan="3"
                                                       Text=""
                                                       FontSize="11"
                                                       Foreground="#B45309"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Display (distribution / run) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="M 1,7 Q 7,2 13,7 Q 7,12 1,7 Z M 6,7 A 1,1 0 1 0 8,7 A 1,1 0 1 0 6,7 Z" />
                                        <TextBlock Text="表示"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="分布の種類" />
                                    <ComboBox x:Name="DistributionTypeComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="DistributionTypeComboBox_SelectionChanged"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                        <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                        <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                        <ComboBoxItem Content="自己相関 g₂-1" Tag="Correlation" />
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Run" />
                                    <ComboBox x:Name="RunComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="RunComboBox_SelectionChanged"
                                              IsEnabled="False" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <ContentControl Content="書式"
                                        Style="{StaticResource GroupHeaderStyle}" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource AxisRangeIconGeometry}" />
                                        <TextBlock Text="軸範囲"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <controls:AxisRangePanel x:Name="AxisRangePanel"
                                                         XAxisLabel="粒径軸 (nm)"
                                                         YAxisLabel="Y 軸 (%)"
                                                         AxisRangeCommitted="AxisRangePanel_Committed"
                                                         Margin="0,8,0,0" />
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource GraphLabelIconGeometry}" />
                                        <TextBlock Text="グラフラベル"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="TitleTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,0,6"
                                             TextChanged="GraphLabelTextBox_TextChanged" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="TitleVisibleCheckBox"
                                                  Grid.Column="0"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                        <CheckBox x:Name="TitleBoldCheckBox"
                                                  Grid.Column="2"
                                                  Content="太字"
                                                  IsChecked="True"
                                                  Checked="FormatCheckBox_Changed"
                                                  Unchecked="FormatCheckBox_Changed" />
                                    </Grid>

                                    <TextBlock Text="X軸ラベル" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="XLabelTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,0,8"
                                             TextChanged="GraphLabelTextBox_TextChanged" />

                                    <TextBlock Text="Y軸ラベル" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="YLabelTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,0,0,6"
                                             TextChanged="GraphLabelTextBox_TextChanged" />
                                    <CheckBox x:Name="AxisLabelBoldCheckBox"
                                              Content="軸ラベルを太字"
                                              Margin="0,0,0,0"
                                              Checked="FormatCheckBox_Changed"
                                              Unchecked="FormatCheckBox_Changed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource GraphFormatIconGeometry}" />
                                        <TextBlock Text="グラフ書式"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <controls:GraphFormatPanel x:Name="GraphFormatPanel"
                                                           GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                           AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />
                            </Expander>
                        </Border>

                        <!-- Section: Analysis session -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource AnalysisConditionsIconGeometry}" />
                                        <TextBlock Text="解析条件"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="SaveSessionButton"
                                            Content="解析条件を保存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Margin="0,0,0,8"
                                            ToolTip="解析条件を .dlsjson に保存 (Ctrl+Shift+S)"
                                            Click="SaveSessionButton_Click" />
                                    <Button x:Name="LoadSessionButton"
                                            Content="解析条件を読み込み"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="解析条件 (.dlsjson) を読み込み (Ctrl+Shift+O)"
                                            Click="LoadSessionButton_Click" />
                                    <TextBlock Text="今開いている解析の状態（データ・線スタイル・測定条件・キュムラント解析・軸範囲・グラフ書式）を任意の場所に .dlsjson として保存します。後でこのファイルを読み込めば、同じ解析をそのまま復元できます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: App preferences -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource PreferencesIconGeometry}" />
                                        <TextBlock Text="環境設定"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="既定の出力フォルダ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultOutputDirectoryTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 ToolTip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                        <Button Grid.Column="2"
                                                Content="参照"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseDefaultOutputDirectoryButton_Click" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の分布" />
                                    <ComboBox x:Name="DefaultDistributionComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="FormatComboBox_SelectionChanged"
                                              Margin="0,0,0,8">
                                        <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                        <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                        <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                    </ComboBox>

                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="既定の Run (0 始まり)" />
                                    <TextBox x:Name="DefaultRunIndexTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="0"
                                             TextChanged="FormatTextBox_TextChanged" />

                                    <TextBlock Text="ここで設定した既定値は、画面下部の「既定値として保存」を押すとグラフ書式と一緒にユーザー設定として保存され、次回起動時に自動で適用されます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,14">
                    <Border.Effect>
                        <DropShadowEffect Direction="90"
                                          ShadowDepth="3"
                                          BlurRadius="10"
                                          Opacity="0.10"
                                          Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="既定値（次回起動時の初期状態）"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResetGraphSettingsButton"
                                    Grid.Column="0"
                                    Content="既定値に戻す"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                    Click="ResetGraphSettingsButton_Click" />
                            <Button x:Name="SaveDefaultFormattingButton"
                                    Grid.Column="2"
                                    Content="既定値として保存"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                    Click="SaveDefaultFormattingButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        ToolTip="グラフを PNG / SVG で保存 (Ctrl+S)"
                        Click="SaveGraphButton_Click" />
                <Button x:Name="ExportButton"
                        DockPanel.Dock="Right"
                        Content="データ出力"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip="データを CSV / xlsx で出力 (Ctrl+E)"
                        Click="ExportButton_Click" />
                <TextBlock Text="Particle size distribution"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid>
                    <Grid x:Name="PlotHost">
                        <!-- スケルトン: 軸の影 + 仮データ線 + 横切るシマー帯。
                             プロット初期化時に PlotHost.Children.Clear() で消える。 -->
                        <Grid Width="320" Height="200"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid Width="320" Height="180"
                                  VerticalAlignment="Top"
                                  ClipToBounds="True">
                                <Canvas Width="320" Height="180">
                                    <Rectangle Canvas.Left="22" Canvas.Top="20"
                                               Width="2" Height="140"
                                               Fill="#E2E8F0" />
                                    <Rectangle Canvas.Left="20" Canvas.Top="158"
                                               Width="280" Height="2"
                                               Fill="#E2E8F0" />
                                    <Path Stroke="#CBD5E1"
                                          StrokeThickness="2.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 30,140 Q 70,140 100,80 Q 130,30 160,80 Q 190,140 230,120 Q 260,100 290,140" />
                                </Canvas>
                                <Border Width="120" Height="180"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-120" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                        From="-120" To="320"
                                                        Duration="0:0:2.0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="PlotPlaceholderTextBlock"
                                       Text="グラフを初期化しています..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" />
                        </Grid>
                    </Grid>
                    <Border x:Name="PlotControlsHintBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Width="22" Height="22"
                            CornerRadius="11"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000"
                            ToolTipService.Placement="Bottom">
                        <Border.ToolTip>
                            <ToolTip Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="プロット操作"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                    <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                    <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                    <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                    <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Path Width="3" Height="9"
                              Fill="#475569"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="None">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="1.5,1.25" RadiusX="1.25" RadiusY="1.25" />
                                    <RectangleGeometry Rect="0.25,3.75 2.5,5.25" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Border>
                    <controls:ErrorBanner x:Name="ErrorBanner" />
                </Grid>
            </Border>

            <StatusBar Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
                <TextBlock x:Name="StatusTextBlock"
                           Text="DLS xlsx を開いてください。"
                           Foreground="#475569" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
