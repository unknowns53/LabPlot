<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LabPlot.Core.Avalonia.Controls.ErrorBanner"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,12,0,0"
             IsVisible="False">
    <Border Background="#FEE2E2"
            BorderBrush="#FCA5A5"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,6">
        <TextBlock Name="MessageTextBlock" Foreground="#7F1D1D" />
    </Border>
</UserControl>
