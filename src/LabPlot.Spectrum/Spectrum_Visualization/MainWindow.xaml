                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="CalibrationSummaryTextBlock"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="11"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <Button x:Name="ExportCalibrationResultsButton"
                                                Content="結果を CSV / XLSX 出力"
                                                Margin="0,8,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Visibility="Collapsed"
                                                Click="ExportCalibrationResultsButton_Click" />
                                    </StackPanel>
                                </Expander>

                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Analysis session -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource AnalysisConditionsIconGeometry}" />
                                        <TextBlock Text="解析条件"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="SaveSessionButton"
                                            Content="解析条件を保存"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Margin="0,0,0,8"
                                            ToolTip="解析条件を .specjson に保存 (Ctrl+Shift+S)"
                                            Click="SaveSessionButton_Click" />
                                    <Button x:Name="LoadSessionButton"
                                            Content="解析条件を読み込み"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="解析条件 (.specjson) を読み込み (Ctrl+Shift+O)"
                                            Click="LoadSessionButton_Click" />
                                    <TextBlock Text="今開いている解析の状態（データ・線スタイル・軸範囲・グラフ書式）を任意の場所に .specjson として保存します。後でこのファイルを読み込めば、同じ解析をそのまま復元できます。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: App preferences -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SectionIconPath}"
                                              Data="{StaticResource PreferencesIconGeometry}" />
                                        <TextBlock Text="環境設定"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#0F172A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="既定の出力フォルダ"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultOutputDirectoryTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 ToolTip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                        <Button Grid.Column="2"
                                                Content="参照"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="BrowseDefaultOutputDirectoryButton_Click" />
                                    </Grid>

                                    <TextBlock Text="ここで設定した既定パスは、画面下部の「既定値として保存」を押すとグラフ書式と一緒にユーザー設定として保存され、次回起動時に保存ダイアログの初期フォルダになります。"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="20,12,20,14">
                    <Border.Effect>
                        <DropShadowEffect Direction="90"
                                          ShadowDepth="3"
                                          BlurRadius="10"
                                          Opacity="0.10"
                                          Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="既定値（次回起動時の初期状態）"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResetGraphSettingsButton"
                                    Grid.Column="0"
                                    Content="既定値に戻す"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                    Click="ResetGraphSettingsButton_Click" />
                            <Button x:Name="SaveDefaultFormattingButton"
                                    Grid.Column="2"
                                    Content="既定値として保存"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                    Click="SaveDefaultFormattingButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        ToolTip="グラフを PNG / SVG で保存 (Ctrl+S)"
                        Click="SaveGraphButton_Click" />
                <Button x:Name="ExportDataButton"
                        DockPanel.Dock="Right"
                        Content="データ出力"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Margin="0,0,8,0"
                        ToolTip="データを CSV / xlsx で出力 (Ctrl+E)"
                        Click="ExportDataButton_Click" />
                <TextBlock Text="Spectrum"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid>
                    <!-- ScottPlot コントロールはここに動的に挿入される。InitializePlotControl で
                         Children.Clear() するため、操作ヒントバッジは PlotHost の外側に置く。 -->
                    <Grid x:Name="PlotHost">
                        <!-- スケルトン: 軸の影 + 仮データ線 + 横切るシマー帯。
                             プロット初期化時に PlotHost.Children.Clear() で消える。 -->
                        <Grid Width="320" Height="200"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid Width="320" Height="180"
                                  VerticalAlignment="Top"
                                  ClipToBounds="True">
                                <Canvas Width="320" Height="180">
                                    <Rectangle Canvas.Left="22" Canvas.Top="20"
                                               Width="2" Height="140"
                                               Fill="#E2E8F0" />
                                    <Rectangle Canvas.Left="20" Canvas.Top="158"
                                               Width="280" Height="2"
                                               Fill="#E2E8F0" />
                                    <Path Stroke="#CBD5E1"
                                          StrokeThickness="2.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M 30,140 Q 70,140 100,80 Q 130,30 160,80 Q 190,140 230,120 Q 260,100 290,140" />
                                </Canvas>
                                <Border Width="120" Height="180"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-120" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                        From="-120" To="320"
                                                        Duration="0:0:2.0" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="PlotPlaceholderTextBlock"
                                       Text="グラフを初期化しています..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" />
                        </Grid>
                    </Grid>
                    <Border x:Name="PlotControlsHintBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,8,0"
                            Width="22" Height="22"
                            CornerRadius="11"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Cursor="Help"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000"
                            ToolTipService.Placement="Bottom">
                        <Border.ToolTip>
                            <ToolTip Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="プロット操作"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                    <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                    <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                    <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                    <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <Path Width="3" Height="9"
                              Fill="#475569"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="None">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="1.5,1.25" RadiusX="1.25" RadiusY="1.25" />
                                    <RectangleGeometry Rect="0.25,3.75 2.5,5.25" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Border>
                    <controls:ErrorBanner x:Name="ErrorBanner" />
                    <controls:BusyOverlay x:Name="BusyOverlay" />
                </Grid>
            </Border>

            <StatusBar Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
                <TextBlock x:Name="StatusTextBlock"
                           Text="JASCO TXT を開いてください。"
                           Foreground="#475569" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
