<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 7 Batch 2: WPF 版 LabPlot.Shell に対応する Avalonia 版エントリポイント。
       net10.0-windows のみで動く WPF 版に対し、こちらは net10.0 で macOS / Linux にも
       実行ファイルを出せる。Batch 3 以降で DLS / GPC / Spectrum の Avalonia 版が揃ったら
       ProjectReference を追加し、PortalWindow から各モジュールを起動できるようにする。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LabPlot.Shell.Avalonia</RootNamespace>
    <AssemblyName>LabPlot.Avalonia</AssemblyName>
    <Version>1.3.5</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- v1.2.1: exe 本体に埋め込むアイコン。エクスプローラ / タスクバー pin / ショートカット
         右下のアプリ識別はこの .ico を見る。Window.Icon (PNG) は別経路で
         Core.Avalonia/Assets/app-icon.png から avares 経由で読む。 -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabPlot.Core.Avalonia\LabPlot.Core.Avalonia.csproj" />
    <ProjectReference Include="..\LabPlot.DLS.Avalonia\LabPlot.DLS.Avalonia.csproj" />
    <ProjectReference Include="..\LabPlot.GPC.Avalonia\LabPlot.GPC.Avalonia.csproj" />
    <ProjectReference Include="..\LabPlot.Spectrum.Avalonia\LabPlot.Spectrum.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
  </ItemGroup>

  <!-- macOS .app バンドル化。dotnet publish -r osx-arm64 の Publish ターゲット完了後に
       LabPlot.app/Contents/{MacOS, Resources, Info.plist} を組み立てて Finder から
       ダブルクリック起動 / Dock アイコン表示できるようにする。osx-arm64 RID のときだけ
       走るので、Windows / Linux 向け publish には影響しない。

       手順:
         1. publish 出力ディレクトリに LabPlot.app/Contents/{MacOS,Resources} を作成
         2. macOS/Info.plist の __VERSION__ プレースホルダを $(Version) で置換しコピー
         3. Assets/app-icon.icns を Resources/ にコピー (Info.plist の CFBundleIconFile が参照)
         4. publish された全ファイル (LabPlot.Avalonia 実行ファイル + native libs) を
            Contents/MacOS/ に移動。LabPlot.app 自身は除外して再帰移動を防ぐ -->
  <ItemGroup>
    <None Include="Assets\app-icon.icns" />
    <None Include="macOS\Info.plist" />
  </ItemGroup>

  <Target Name="MacOSAppBundle"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64'">
    <PropertyGroup>
      <AppBundleRoot>$(PublishDir)LabPlot.app</AppBundleRoot>
      <ContentsDir>$(AppBundleRoot)/Contents</ContentsDir>
    </PropertyGroup>

    <RemoveDir Directories="$(AppBundleRoot)" Condition="Exists('$(AppBundleRoot)')" />
    <MakeDir Directories="$(ContentsDir)/MacOS;$(ContentsDir)/Resources" />

    <Exec Command="sed &quot;s/__VERSION__/$(Version)/g&quot; &quot;$(MSBuildProjectDirectory)/macOS/Info.plist&quot; &gt; &quot;$(ContentsDir)/Info.plist&quot;" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)/Assets/app-icon.icns"
          DestinationFolder="$(ContentsDir)/Resources/" />

    <!-- $(PublishDir)**\* で再帰的に全ファイル (samples/demo.xlsx などサブディレクトリも) を
         取得し、%(RecursiveDir) で Contents/MacOS/ 配下に同じ構造で移動する。
         LabPlot.app 自身は除外して再帰移動を防ぐ。 -->
    <ItemGroup>
      <_AppBundlePayload Include="$(PublishDir)**\*" Exclude="$(PublishDir)LabPlot.app/**" />
    </ItemGroup>
    <Move SourceFiles="@(_AppBundlePayload)"
          DestinationFiles="@(_AppBundlePayload->'$(ContentsDir)/MacOS/%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- 残った空ディレクトリを掃除 (samples/ など、Move 後に親ディレクトリが空になる) -->
    <RemoveDir Directories="$(PublishDir)samples" Condition="Exists('$(PublishDir)samples')" />

    <Message Text="macOS .app bundle 作成完了: $(AppBundleRoot)" Importance="high" />
  </Target>

</Project>
