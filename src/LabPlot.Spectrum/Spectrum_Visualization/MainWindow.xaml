                                                    Click="AddManualIrPeakButton_Click"
                                                    ToolTip="ボタンを押した後、グラフ上をクリックするとピークマーカーを追加（Esc / 右クリック / 同ボタン再押下でキャンセル）" />
                                            <Button x:Name="ClearManualIrPeakButton"
