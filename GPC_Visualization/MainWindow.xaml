<Window x:Class="GPC_Visualization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GPC Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA">
    <Window.Resources>
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="2,2,0,6" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#EEF2F7"
                BorderBrush="#CBD5E1"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,18,16,8">
                    <TextBlock Text="GPC Analyzer"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               Margin="0,0,0,2" />
                    <TextBlock Text="Chromatogram visualizer"
                               FontSize="11"
                               Foreground="#64748B" />
                </StackPanel>

                <!-- Scrollable sections -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,8,16,8">

                        <TextBlock Text="データ"
                                   Style="{StaticResource GroupLabelStyle}" />

                        <!-- Section: File -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="データファイル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCsvButton"
                                        Content="CSV / TXT を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        Click="OpenCsvButton_Click" />
                                <CheckBox x:Name="OverlayCheckBox"
                                          Content="重ね描き (Overlay)"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed" />
                                <TextBlock x:Name="FilePathTextBlock"
                                           Text=""
                                           Visibility="Collapsed" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Loaded datasets -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="読み込み済みデータセット" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#F8FAFC">
                                    <Grid>
                                        <ListBox x:Name="DatasetListBox"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="DatasetListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="4,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Width="14" Height="14"
                                                                Background="{Binding ColorBrush}"
                                                                CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                Margin="2,0,8,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   ToolTip="{Binding FullPath}"
                                                                   ToolTipService.ShowDuration="30000"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Content="×"
                                                                Width="22" Height="22"
                                                                Padding="0"
                                                                FontSize="14"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding}"
                                                                Click="RemoveDatasetButton_Click"
                                                                ToolTip="削除" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DatasetListPlaceholder"
                                                   Text="データ未読み込み"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="書式"
                                   Style="{StaticResource GroupLabelStyle}"
                                   Margin="2,6,0,6" />

                        <!-- Section: Axis range -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="軸範囲" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="X Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="XMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Y Min"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMinTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y Max"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="YMaxTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 KeyDown="AxisRangeTextBox_KeyDown"
                                                 LostFocus="AxisRangeTextBox_LostFocus" />
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="AutoAxisRangeButton"
                                        Content="自動範囲に戻す"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Click="AutoAxisRangeButton_Click"
                                        ToolTip="X/Y の最小・最大値を空欄に戻して自動範囲で表示します" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph labels -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフラベル" IsExpanded="True">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="タイトル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="TitleTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="X軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="XLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         TextChanged="GraphLabelTextBox_TextChanged" />

                                <TextBlock Text="Y軸ラベル"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="YLabelTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         TextChanged="GraphLabelTextBox_TextChanged" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Graph appearance -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="グラフ書式" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="フォント"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="GraphFontComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEditable="True"
                                          SelectedIndex="0"
                                          Margin="0,0,0,10"
                                          SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="Yu Gothic" Tag="Yu Gothic" />
                                    <ComboBoxItem Content="Meiryo" Tag="Meiryo" />
                                    <ComboBoxItem Content="Arial" Tag="Arial" />
                                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                    <ComboBoxItem Content="MS Gothic" Tag="MS Gothic" />
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="フォントサイズ"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="GraphFontSizeTextBox"
                                                 Text="12"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="グリッド"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="PlotGridCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Margin="0,6,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="縦軸の数字"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="YAxisTickLabelsCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  Margin="0,3,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="プロット枠"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <CheckBox x:Name="PlotFrameCheckBox"
                                                  Content="表示する"
                                                  IsChecked="True"
                                                  Margin="0,3,0,0"
                                                  Checked="GraphAppearanceCheckBox_Changed"
                                                  Unchecked="GraphAppearanceCheckBox_Changed" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="枠線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="PlotFrameWidthTextBox"
                                                 Text="1"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="GraphAppearanceNumericTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="枠色"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="PlotFrameColorComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  Margin="0,0,0,6"
                                                  SelectionChanged="GraphAppearanceComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Gray" Tag="#475569" />
                                            <ComboBoxItem Content="Black" Tag="#0F172A" />
                                            <ComboBoxItem Content="Blue" Tag="#2563EB" />
                                            <ComboBoxItem Content="Red" Tag="#DC2626" />
                                            <ComboBoxItem Content="Green" Tag="#16A34A" />
                                            <ComboBoxItem Content="Custom" Tag="Custom" />
                                        </ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PlotFrameColorHexTextBox"
                                                     Grid.Column="0"
                                                     Text="#475569"
                                                     ToolTip="カラーコード (#RRGGBB)"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     TextChanged="PlotFrameColorHexTextBox_TextChanged" />
                                            <Border x:Name="PlotFrameColorPreviewBorder"
                                                    Grid.Column="2"
                                                    Height="28"
                                                    Background="#475569"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="アスペクト比"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="AspectRatioComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="AspectRatioComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto" Tag="Auto" />
                                    <ComboBoxItem Content="16:9" Tag="16:9" />
                                    <ComboBoxItem Content="4:3" Tag="4:3" />
                                    <ComboBoxItem Content="3:2" Tag="3:2" />
                                    <ComboBoxItem Content="1:1" Tag="1:1" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Section: Line style (active dataset) -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="線スタイル"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#0F172A" />
                                    <TextBlock x:Name="ActiveDatasetLabel"
                                               Text="(選択中データセット)"
                                               FontSize="11"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,2" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">

                                <TextBlock Text="色"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="LineColorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          Margin="0,0,0,6"
                                          SelectionChanged="LineColorComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Auto">
                                        <TextBlock Text="Auto" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Custom">
                                        <TextBlock Text="Custom" />
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#2563EB">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Blue" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#DC2626">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Red" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#16A34A">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Green" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#EA580C">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Orange" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#7C3AED">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Purple" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#0891B2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Cyan" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#BE123C">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Rose" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="#4B5563">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                            <TextBlock Text="Gray" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LineColorHexTextBox"
                                             Grid.Column="0"
                                             Text="Auto"
                                             ToolTip="Auto またはカラーコード (#RRGGBB)"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="LineColorHexTextBox_TextChanged" />
                                    <Border x:Name="LineColorPreviewBorder"
                                            Grid.Column="2"
                                            Height="28"
                                            Background="#2563EB"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                </Grid>

                                <TextBlock Text="凡例名"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="LegendNameTextBox"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         Margin="0,0,0,10"
                                         TextChanged="LegendNameTextBox_TextChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="線幅"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="LineWidthTextBox"
                                                 Text="1.5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="LineWidthTextBox_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="マーカー"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox x:Name="MarkerSizeTextBox"
                                                 Text="0"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="MarkerSizeTextBox_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="分子量"
                                   Style="{StaticResource GroupLabelStyle}"
                                   Margin="2,6,0,6" />

                        <!-- Section: Calibration & MW -->
                        <Border Style="{StaticResource SectionStyle}">
                            <Expander Header="較正曲線と分子量" IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="OpenCalibrationButton"
                                        Content="較正曲線 JSON を開く"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"
                                        Click="OpenCalibrationButton_Click" />
                                <TextBlock x:Name="CalibrationPathTextBlock"
                                           Text="較正曲線: 未選択"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#475569"
                                           ToolTipService.ShowDuration="30000"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="溶媒"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SolventComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,8"
                                          SelectionChanged="SolventComboBox_SelectionChanged" />

                                <TextBlock Text="検出器"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="DetectorComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          Margin="0,0,0,12"
                                          SelectionChanged="DetectorComboBox_SelectionChanged" />

                                <CheckBox x:Name="MolecularWeightCheckBox"
                                          Content="分子量表示"
                                          IsEnabled="False"
                                          Margin="0,0,0,10"
                                          Checked="MolecularWeightCheckBox_Changed"
                                          Unchecked="MolecularWeightCheckBox_Changed" />

                                <TextBlock Text="Y軸モード"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="MolecularWeightYModeComboBox"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          IsEnabled="False"
                                          SelectedIndex="0"
                                          SelectionChanged="MolecularWeightYModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Signal" Tag="Signal" />
                                    <ComboBoxItem Content="dw/dlogM" Tag="DwdLogM" />
                                </ComboBox>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky footer: defaults -->
                <Border Grid.Row="2"
                        Background="#E2E8F0"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ResetGraphSettingsButton"
                                Grid.Column="0"
                                Content="既定に戻す"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ResetGraphSettingsButton_Click" />
                        <Button x:Name="SaveDefaultFormattingButton"
                                Grid.Column="2"
                                Content="既定保存"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SaveDefaultFormattingButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN AREA ================= -->
        <Grid Grid.Column="1" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
                <Button x:Name="SaveGraphButton"
                        DockPanel.Dock="Right"
                        Content="PNG / SVG 保存"
                        Height="34"
                        Padding="18,0"
                        IsEnabled="False"
                        Click="SaveGraphButton_Click" />
                <TextBlock Text="Chromatogram"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
            </DockPanel>

            <Border x:Name="PlotContainerBorder"
                    Grid.Row="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    SizeChanged="PlotContainerBorder_SizeChanged">
                <Grid x:Name="PlotHost">
                    <TextBlock x:Name="PlotPlaceholderTextBlock"
                               Text="グラフを初期化しています..."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#64748B" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,12,0,0">
                <TextBlock x:Name="StatisticsTextBlock"
                           Text="Mn: -   Mw: -   PDI: -"
                           Foreground="#0F172A"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <StatusBar Grid.Row="3" Margin="0,8,0,0" Background="Transparent">
                <TextBlock x:Name="StatusTextBlock"
                           Text="CSVまたはLabSolutions TXTを開いてください。"
                           Foreground="#475569" />
            </StatusBar>
        </Grid>
    </Grid>
</Window>
