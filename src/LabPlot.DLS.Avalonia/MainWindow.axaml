<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.DLS.Avalonia"
        x:Class="LabPlot.DLS.Avalonia.MainWindow"
        Title="DLS Analyzer"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="860" MinHeight="660" Width="1280" MinWidth="960"
        Background="{DynamicResource MainBgSurfaceBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full">

    <!-- Phase 7 Batch 3a: WPF MainWindow.xaml の Avalonia 版。WindowChrome は
         ExtendClientAreaToDecorationsHint=True + ChromeHints=NoChrome で代替し、
         ScottPlot.WPF の WpfPlot は ScottPlot.Avalonia の AvaPlot に code-behind
         で差し替える。XAML の構造は WPF 版と同じ：CustomTitleBar + 360 px サイドバー
         (8 セクション + sticky footer) + main area (header + plot container + status)。 -->

    <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*">

            <!-- ================= TITLE BAR ================= -->
            <controls:CustomTitleBar Grid.Row="0"
                                     Name="MainTitleBar"
                                     AppName="DLS Analyzer"
                                     Subtitle="Particle size visualizer"
                                     AppIconData="M 2,16 C 5,16 6.5,4 10,4 C 13.5,4 15,16 18,16" />

            <Grid Grid.Row="1" ColumnDefinitions="360,*">

                <!-- ================= SIDEBAR ================= -->
                <Border Grid.Column="0"
                        Background="#EEF2F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- サイドバータブ切替 (セグメントコントロール) -->
                        <Border Grid.Row="0"
                                Background="#E2E8F0"
                                CornerRadius="8"
                                Padding="3"
                                Margin="20,10,20,0">
                            <Grid ColumnDefinitions="*,*">
                                <RadioButton Name="DataTabRadioButton"
                                             Grid.Column="0"
                                             GroupName="SidebarTabGroup"
                                             Content="データ"
                                             IsChecked="True"
                                             Theme="{DynamicResource SidebarTabRadioButtonStyle}"
                                             Margin="0,0,2,0"
                                             IsCheckedChanged="SidebarTabRadioButton_IsCheckedChanged" />
                                <RadioButton Name="FormatTabRadioButton"
                                             Grid.Column="1"
                                             GroupName="SidebarTabGroup"
                                             Content="仕上げ"
                                             Theme="{DynamicResource SidebarTabRadioButtonStyle}"
                                             Margin="2,0,0,0"
                                             IsCheckedChanged="SidebarTabRadioButton_IsCheckedChanged" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      Name="SidebarScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                            <StackPanel Name="DataTabPanel" Margin="20,10,20,12">

                                <!-- Section: File -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DataFileIconGeometry}" />
                                                <TextBlock Text="データファイル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenButton"
                                                    Content="DLS xlsx を開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="Zetasizer の xlsx データを開く (Ctrl+O)"
                                                    Click="OpenButton_Click" />
                                            <!-- v1.3 Batch E: 最近開いたファイル (MRU)。直近 5 件まで永続化し、
                                                 選択するとそのまま ImportWorkbookAsync に渡す。 -->
                                            <TextBlock Text="最近開いた"
                                                       Theme="{DynamicResource FieldLabelStyle}"
                                                       Margin="0,10,0,4" />
                                            <ComboBox Name="RecentFilesComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="(履歴なし)"
                                                      IsEnabled="False"
                                                      SelectionChanged="RecentFilesComboBox_SelectionChanged"
                                                      ToolTip.Tip="直近に開いた xlsx (最大 5 件) を選んで再読み込みします。右クリックで履歴をクリア。">
                                                <ComboBox.ContextMenu>
                                                    <ContextMenu>
                                                        <!-- v1.3.5: ContextMenu 単独 MenuItem は Avalonia Fluent default の
                                                             Icon Column 空白で「文字が中途半端に左寄り」に見える。
                                                             trash 風 Path を Icon に入れて空きカラムを塞ぐと、視覚的に
                                                             バランスが取れて「履歴消去」のニュアンスも伝わる。 -->
                                                        <MenuItem Header="履歴をクリア"
                                                                  Click="ClearRecentFilesMenuItem_Click">
                                                            <MenuItem.Icon>
                                                                <Path Width="14" Height="14"
                                                                      Stroke="#475569"
                                                                      StrokeThickness="1.4"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      Fill="Transparent"
                                                                      Data="M 2.5,4 L 13.5,4 M 5,4 L 5,2.8 L 11,2.8 L 11,4 M 4,4.5 L 4.8,13.2 L 11.2,13.2 L 12,4.5 M 6.5,6.5 L 6.5,11.5 M 9.5,6.5 L 9.5,11.5" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </ComboBox.ContextMenu>
                                            </ComboBox>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Loaded datasets -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander Name="DatasetListExpander" IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DatasetListIconGeometry}" />
                                                <TextBlock Text="読み込み済みデータセット"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="#F8FAFC">
                                                <Grid>
                                                    <ListBox Name="DatasetListBox"
                                                             SelectionMode="Multiple"
                                                             SelectionChanged="DatasetListBox_SelectionChanged"
                                                             MinHeight="120"
                                                             MaxHeight="280"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Padding="0"
                                                             DragDrop.AllowDrop="True">
                                                        <!-- v1.3.5: 複数選択中の sheet/run が一目で分かるよう、
                                                             :selected 時に左 3px のアクセント帯と薄い blue 背景を出す。
                                                             ContentPresenter 側に BorderThickness を寄せることで
                                                             選択切替時にレイアウトシフトが起きないように固定枠を確保する。 -->
                                                        <ListBox.Styles>
                                                            <Style Selector="ListBoxItem">
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0,1" />
                                                            </Style>
                                                            <Style Selector="ListBoxItem /template/ ContentPresenter">
                                                                <Setter Property="Padding" Value="7,5,8,5" />
                                                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="CornerRadius" Value="0" />
                                                            </Style>
                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#F1F5F9" />
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#DBEAFE" />
                                                                <Setter Property="BorderBrush" Value="#2563EB" />
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#BFDBFE" />
                                                                <Setter Property="BorderBrush" Value="#1D4ED8" />
                                                            </Style>
                                                        </ListBox.Styles>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DlsDatasetItem">
                                                                <Grid ColumnDefinitions="Auto,*">
                                                                    <Border Grid.Column="0"
                                                                            Width="14" Height="14"
                                                                            Background="{CompiledBinding ColorBrush}"
                                                                            CornerRadius="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="2,0,8,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{CompiledBinding SheetName}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Name="DatasetListPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,18,8,18"
                                                                IsHitTestVisible="False">
                                                        <Path Width="32" Height="32"
                                                              Stretch="None"
                                                              Stroke="#94A3B8"
                                                              StrokeThickness="1.5"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                                        <TextBlock Text="ここに xlsx をドロップ"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,2" />
                                                        <TextBlock Text="または上のボタンから開く"
                                                                   FontSize="11"
                                                                   Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <Rectangle Name="DatasetDropOverlay"
                                                               Stroke="#2563EB"
                                                               StrokeThickness="2"
                                                               StrokeDashArray="3,2"
                                                               Fill="#4DDBEAFE"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               IsHitTestVisible="False"
                                                               IsVisible="False" />
                                                    <!-- Phase 7 Batch 6 step 4: 内部 reorder 用 Insertion Line。
                                                         GPC / Spectrum 同形で ListBox と同じ Grid 階層に配置し、
                                                         Margin.Top をリアルタイム計算してドロップ先指示子として表示する。 -->
                                                    <Grid Name="InsertionLine"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Top"
                                                          Height="6"
                                                          Margin="0"
                                                          IsVisible="False"
                                                          IsHitTestVisible="False">
                                                        <Grid.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Color="#2563EB"
                                                                              Opacity="0.55"
                                                                              OffsetX="0"
                                                                              OffsetY="0" />
                                                        </Grid.Effect>
                                                        <Rectangle Height="2"
                                                                   VerticalAlignment="Center"
                                                                   Fill="#2563EB"
                                                                   Opacity="0.85" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       TextWrapping="Wrap"
                                                       Text="Ctrl/Shift クリックで複数選択して重ね描きできます (Ctrl+L : 全選択／全解除)" />
                                            <TextBlock Name="DatasetCountText"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       Text="ファイル未読み込み" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Line style (active sheet) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource LineStyleIconGeometry}" />
                                                <TextBlock Text="線スタイル"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Name="ActiveDatasetLabel"
                                                           Text="(選択中シート)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,0,2" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="色" Theme="{DynamicResource FieldLabelStyle}" />
                                            <controls:ColorPickerPanel Name="LineColorPicker"
                                                                        AllowAuto="True"
                                                                        DefaultHex="#2563EB"
                                                                        Margin="0,0,0,10"
                                                                        ColorChanged="LineColorPicker_ColorChanged">
                                                <controls:ColorPickerPanel.Presets>
                                                <ComboBoxItem Tag="Auto" IsSelected="True">
                                                    <TextBlock Text="Auto" />
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="Custom">
                                                    <TextBlock Text="Custom" />
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#2563EB">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Blue" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#DC2626">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Red" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#16A34A">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Green" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#EA580C">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Orange" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#7C3AED">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Purple" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#0891B2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Cyan" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#BE123C">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Rose" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#4B5563">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Gray" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                </controls:ColorPickerPanel.Presets>
                                            </controls:ColorPickerPanel>

                                            <TextBlock Text="凡例名" Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="LegendNameTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,10"
                                                     ToolTip.Tip="凡例名を編集（F2 でフォーカス）"
                                                     TextChanged="LegendNameTextBox_TextChanged" />

                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="線幅" Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="LineWidthTextBox"
                                                             Text="1.5"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="LineWidthTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="マーカー" Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="MarkerSizeTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="MarkerSizeTextBox_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Analysis (opens AnalysisWindow with all 5 tabs incl. metadata) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="M 1,12 Q 4,12 5,9 Q 7,2 9,9 Q 10,12 13,12" />
                                                <TextBlock Text="解析"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenAnalysisWindowButton"
                                                    Content="解析ウィンドウを開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="キュムラント / 温度ランプ / 濃度シリーズ / CONTIN を別ウィンドウの Tab で開きます"
                                                    Click="OpenAnalysisWindowButton_Click" />
                                            <TextBlock Text="シート切替やメタデータ編集をしながら参照できます。"
                                                       FontSize="11"
                                                       Foreground="#94A3B8"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Display (distribution / run) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="M 1,7 Q 7,2 13,7 Q 7,12 1,7 Z M 6,7 A 1,1 0 1 0 8,7 A 1,1 0 1 0 6,7 Z" />
                                                <TextBlock Text="表示"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Theme="{DynamicResource FieldLabelStyle}" Text="分布の種類" />
                                            <ComboBox Name="DistributionTypeComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      SelectionChanged="DistributionTypeComboBox_SelectionChanged"
                                                      Margin="0,0,0,8">
                                                <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                                <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                                <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                                <ComboBoxItem Content="自己相関 g₂-1" Tag="Correlation" />
                                                <ComboBoxItem Content="温度ランプ T vs d_h" Tag="TemperatureRamp" />
                                                <ComboBoxItem Content="濃度シリーズ c vs D" Tag="ConcentrationSeries" />
                                                <ComboBoxItem Content="サイズ分布逆変換 (CONTIN-like)" Tag="SizeDistributionInversion" />
                                            </ComboBox>

                                            <TextBlock Theme="{DynamicResource FieldLabelStyle}" Text="Run" />
                                            <ComboBox Name="RunComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      SelectionChanged="RunComboBox_SelectionChanged"
                                                      IsEnabled="False" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Analysis session — GPC/Spectrum と同じくセッション保存/復元
                                     なのでデータタブ側に置く -->
                                <Border Theme="{DynamicResource SectionStyle}"
                                        ToolTip.Tip="解析の状態（データ・線スタイル・測定条件・キュムラント解析・軸範囲・グラフ書式）を .dlsjson に書き出します。読み込み直せば同じ解析をそのまま復元できます。"
                                        ToolTip.ShowDelay="400">
                                    <Expander Name="SessionExpander" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AnalysisConditionsIconGeometry}" />
                                                <TextBlock Text="解析条件"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="SaveSessionButton"
                                                    Content="解析条件を保存"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    Margin="0,0,0,8"
                                                    ToolTip.Tip="解析条件を .dlsjson に保存 (Ctrl+Shift+S)"
                                                    Click="SaveSessionButton_Click" />
                                            <Button Name="LoadSessionButton"
                                                    Content="解析条件を読み込み"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="解析条件 (.dlsjson) を読み込み (Ctrl+Shift+O)"
                                                    Click="LoadSessionButton_Click" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                            </StackPanel>
                            <StackPanel Name="FormatTabPanel" Margin="20,10,20,12" IsVisible="False">

                                <!-- Section: Axis range -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AxisRangeIconGeometry}" />
                                                <TextBlock Text="軸範囲"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:AxisRangePanel Name="AxisRangePanel"
                                                                 XAxisLabel="粒径軸 (nm)"
                                                                 YAxisLabel="Y 軸 (%)"
                                                                 NumberFormat="G6"
                                                                 AxisRangeCommitted="AxisRangePanel_Committed"
                                                                 CaptureCurrentRangeRequested="AxisRangePanel_CaptureCurrentRangeRequested"
                                                                 Margin="0,8,0,0" />
                                    </Expander>
                                </Border>

                                <!-- Section: Graph labels -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphLabelIconGeometry}" />
                                                <TextBlock Text="グラフラベル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="タイトル" Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="TitleTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,8,*">
                                                <CheckBox Name="TitleVisibleCheckBox"
                                                          Grid.Column="0"
                                                          Content="表示する"
                                                          IsChecked="True"
                                                          IsCheckedChanged="FormatCheckBox_Changed" />
                                                <CheckBox Name="TitleBoldCheckBox"
                                                          Grid.Column="2"
                                                          Content="太字"
                                                          IsChecked="True"
                                                          IsCheckedChanged="FormatCheckBox_Changed" />
                                            </Grid>

                                            <TextBlock Text="X軸ラベル" Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="XLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,8"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />

                                            <TextBlock Text="Y軸ラベル" Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="YLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <CheckBox Name="AxisLabelBoldCheckBox"
                                                      Content="軸ラベルを太字"
                                                      Margin="0,0,0,0"
                                                      IsCheckedChanged="FormatCheckBox_Changed" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Graph appearance -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander Name="FormattingExpander" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphFormatIconGeometry}" />
                                                <TextBlock Text="グラフ書式"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:GraphFormatPanel Name="GraphFormatPanel"
                                                                   GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                                   AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />
                                    </Expander>
                                </Border>

                                <!-- Section: App preferences -->
                                <Border Theme="{DynamicResource SectionStyle}"
                                        ToolTip.Tip="ここで設定した既定値は、画面下部の「既定値として保存」を押すと次回起動時の初期状態として永続化されます。"
                                        ToolTip.ShowDelay="400">
                                    <Expander Name="PreferencesExpander" IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource PreferencesIconGeometry}" />
                                                <TextBlock Text="環境設定"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="既定の出力フォルダ"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <Grid Margin="0,0,0,12" ColumnDefinitions="*,6,Auto">
                                                <TextBox Name="DefaultOutputDirectoryTextBox"
                                                         Grid.Column="0"
                                                         Theme="{DynamicResource InputTextBoxStyle}"
                                                         ToolTip.Tip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                                <Button Grid.Column="2"
                                                        Content="参照"
                                                        Theme="{DynamicResource SecondaryButtonStyle}"
                                                        Click="BrowseDefaultOutputDirectoryButton_Click" />
                                            </Grid>

                                            <TextBlock Theme="{DynamicResource FieldLabelStyle}" Text="既定の分布" />
                                            <ComboBox Name="DefaultDistributionComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      SelectionChanged="FormatComboBox_SelectionChanged"
                                                      Margin="0,0,0,8">
                                                <ComboBoxItem Content="Number (%)" Tag="Number" IsSelected="True" />
                                                <ComboBoxItem Content="Intensity (%)" Tag="Intensity" />
                                                <ComboBoxItem Content="Volume (%)" Tag="Volume" />
                                            </ComboBox>

                                            <TextBlock Theme="{DynamicResource FieldLabelStyle}" Text="既定の Run (0 始まり)" />
                                            <TextBox Name="DefaultRunIndexTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Text="0"
                                                     TextChanged="FormatTextBox_TextChanged" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Sticky footer: defaults。WPF 版の DropShadowEffect (dir=90 / depth=3 / blur=10 / opacity=0.10)
                             相当を BoxShadow="0 -3 10 0 #1A0F172A" で再現。 -->
                        <Border Grid.Row="2"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="0,1,0,0"
                                Padding="20,12,20,14"
                                BoxShadow="0 -3 10 0 #1A0F172A">
                            <StackPanel>
                                <TextBlock Text="既定値（次回起動時の初期状態）"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8" />
                                <Grid ColumnDefinitions="*,10,*">
                                    <Button Name="ResetGraphSettingsButton"
                                            Grid.Column="0"
                                            Content="既定値に戻す"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                            Click="ResetGraphSettingsButton_Click" />
                                    <Button Name="SaveDefaultFormattingButton"
                                            Grid.Column="2"
                                            Content="既定値として保存"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                            Click="SaveDefaultFormattingButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN AREA ================= -->
                <Grid Grid.Column="1" Margin="24,22,24,18" RowDefinitions="Auto,*,Auto">

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                        <Button Name="SaveGraphButton"
                                DockPanel.Dock="Right"
                                Content="PNG / SVG 保存"
                                Theme="{DynamicResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                ToolTip.Tip="グラフを PNG / SVG で保存 (Ctrl+S)"
                                Click="SaveGraphButton_Click" />
                        <Button Name="ExportButton"
                                DockPanel.Dock="Right"
                                Content="データ出力"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                ToolTip.Tip="データを CSV / xlsx で出力 (Ctrl+E)"
                                Click="ExportButton_Click" />
                        <TextBlock Text="Particle size distribution"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B" />
                    </DockPanel>

                    <Border Name="PlotContainerBorder"
                            Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            SizeChanged="PlotContainerBorder_SizeChanged">
                        <Grid>
                            <!-- スケルトン (軸影 + 仮曲線 + シマー帯) は PlotHost の外側に置き、
                                 InitializePlotControl の Children.Clear() で消えないようにする。
                                 IsVisible は C# 側で初期化中のみ true。 -->
                            <Grid Name="PlotPlaceholderSkeleton"
                                  Width="320" Height="200"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Grid Width="320" Height="180"
                                      VerticalAlignment="Top"
                                      ClipToBounds="True">
                                    <Canvas Width="320" Height="180">
                                        <Rectangle Canvas.Left="22" Canvas.Top="20"
                                                   Width="2" Height="140"
                                                   Fill="#E2E8F0" />
                                        <Rectangle Canvas.Left="20" Canvas.Top="158"
                                                   Width="280" Height="2"
                                                   Fill="#E2E8F0" />
                                        <Path Stroke="#CBD5E1"
                                              StrokeThickness="2.5"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="M 30,140 Q 70,140 100,80 Q 130,30 160,80 Q 190,140 230,120 Q 260,100 290,140" />
                                    </Canvas>
                                    <Border Name="ShimmerBand"
                                            Classes="shimmer"
                                            Width="120" Height="180"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-120" />
                                        </Border.RenderTransform>
                                        <!-- Border.shimmer Animation は ImplicitStyles.axaml で
                                             共通化 (Phase 7 ブラッシュアップ B8)。Classes だけ
                                             ここで指定すれば自動で走る。 -->
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- ScottPlot コントロールはここに動的に挿入される。
                                 InitializePlotControl で Children.Clear() するため、
                                 操作ヒントバッジ・スケルトン・placeholder は PlotHost の外側に置く。 -->
                            <Grid Name="PlotHost" />
                            <!-- placeholder TextBlock は 3 状態 (Initializing / EmptyReady / InitFailed) を
                                 PlotPlaceholder ヘルパー経由で文言と IsVisible で切り替える。 -->
                            <TextBlock Name="PlotPlaceholderTextBlock"
                                       Text="グラフを初期化しています..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,116,0,0"
                                       IsHitTestVisible="False" />
                            <Border Name="PlotControlsHintBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Help"
                                    ToolTip.Placement="Bottom"
                                    ToolTip.ShowDelay="200">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="プロット操作"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                        <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                        <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                        <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                        <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                        <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <!-- 情報 i アイコン: 円 + 縦バー (WPF 版の GeometryGroup を StreamGeometry 1 本にまとめた) -->
                                <Path Width="3" Height="9"
                                      Fill="#475569"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Data="M 1.5,0 A 1.25,1.25 0 1 0 1.5,2.5 A 1.25,1.25 0 1 0 1.5,0 Z M 0.25,3.75 H 2.75 V 9 H 0.25 Z" />
                            </Border>
                            <controls:ErrorBanner Name="ErrorBanner" />
                            <controls:BusyOverlay Name="BusyOverlay" />
                            <!-- v1.3 Batch B: 「保存しました」「既定値を更新しました」など瞬間 OK 系の
                                 フィードバックを 2 秒で消える浮遊バナーで通知する。 -->
                            <controls:ToastHost Name="Toast" />
                        </Grid>
                    </Border>

                    <!-- v1.3 Batch A: 旧 StatusTextBlock を共通 StatusBar control に置換。
                         severity (None/Info/Success/Warning/Error) ごとに先頭 14px アイコンと
                         前景色が切り替わる。初期メッセージは Info severity で表示する。 -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
                        <controls:StatusBar Name="StatusBar" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
