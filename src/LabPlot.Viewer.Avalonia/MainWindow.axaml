<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.Viewer.Avalonia"
        x:Class="LabPlot.Viewer.Avalonia.MainWindow"
        Title="Data Viewer"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="860" MinHeight="660" Width="1280" MinWidth="960"
        Background="{DynamicResource MainBgSurfaceBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full"
        DragDrop.AllowDrop="True">

    <!-- 汎用データビューア B2: GPC MainWindow を雛形にした最小構成。
         サイドバー = ファイル / 読み込み済みテーブル / 系列スタイル / 軸範囲 /
         グラフラベル / グラフ書式。列マッピング UI とクリップボード貼り付けは
         B3、log・右軸は B4、セッション・エクスポート・MRU は B5 で追加する。 -->

    <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*">

            <!-- ================= TITLE BAR ================= -->
            <controls:CustomTitleBar Grid.Row="0"
                                     Name="MainTitleBar"
                                     AppName="Data Viewer"
                                     Subtitle="Tabular data viewer"
                                     AppIconData="M 3,3 L 3,17 L 17,17 M 6,13 L 9,8 L 12,11 L 16,5" />

            <Grid Grid.Row="1" ColumnDefinitions="360,*">

                <!-- ================= SIDEBAR ================= -->
                <Border Grid.Column="0"
                        Background="#EEF2F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto">

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,10,20,12">

                                <ContentControl Content="データ"
                                                Theme="{DynamicResource GroupHeaderStyle}" />

                                <!-- Section: File -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DataFileIconGeometry}" />
                                                <TextBlock Text="データファイル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenFileButton"
                                                    Content="CSV / TSV / xlsx を開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,8"
                                                    ToolTip.Tip="表形式データを開く (Ctrl+O)"
                                                    Click="OpenFileButton_Click" />
                                            <TextBlock Text="CSV / TSV / セミコロン / 空白区切りのテキストと Excel ブック (.xlsx) を読み込めます。1 列目（最初の数値列）が X、残りの数値列が Y 系列になります。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Loaded tables -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DatasetListIconGeometry}" />
                                                <TextBlock Text="読み込み済みテーブル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="#F8FAFC">
                                                <Grid>
                                                    <ListBox Name="TableListBox"
                                                             MinHeight="120"
                                                             MaxHeight="180"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             SelectionChanged="TableListBox_SelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MainWindow+TableEntryVm">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Grid.Column="0"
                                                                            Width="14" Height="14"
                                                                            Background="{CompiledBinding ColorBrush}"
                                                                            CornerRadius="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="2,0,8,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{CompiledBinding DisplayName}"
                                                                               ToolTip.Tip="{CompiledBinding FullPath}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2"
                                                                            Content="×"
                                                                            Theme="{DynamicResource IconButtonStyle}"
                                                                            VerticalAlignment="Center"
                                                                            Tag="{CompiledBinding}"
                                                                            Click="RemoveTableButton_Click"
                                                                            ToolTip.Tip="削除" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Name="TableListPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,18,8,18"
                                                                IsHitTestVisible="False">
                                                        <Path Width="32" Height="32"
                                                              Stretch="None"
                                                              Stroke="#94A3B8"
                                                              StrokeThickness="1.5"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                                        <TextBlock Text="ここにファイルをドロップ"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,2" />
                                                        <TextBlock Text="または上のボタンから開く"
                                                                   FontSize="11"
                                                                   Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <Rectangle Name="TableDropOverlay"
                                                               Stroke="#2563EB"
                                                               StrokeThickness="2"
                                                               StrokeDashArray="3,2"
                                                               Fill="#4DDBEAFE"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               IsHitTestVisible="False"
                                                               IsVisible="False" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Series style -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource LineStyleIconGeometry}" />
                                                <TextBlock Text="系列スタイル"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Name="ActiveSeriesLabel"
                                                           Text="(系列未選択)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,0,2" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">

                                            <TextBlock Text="系列"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="SeriesComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,10"
                                                      PlaceholderText="(系列なし)"
                                                      ToolTip.Tip="スタイルを編集する系列を選択"
                                                      SelectionChanged="SeriesComboBox_SelectionChanged" />

                                            <TextBlock Text="色"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <controls:ColorPickerPanel Name="LineColorPicker"
                                                                        AllowAuto="True"
                                                                        DefaultHex="#2563EB"
                                                                        Margin="0,0,0,10"
                                                                        ColorChanged="LineColorPicker_ColorChanged">
                                                <controls:ColorPickerPanel.Presets>
                                                    <ComboBoxItem Tag="Auto" IsSelected="True">
                                                        <TextBlock Text="Auto" />
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="Custom">
                                                        <TextBlock Text="Custom" />
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#2563EB">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Blue" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#DC2626">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Red" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#16A34A">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Green" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#EA580C">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Orange" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#7C3AED">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Purple" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#0891B2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Cyan" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#BE123C">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Rose" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                    <ComboBoxItem Tag="#4B5563">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                                            <TextBlock Text="Gray" />
                                                        </StackPanel>
                                                    </ComboBoxItem>
                                                </controls:ColorPickerPanel.Presets>
                                            </controls:ColorPickerPanel>

                                            <TextBlock Text="凡例名"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="LegendNameTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,10"
                                                     ToolTip.Tip="凡例名を編集（F2 でフォーカス）"
                                                     TextChanged="LegendNameTextBox_TextChanged" />

                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="線幅"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="LineWidthTextBox"
                                                             Text="1.5"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="StyleNumberTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="マーカー"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="MarkerSizeTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="StyleNumberTextBox_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <ContentControl Content="書式"
                                                Theme="{DynamicResource GroupHeaderStyle}" />

                                <!-- Section: Axis range -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AxisRangeIconGeometry}" />
                                                <TextBlock Text="軸範囲"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:AxisRangePanel Name="AxisRangePanel"
                                                                 Margin="0,8,0,0"
                                                                 XAxisLabel="X"
                                                                 YAxisLabel="Y"
                                                                 NumberFormat="G6"
                                                                 AxisRangeCommitted="AxisRangePanel_Committed" />
                                    </Expander>
                                </Border>

                                <!-- Section: Graph labels -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphLabelIconGeometry}" />
                                                <TextBlock Text="グラフラベル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="タイトル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="TitleTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,8,*">
                                                <CheckBox Name="TitleVisibleCheckBox"
                                                          Grid.Column="0"
                                                          Content="表示する"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                                <CheckBox Name="TitleBoldCheckBox"
                                                          Grid.Column="2"
                                                          Content="太字"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                            </Grid>

                                            <TextBlock Text="X軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="XLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,8"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />

                                            <TextBlock Text="Y軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="YLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <CheckBox Name="AxisLabelBoldCheckBox"
                                                      Content="軸ラベルを太字"
                                                      Margin="0,0,0,0"
                                                      IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Graph appearance -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphFormatIconGeometry}" />
                                                <TextBlock Text="グラフ書式"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:GraphFormatPanel Name="GraphFormatPanel"
                                                                   GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                                   AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />
                                    </Expander>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky footer: defaults -->
                        <Border Grid.Row="1"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="0,1,0,0"
                                Padding="20,12,20,14"
                                BoxShadow="0 3 10 0 #1A0F172A">
                            <StackPanel>
                                <TextBlock Text="既定値（次回起動時の初期状態）"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8" />
                                <Grid ColumnDefinitions="*,10,*">
                                    <Button Name="ResetGraphSettingsButton"
                                            Grid.Column="0"
                                            Content="既定値に戻す"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="グラフ書式・系列スタイルを、保存されている既定値に戻します"
                                            Click="ResetGraphSettingsButton_Click" />
                                    <Button Name="SaveDefaultFormattingButton"
                                            Grid.Column="2"
                                            Content="既定値として保存"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="現在のグラフ書式を、次回起動時の既定値として保存します"
                                            Click="SaveDefaultFormattingButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN AREA ================= -->
                <Grid Grid.Column="1" Margin="24,22,24,18"
                      RowDefinitions="Auto,*,Auto">

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                        <Button Name="SaveGraphButton"
                                DockPanel.Dock="Right"
                                Content="PNG / SVG 保存"
                                Theme="{DynamicResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                ToolTip.Tip="グラフを PNG / SVG で保存 (Ctrl+S)"
                                Click="SaveGraphButton_Click" />
                        <TextBlock Text="Data Viewer"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B" />
                    </DockPanel>

                    <Border Name="PlotContainerBorder"
                            Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            SizeChanged="PlotContainerBorder_SizeChanged">
                        <Grid>
                            <Grid Name="PlotPlaceholderSkeleton"
                                  Width="320" Height="200"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Grid Width="320" Height="180"
                                      VerticalAlignment="Top"
                                      ClipToBounds="True">
                                    <Canvas Width="320" Height="180">
                                        <Rectangle Canvas.Left="22" Canvas.Top="20"
                                                   Width="2" Height="140"
                                                   Fill="#E2E8F0" />
                                        <Rectangle Canvas.Left="20" Canvas.Top="158"
                                                   Width="280" Height="2"
                                                   Fill="#E2E8F0" />
                                        <Path Stroke="#CBD5E1"
                                              StrokeThickness="2.5"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Data="M 30,140 L 80,110 L 130,125 L 180,60 L 230,85 L 290,40" />
                                    </Canvas>
                                    <Border Classes="shimmer"
                                            Width="120" Height="180"
                                            HorizontalAlignment="Left"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-120" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Grid Name="PlotHost" />
                            <TextBlock Name="PlotPlaceholderTextBlock"
                                       Text="グラフを初期化しています..."
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,116,0,0"
                                       IsHitTestVisible="False" />
                            <Border Name="PlotControlsHintBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Help">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="プロット操作"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                        <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                        <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                        <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                        <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <Path Width="3" Height="9"
                                      Fill="#475569"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Data="M 1.5,0 A 1.25,1.25 0 1 0 1.5,2.5 A 1.25,1.25 0 1 0 1.5,0 Z M 0.25,3.75 H 2.75 V 9 H 0.25 Z" />
                            </Border>
                            <controls:ErrorBanner Name="ErrorBanner" />
                            <controls:BusyOverlay Name="BusyOverlay" />
                            <controls:ToastHost Name="Toast" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <controls:StatusBar Name="StatusBar" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
