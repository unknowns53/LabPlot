<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.NMR.Avalonia"
        x:Class="LabPlot.NMR.Avalonia.MainWindow"
        Title="NMR Analyzer"
        Icon="avares://LabPlot.Core.Avalonia/Assets/app-icon.png"
        Height="860" MinHeight="660" Width="1280" MinWidth="960"
        Background="{DynamicResource MainBgSurfaceBrush}"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full">

  <Window.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Window.Styles>

  <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
    <Grid RowDefinitions="Auto,*">

      <!-- ================= TITLE BAR ================= -->
      <controls:CustomTitleBar Grid.Row="0"
                               Name="MainTitleBar"
                               AppName="NMR Analyzer"
                               Subtitle="核磁気共鳴スペクトル"
                               AppIconData="M 2,16 L 6,16 L 7,4 L 8,16 L 11,16 L 12,9 L 13,16 L 18,16" />

      <Grid Grid.Row="1" ColumnDefinitions="300,*,340">

        <!-- ================= SIDEBAR ================= -->
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20,10,20,16" Spacing="12">

            <Button Content="JDF を開く"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Theme="{DynamicResource PrimaryButtonStyle}"
                    Click="OpenButton_Click" />

            <CheckBox x:Name="OverlayCheckBox"
                      Content="重ね描き (Overlay)"
                      ToolTip.Tip="複数の .jdf を重ねて表示する"
                      IsCheckedChanged="OverlayCheckBox_Changed" />

            <!-- 読み込み済みデータセット -->
            <Border Theme="{DynamicResource SectionStyle}">
              <StackPanel Spacing="8">
                <TextBlock Text="読み込み済みデータセット" Theme="{DynamicResource SectionHeaderStyle}" />
                <Grid>
                  <ListBox x:Name="DatasetListBox"
                           MinHeight="90" MaxHeight="200"
                           BorderThickness="0"
                           Background="Transparent"
                           SelectionChanged="DatasetListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MainWindow+DatasetEntryVm">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Grid.Column="0" Width="14" Height="14"
                                  Background="{CompiledBinding ColorBrush}"
                                  CornerRadius="2" Margin="0,0,8,0"
                                  VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1"
                                     Text="{CompiledBinding DisplayName}"
                                     ToolTip.Tip="{CompiledBinding FullPath}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="2" Content="×"
                                  Theme="{DynamicResource IconButtonStyle}"
                                  Tag="{CompiledBinding}"
                                  ToolTip.Tip="削除"
                                  Click="RemoveDatasetButton_Click" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="DatasetListPlaceholder"
                             Text="まだデータがありません"
                             Foreground="#94A3B8"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- 線スタイル (選択中データセット) -->
            <Border Theme="{DynamicResource SectionStyle}">
              <StackPanel Spacing="8">
                <TextBlock x:Name="ActiveDatasetLabel"
                           Text="(選択中データセット)"
                           Theme="{DynamicResource SectionHeaderStyle}" />

                <TextBlock Text="線の色" Theme="{DynamicResource FieldLabelStyle}" />
                <controls:ColorPickerPanel x:Name="LineColorPicker"
                                           AllowAuto="True"
                                           DefaultHex="#2563EB"
                                           ColorChanged="LineColorPicker_ColorChanged">
                  <controls:ColorPickerPanel.Presets>
                    <ComboBoxItem Tag="Auto" IsSelected="True">
                      <TextBlock Text="Auto" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Custom">
                      <TextBlock Text="Custom" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#2563EB">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Blue" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#DC2626">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Red" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#16A34A">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Green" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#EA580C">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Orange" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#7C3AED">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Purple" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#0891B2">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Cyan" />
                      </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="#4B5563">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                        <TextBlock Text="Gray" />
                      </StackPanel>
                    </ComboBoxItem>
                  </controls:ColorPickerPanel.Presets>
                </controls:ColorPickerPanel>

                <TextBlock Text="凡例名" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="LegendNameTextBox"
                         Theme="{DynamicResource InputTextBoxStyle}"
                         Watermark="ファイル名を使用"
                         TextChanged="LegendNameTextBox_TextChanged" />

                <TextBlock Text="線の太さ" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="LineWidthTextBox"
                         Text="1.5"
                         Theme="{DynamicResource InputTextBoxStyle}"
                         TextChanged="LineWidthTextBox_TextChanged" />

                <TextBlock Text="マーカーサイズ" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="MarkerSizeTextBox"
                         Text="0"
                         Theme="{DynamicResource InputTextBoxStyle}"
                         TextChanged="MarkerSizeTextBox_TextChanged" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================= PLOT ================= -->
        <Border Name="PlotContainerBorder"
                Grid.Column="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Margin="0,10,12,16"
                DragDrop.AllowDrop="True">
          <Grid RowDefinitions="Auto,*">
            <TextBlock x:Name="StatusText"
                       Grid.Row="0"
                       Margin="14,10,14,6"
                       Foreground="#475569"
                       Text="JEOL .jdf ファイルを開いてください。" />
            <Grid Grid.Row="1">
              <Grid Name="PlotHost" />
              <controls:ToastHost Name="Toast" />
            </Grid>
          </Grid>
        </Border>

        <!-- ================= ANALYSIS PANEL ================= -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" Margin="0,10,16,16">
          <StackPanel Spacing="12">

            <!-- ピーク検出 -->
            <Border Theme="{DynamicResource SectionStyle}">
              <StackPanel Spacing="8">
                <TextBlock Text="ピーク検出" Theme="{DynamicResource SectionHeaderStyle}" />

                <TextBlock Text="最小強度" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="PeakMinIntensityTextBox" Text="0.05" Theme="{DynamicResource InputTextBoxStyle}" />
                <TextBlock Text="プロミネンス" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="PeakProminenceTextBox" Text="0.02" Theme="{DynamicResource InputTextBoxStyle}" />
                <TextBlock Text="最大ピーク数" Theme="{DynamicResource FieldLabelStyle}" />
                <TextBox x:Name="PeakMaxCountTextBox" Text="20" Theme="{DynamicResource InputTextBoxStyle}" />

                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                  <Button x:Name="DetectPeaksButton" Grid.Column="0" Content="検出" Margin="0,0,4,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Theme="{DynamicResource SecondaryButtonStyle}"
                          Click="DetectPeaksButton_Click" />
                  <Button Grid.Column="1" Content="クリア" Margin="4,0,0,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Theme="{DynamicResource SecondaryButtonStyle}"
                          Click="ClearPeaksButton_Click" />
                </Grid>

                <ItemsControl x:Name="PeakList" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MainWindow+PeakRowVm">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{CompiledBinding PpmText}" />
                        <TextBlock Grid.Column="1" Text="{CompiledBinding IntensityText}" Foreground="#64748B" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- 積分 -->
            <Border Theme="{DynamicResource SectionStyle}">
              <StackPanel Spacing="8">
                <TextBlock Text="積分 (面積比)" Theme="{DynamicResource SectionHeaderStyle}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="開始 ppm" Theme="{DynamicResource FieldLabelStyle}" />
                    <TextBox x:Name="RegionMinTextBox" Theme="{DynamicResource InputTextBoxStyle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="終了 ppm" Theme="{DynamicResource FieldLabelStyle}" />
                    <TextBox x:Name="RegionMaxTextBox" Theme="{DynamicResource InputTextBoxStyle}" />
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="RegionLinearBaselineCheckBox" Content="線形ベースライン" IsChecked="True" />
                <Button x:Name="AddRegionButton" Content="範囲を追加"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Theme="{DynamicResource SecondaryButtonStyle}"
                        Click="AddRegionButton_Click" />

                <DataGrid x:Name="IntegrationGrid"
                          x:DataType="vm:MainWindow+IntegrationRowVm"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          IsReadOnly="True"
                          MinHeight="80" MaxHeight="220"
                          SelectionChanged="IntegrationGrid_SelectionChanged">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="範囲" Binding="{CompiledBinding RangeText}" Width="*" MinWidth="90" />
                    <DataGridTextColumn Header="面積" Binding="{CompiledBinding AreaText}" Width="80" />
                    <DataGridTextColumn Header="比" Binding="{CompiledBinding RatioText}" Width="60" />
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="行を選ぶとその範囲が基準 (比 = 1) になります。"
                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                <Button Content="選択した範囲を削除"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Theme="{DynamicResource SecondaryButtonStyle}"
                        Click="RemoveRegionButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
