<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone console harness that drives LabPlot.Shell.Avalonia's windows through
       Avalonia.Headless to render user-guide screenshots off-screen (no real desktop
       window, no touching the operator's own AppData). Intentionally kept out of
       LabPlot.slnx, same as tools/DlsSampleGenerator, so it does not get pulled into
       the publish graph; run with `dotnet run` whenever the docs screenshots need to
       be regenerated, then copy the wanted PNGs from artifacts/screenshots/ into
       docs/. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LabPlot.Tools.Screenshots</RootNamespace>
    <AssemblyName>LabPlot.Screenshots</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LabPlot.Shell.Avalonia\LabPlot.Shell.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.14" />
  </ItemGroup>

</Project>
