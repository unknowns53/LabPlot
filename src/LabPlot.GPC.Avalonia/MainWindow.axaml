<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LabPlot.Core.Avalonia.Controls"
        xmlns:vm="using:LabPlot.GPC.Avalonia"
        x:Class="LabPlot.GPC.Avalonia.MainWindow"
        Title="GPC Analyzer" Height="860" MinHeight="660" Width="1240" MinWidth="960"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="Full"
        DragDrop.AllowDrop="True">

    <!-- Phase 7 Batch 4a: WPF MainWindow.xaml の Avalonia 版。WindowChrome は
         ExtendClientAreaToDecorationsHint=True + ChromeHints=NoChrome で代替し、
         ScottPlot.WPF の WpfPlot は ScottPlot.Avalonia の AvaPlot に code-behind
         で差し替える。XAML の構造は WPF 版と同じ：CustomTitleBar + 360 px サイドバー
         (8 セクション + sticky footer) + main area (header + plot container + status)。
         InsertionAdorner 相当はこの段階では未実装で、Batch 4b で再実装する。 -->

    <!-- Border.shimmer Animation は Phase 7 ブラッシュアップ B8 で
         Core.Avalonia/Themes/ImplicitStyles.axaml に移管済み。 -->

    <Border Name="ChromeRoot" Theme="{DynamicResource WindowChromeRootBorderStyle}">
        <Grid RowDefinitions="Auto,*">

            <!-- ================= TITLE BAR ================= -->
            <controls:CustomTitleBar Grid.Row="0"
                                     AppName="GPC Analyzer"
                                     Subtitle="Chromatogram visualizer"
                                     AppIconData="M 2,16 L 6,16 L 8,11 L 10,3 L 12,11 L 14,16 L 18,16" />

            <Grid Grid.Row="1" ColumnDefinitions="360,*">

                <!-- ================= SIDEBAR ================= -->
                <Border Grid.Column="0"
                        Background="#EEF2F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto">

                        <!-- Scrollable sections -->
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,10,20,12">

                                <ContentControl Content="データ"
                                                Theme="{DynamicResource GroupHeaderStyle}" />

                                <!-- Section: File -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DataFileIconGeometry}" />
                                                <TextBlock Text="データファイル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenCsvButton"
                                                    Content="CSV / TXT を開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10"
                                                    ToolTip.Tip="CSV / TXT データを開く (Ctrl+O)"
                                                    Click="OpenCsvButton_Click" />
                                            <CheckBox Name="OverlayCheckBox"
                                                      Content="重ね描き (Overlay)"
                                                      ToolTip.Tip="複数データセットの重ね描き表示を切替 (Ctrl+L)"
                                                      IsCheckedChanged="OverlayCheckBox_Changed" />
                                            <TextBlock Name="FilePathTextBlock"
                                                       Text=""
                                                       IsVisible="False" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Loaded datasets -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource DatasetListIconGeometry}" />
                                                <TextBlock Text="読み込み済みデータセット"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Background="#F8FAFC">
                                                <Grid>
                                                    <ListBox Name="DatasetListBox"
                                                             MinHeight="120"
                                                             MaxHeight="180"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             DragDrop.AllowDrop="True"
                                                             SelectionChanged="DatasetListBox_SelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MainWindow+DatasetEntryVm">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Grid.Column="0"
                                                                            Width="14" Height="14"
                                                                            Background="{CompiledBinding ColorBrush}"
                                                                            CornerRadius="2"
                                                                            VerticalAlignment="Center"
                                                                            Margin="2,0,8,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{CompiledBinding DisplayName}"
                                                                               ToolTip.Tip="{CompiledBinding FullPath}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2"
                                                                            Content="×"
                                                                            Theme="{DynamicResource IconButtonStyle}"
                                                                            VerticalAlignment="Center"
                                                                            Tag="{CompiledBinding}"
                                                                            Click="RemoveDatasetButton_Click"
                                                                            ToolTip.Tip="削除" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Name="DatasetListPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Margin="8,18,8,18"
                                                                IsHitTestVisible="False">
                                                        <Path Width="32" Height="32"
                                                              Stretch="None"
                                                              Stroke="#94A3B8"
                                                              StrokeThickness="1.5"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round"
                                                              Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              Data="M 6,22 L 6,26 L 26,26 L 26,22 M 16,5 L 16,20 M 10,11 L 16,5 L 22,11" />
                                                        <TextBlock Text="ここにファイルをドロップ"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,2" />
                                                        <TextBlock Text="または上のボタンから開く"
                                                                   FontSize="11"
                                                                   Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <Rectangle Name="DatasetDropOverlay"
                                                               Stroke="#2563EB"
                                                               StrokeThickness="2"
                                                               StrokeDashArray="3,2"
                                                               Fill="#4DDBEAFE"
                                                               RadiusX="4"
                                                               RadiusY="4"
                                                               IsHitTestVisible="False"
                                                               IsVisible="False" />
                                                    <!-- WPF 版 InsertionAdorner の Avalonia 代替。AdornerLayer は無いので
                                                         ListBox と同じ Grid 階層に絶対位置決めの sibling 要素を置き、
                                                         OnDatasetDragOver で Margin と IsVisible を更新する。
                                                         線本体 + 両端ドット + 外周グロー (DropShadow) で視認性を確保する。-->
                                                    <Grid Name="InsertionLine"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Top"
                                                          Height="12"
                                                          Margin="0"
                                                          IsVisible="False"
                                                          IsHitTestVisible="False">
                                                        <Grid.Effect>
                                                            <DropShadowEffect BlurRadius="8"
                                                                              Color="#2563EB"
                                                                              Opacity="0.55"
                                                                              OffsetX="0"
                                                                              OffsetY="0" />
                                                        </Grid.Effect>
                                                        <Rectangle Height="2"
                                                                   VerticalAlignment="Center"
                                                                   Fill="#2563EB"
                                                                   Opacity="0.85" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center" />
                                                        <Ellipse Width="6" Height="6"
                                                                 Fill="#2563EB"
                                                                 Opacity="0.85"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Line style (active dataset) -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource LineStyleIconGeometry}" />
                                                <TextBlock Text="線スタイル"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Name="ActiveDatasetLabel"
                                                           Text="(選択中データセット)"
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,0,2" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">

                                            <TextBlock Text="色"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <controls:ColorPickerPanel Name="LineColorPicker"
                                                                        AllowAuto="True"
                                                                        DefaultHex="#2563EB"
                                                                        Margin="0,0,0,10"
                                                                        ColorChanged="LineColorPicker_ColorChanged">
                                                <controls:ColorPickerPanel.Presets>
                                                <ComboBoxItem Tag="Auto" IsSelected="True">
                                                    <TextBlock Text="Auto" />
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="Custom">
                                                    <TextBlock Text="Custom" />
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#2563EB">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#2563EB" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Blue" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#DC2626">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#DC2626" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Red" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#16A34A">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#16A34A" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Green" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#EA580C">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#EA580C" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Orange" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#7C3AED">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#7C3AED" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Purple" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#0891B2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#0891B2" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Cyan" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#BE123C">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#BE123C" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Rose" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                <ComboBoxItem Tag="#4B5563">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="14" Background="#4B5563" CornerRadius="2" Margin="0,0,8,0" />
                                                        <TextBlock Text="Gray" />
                                                    </StackPanel>
                                                </ComboBoxItem>
                                                </controls:ColorPickerPanel.Presets>
                                            </controls:ColorPickerPanel>

                                            <TextBlock Text="凡例名"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="LegendNameTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,10"
                                                     ToolTip.Tip="凡例名を編集（F2 でフォーカス）"
                                                     TextChanged="LegendNameTextBox_TextChanged" />

                                            <Grid ColumnDefinitions="*,8,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="線幅"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="LineWidthTextBox"
                                                             Text="1.5"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="LineWidthTextBox_TextChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="マーカー"
                                                               Theme="{DynamicResource FieldLabelStyle}" />
                                                    <TextBox Name="MarkerSizeTextBox"
                                                             Text="0"
                                                             Theme="{DynamicResource InputTextBoxStyle}"
                                                             TextChanged="MarkerSizeTextBox_TextChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <ContentControl Content="分子量"
                                                Theme="{DynamicResource GroupHeaderStyle}" />

                                <!-- Section: Calibration & MW -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="M 1,12 L 13,12 M 1,1 L 1,12 M 2,11 Q 5,11 7,7 Q 9,3 12,2" />
                                                <TextBlock Text="較正曲線と分子量"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="OpenCalibrationButton"
                                                    Content="較正曲線 JSON を開く"
                                                    Theme="{DynamicResource PrimaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,8"
                                                    Click="OpenCalibrationButton_Click" />
                                            <TextBlock Name="CalibrationPathTextBlock"
                                                       Text="較正曲線: 未選択"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#475569"
                                                       Margin="0,0,0,12" />

                                            <TextBlock Text="溶媒"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="SolventComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,8"
                                                      ToolTip.Tip="溶媒を次の項目へ切替 (Ctrl+1)"
                                                      SelectionChanged="SolventComboBox_SelectionChanged" />

                                            <TextBlock Text="検出器"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="DetectorComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,12"
                                                      ToolTip.Tip="検出器を次の項目へ切替 (Ctrl+2)"
                                                      SelectionChanged="DetectorComboBox_SelectionChanged" />

                                            <CheckBox Name="MolecularWeightCheckBox"
                                                      Content="分子量表示"
                                                      IsEnabled="False"
                                                      Margin="0,0,0,10"
                                                      ToolTip.Tip="横軸の分子量 / 保持時間表示を切替 (Ctrl+3)"
                                                      IsCheckedChanged="MolecularWeightCheckBox_Changed" />

                                            <TextBlock Text="Y軸モード"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <ComboBox Name="MolecularWeightYModeComboBox"
                                                      Theme="{DynamicResource InputComboBoxStyle}"
                                                      IsEnabled="False"
                                                      SelectedIndex="0"
                                                      ToolTip.Tip="Y軸モードを次の項目へ切替 (Ctrl+4)"
                                                      SelectionChanged="MolecularWeightYModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Signal" Tag="Signal" />
                                                <ComboBoxItem Content="dw/dlogM" Tag="DwdLogM" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <ContentControl Content="書式"
                                                Theme="{DynamicResource GroupHeaderStyle}" />

                                <!-- Section: Axis range -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AxisRangeIconGeometry}" />
                                                <TextBlock Text="軸範囲"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:AxisRangePanel Name="AxisRangePanel"
                                                                 Margin="0,8,0,0"
                                                                 XAxisLabel="X"
                                                                 YAxisLabel="Y"
                                                                 NumberFormat="G6"
                                                                 AxisRangeCommitted="AxisRangePanel_Committed" />
                                    </Expander>
                                </Border>

                                <!-- Section: Graph labels -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="True">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphLabelIconGeometry}" />
                                                <TextBlock Text="グラフラベル"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="タイトル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="TitleTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,8,*">
                                                <CheckBox Name="TitleVisibleCheckBox"
                                                          Grid.Column="0"
                                                          Content="表示する"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                                <CheckBox Name="TitleBoldCheckBox"
                                                          Grid.Column="2"
                                                          Content="太字"
                                                          IsChecked="True"
                                                          IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                            </Grid>

                                            <TextBlock Text="X軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="XLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,8"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />

                                            <TextBlock Text="Y軸ラベル"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <TextBox Name="YLabelTextBox"
                                                     Theme="{DynamicResource InputTextBoxStyle}"
                                                     Margin="0,0,0,6"
                                                     TextChanged="GraphLabelTextBox_TextChanged" />
                                            <CheckBox Name="AxisLabelBoldCheckBox"
                                                      Content="軸ラベルを太字"
                                                      Margin="0,0,0,0"
                                                      IsCheckedChanged="GraphAppearanceCheckBox_Changed" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: Graph appearance -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource GraphFormatIconGeometry}" />
                                                <TextBlock Text="グラフ書式"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:GraphFormatPanel Name="GraphFormatPanel"
                                                                   GraphFormatChanged="GraphFormatPanel_GraphFormatChanged"
                                                                   AspectRatioChanged="GraphFormatPanel_AspectRatioChanged" />
                                    </Expander>
                                </Border>

                                <!-- Section: Analysis session -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource AnalysisConditionsIconGeometry}" />
                                                <TextBlock Text="解析条件"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Name="SaveSessionButton"
                                                    Content="解析条件を保存"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    IsEnabled="False"
                                                    Margin="0,0,0,8"
                                                    ToolTip.Tip="解析条件を .gpcjson に保存 (Ctrl+Shift+S)"
                                                    Click="SaveSessionButton_Click" />
                                            <Button Name="LoadSessionButton"
                                                    Content="解析条件を読み込み"
                                                    Theme="{DynamicResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTip.Tip="解析条件 (.gpcjson) を読み込み (Ctrl+Shift+O)"
                                                    Click="LoadSessionButton_Click" />
                                            <TextBlock Text="今開いている解析の状態（データ・較正曲線・線スタイル・軸範囲・グラフ書式）を任意の場所に .gpcjson として保存します。後でこのファイルを読み込めば、同じ解析をそのまま復元できます。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <!-- Section: App preferences -->
                                <Border Theme="{DynamicResource SectionStyle}">
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Theme="{DynamicResource SectionIconPath}"
                                                      Data="{StaticResource PreferencesIconGeometry}" />
                                                <TextBlock Text="環境設定"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="#0F172A"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="既定の較正曲線"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <Grid Margin="0,0,0,12" ColumnDefinitions="*,6,Auto">
                                                <TextBox Name="DefaultCalibrationPathTextBox"
                                                         Grid.Column="0"
                                                         Theme="{DynamicResource InputTextBoxStyle}"
                                                         ToolTip.Tip="次回起動時に自動で読み込む較正曲線 JSON のパス" />
                                                <Button Grid.Column="2"
                                                        Content="参照"
                                                        Theme="{DynamicResource SecondaryButtonStyle}"
                                                        Click="BrowseDefaultCalibrationButton_Click" />
                                            </Grid>

                                            <TextBlock Text="既定の出力フォルダ"
                                                       Theme="{DynamicResource FieldLabelStyle}" />
                                            <Grid ColumnDefinitions="*,6,Auto">
                                                <TextBox Name="DefaultOutputDirectoryTextBox"
                                                         Grid.Column="0"
                                                         Theme="{DynamicResource InputTextBoxStyle}"
                                                         ToolTip.Tip="グラフ・データ・解析条件の保存ダイアログで開く初期フォルダ" />
                                                <Button Grid.Column="2"
                                                        Content="参照"
                                                        Theme="{DynamicResource SecondaryButtonStyle}"
                                                        Click="BrowseDefaultOutputDirectoryButton_Click" />
                                            </Grid>

                                            <TextBlock Text="ここで設定した既定パスは、画面下部の「既定値として保存」を押すとグラフ書式と一緒にユーザー設定として保存され、次回起動時に較正曲線が自動で読み込まれます。"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Sticky footer: defaults -->
                        <Border Grid.Row="1"
                                Background="#E2E8F0"
                                BorderBrush="#CBD5E1"
                                BorderThickness="0,1,0,0"
                                Padding="20,12,20,14"
                                BoxShadow="0 3 10 0 #1A0F172A">
                            <StackPanel>
                                <TextBlock Text="既定値（次回起動時の初期状態）"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           Margin="0,0,0,8" />
                                <Grid ColumnDefinitions="*,10,*">
                                    <Button Name="ResetGraphSettingsButton"
                                            Grid.Column="0"
                                            Content="既定値に戻す"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="グラフ書式・線スタイル・軸範囲を、保存されている既定値に戻します"
                                            Click="ResetGraphSettingsButton_Click" />
                                    <Button Name="SaveDefaultFormattingButton"
                                            Grid.Column="2"
                                            Content="既定値として保存"
                                            Theme="{DynamicResource SecondaryButtonStyle}"
                                            ToolTip.Tip="現在のグラフ書式・線スタイル・環境設定パスを、次回起動時の既定値として保存します"
                                            Click="SaveDefaultFormattingButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MAIN AREA ================= -->
                <Grid Grid.Column="1" Margin="24,22,24,18"
                      RowDefinitions="Auto,*,Auto,Auto">

                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                        <Button Name="SaveGraphButton"
                                DockPanel.Dock="Right"
                                Content="PNG / SVG 保存"
                                Theme="{DynamicResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                ToolTip.Tip="グラフを PNG / SVG で保存 (Ctrl+S)"
                                Click="SaveGraphButton_Click" />
                        <Button Name="ExportDataButton"
                                DockPanel.Dock="Right"
                                Content="データ出力"
                                Theme="{DynamicResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,8,0"
                                ToolTip.Tip="データを CSV / xlsx で出力 (Ctrl+E)"
                                Click="ExportDataButton_Click" />
                        <!-- 較正曲線で選択中の溶媒・検出器を常時可視化するバッジ。
                             _selectedCalibrationCurve が null のときは IsVisible=false。 -->
                        <Border Name="SolventDetectorBadge"
                                DockPanel.Dock="Right"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                IsVisible="False"
                                ToolTip.Tip="較正曲線で選択中の溶媒・検出器">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Solvent: "
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" />
                                <TextBlock Name="SolventBadgeValue"
                                           Text=""
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" · Det: "
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" />
                                <TextBlock Name="DetectorBadgeValue"
                                           Text=""
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Chromatogram"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B" />
                    </DockPanel>

                    <Border Name="PlotContainerBorder"
                            Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White"
                            SizeChanged="PlotContainerBorder_SizeChanged">
                        <Grid>
                            <!-- ScottPlot コントロールはここに動的に挿入される。InitializePlotControl で
                                 Children.Clear() するため、操作ヒントバッジは PlotHost の外側に置く。 -->
                            <Grid Name="PlotHost">
                                <!-- スケルトン: 軸の影 + 仮データ線 + 横切るシマー帯。
                                     プロット初期化時に PlotHost.Children.Clear() で消える。 -->
                                <Grid Width="320" Height="200"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid Width="320" Height="180"
                                          VerticalAlignment="Top"
                                          ClipToBounds="True">
                                        <Canvas Width="320" Height="180">
                                            <Rectangle Canvas.Left="22" Canvas.Top="20"
                                                       Width="2" Height="140"
                                                       Fill="#E2E8F0" />
                                            <Rectangle Canvas.Left="20" Canvas.Top="158"
                                                       Width="280" Height="2"
                                                       Fill="#E2E8F0" />
                                            <Path Stroke="#CBD5E1"
                                                  StrokeThickness="2.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Data="M 30,140 Q 70,140 100,80 Q 130,30 160,80 Q 190,140 230,120 Q 260,100 290,140" />
                                        </Canvas>
                                        <Border Classes="shimmer"
                                                Width="120" Height="180"
                                                HorizontalAlignment="Left"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                                    <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-120" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Name="PlotPlaceholderTextBlock"
                                               Text="グラフを初期化しています..."
                                               FontSize="11"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,4" />
                                </Grid>
                            </Grid>
                            <Border Name="PlotControlsHintBadge"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Help">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="プロット操作"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#0F172A"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="左ドラッグ : パン" Foreground="#475569" />
                                        <TextBlock Text="右ドラッグ : 範囲ズーム" Foreground="#475569" />
                                        <TextBlock Text="ホイール : 拡大／縮小" Foreground="#475569" />
                                        <TextBlock Text="Ctrl + ホイール : 横方向のみ" Foreground="#475569" />
                                        <TextBlock Text="Shift + ホイール : 縦方向のみ" Foreground="#475569" />
                                        <TextBlock Text="ダブルクリック : ベンチマーク表示" Foreground="#475569" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <Path Width="3" Height="9"
                                      Fill="#475569"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Data="M 1.5,0 A 1.25,1.25 0 1 0 1.5,2.5 A 1.25,1.25 0 1 0 1.5,0 Z M 0.25,3.75 H 2.75 V 9 H 0.25 Z" />
                            </Border>
                            <controls:ErrorBanner Name="ErrorBanner" />
                            <controls:BusyOverlay Name="BusyOverlay" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#F1F5F9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,16,0,0">
                        <Panel>
                            <!-- 単一データセット時の chip 表示。
                                 多数重ね書き時は IsVisible=false にして MultiStatisticsScroll に切り替わる。 -->
                            <Grid Name="SingleStatisticsView"
                                  ColumnDefinitions="*,Auto">
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Chip 表示: 単一データセットの代表値（Mn / Mw / Đ）。
                                         SetStatisticsLine() がパースして各 chip 値を埋める。
                                         値テキストは SelectableTextBlock でドラッグ選択 + Ctrl+C コピー可。 -->
                                    <StackPanel Name="StatisticsChipPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Name="StatisticsPeakLabel"
                                                   Text=""
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   IsVisible="False" />
                                        <Border Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Mn"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <SelectableTextBlock Name="MnChipValue"
                                                                     Text="—"
                                                                     FontWeight="SemiBold"
                                                                     Foreground="#0F172A"
                                                                     VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Mw"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <SelectableTextBlock Name="MwChipValue"
                                                                     Text="—"
                                                                     FontWeight="SemiBold"
                                                                     Foreground="#0F172A"
                                                                     VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Ð"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <SelectableTextBlock Name="DispersityChipValue"
                                                                     Text="—"
                                                                     FontWeight="SemiBold"
                                                                     Foreground="#0F172A"
                                                                     VerticalAlignment="Center" />
                                                <TextBlock Name="StatisticsSourceLabel"
                                                           Text=""
                                                           FontSize="11"
                                                           Foreground="#94A3B8"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"
                                                           IsVisible="False" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- 単一行用 regex 不一致時の fallback。複数データセット時には使わない。 -->
                                    <TextBlock Name="StatisticsTextBlock"
                                               Text=""
                                               Foreground="#0F172A"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               IsVisible="False" />
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            Name="RepresentativePeakPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            IsVisible="False">
                                    <TextBlock Text="代表ピーク："
                                               VerticalAlignment="Center"
                                               Foreground="#475569"
                                               Margin="0,0,8,0" />
                                    <ComboBox Name="RepresentativePeakComboBox"
                                              MinWidth="160"
                                              Theme="{DynamicResource InputComboBoxStyle}"
                                              SelectionChanged="RepresentativePeakComboBox_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- 重ね書き（複数データセット）時の表示。
                                 MaxHeight 108 を超えたら縦スクロール。プロット領域を圧迫しないよう
                                 5 件読み込み時にすでにスクロールが出る高さにしてある。各行は
                                 BuildDatasetStatisticsRow で動的生成され、行ごとの ComboBox で
                                 個別ピーク選択ができる。 -->
                            <ScrollViewer Name="MultiStatisticsScroll"
                                          MaxHeight="108"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="False">
                                <ItemsControl Name="DatasetStatisticsList" />
                            </ScrollViewer>
                        </Panel>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Name="StatusTextBlock"
                                   Text="CSVまたはLabSolutions TXTを開いてください。"
                                   Foreground="#475569" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
